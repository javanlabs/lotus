+      <div class="lotus-modal-head">
+        <div class="lotus-modal-title" id="edit-scenario-title">Edit scenario</div>
+        <button type="button" class="lotus-modal-close" @click="close()" aria-label="Close">
+          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
+        </button>
+      </div>
+      {{template "qa_scenario_form" (dict "Action" (printf "%s/scenarios/%s" $d.Base $d.Scenario.ID) "Err" "edit-scenario-error" "Name" $d.Scenario.Name "Phase" $d.Scenario.Phase "Description" $d.Scenario.Description "PhaseOptions" $d.PhaseOptions "Submit" "Save")}}
+    </dialog>
+  </div>
+  <form method="post" action="{{$d.Base}}/scenarios/{{$d.Scenario.ID}}/archive">
+    <button type="submit" class="btn-lotus btn-lotus-secondary">Archive</button>
+  </form>
+  {{end}}
+  {{template "qa_subnav" (dict "Base" $d.Base "Active" "scenarios")}}
+</header>
+
+{{if $d.Scenario.Description}}<p style="margin:0 0 14px;max-width:760px;font-size:12.5px;color:#374151;white-space:pre-wrap">{{$d.Scenario.Description}}</p>{{end}}
+{{if $d.ArchivedCase}}
+<div role="note" style="margin-bottom:14px;max-width:760px;padding:9px 11px;border-radius:var(--radius-petal-sm);background:var(--status-fail-bg);color:var(--status-fail);font-size:12.5px">
+  {{$d.ArchivedCase}} case{{if ne $d.ArchivedCase 1}}s are{{else}} is{{end}} archived and will still be copied into new runs. Remove {{if ne $d.ArchivedCase 1}}them{{else}}it{{end}} or restore the case.
+</div>
+{{end}}
+
+<div id="scenario-error" style="max-width:760px"></div>
