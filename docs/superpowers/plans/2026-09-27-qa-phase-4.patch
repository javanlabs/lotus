+func TestQACase_ViewerReadsGuestReadsArchiveIsAudited(t *testing.T) {
+	e := newQAEnv(t, "acme-qacase-perm")
+	ctx := context.Background()
+	viewer, _ := e.session(t, "viewer@acme.example", "viewer")
+	p := e.project(t, "Portal")
