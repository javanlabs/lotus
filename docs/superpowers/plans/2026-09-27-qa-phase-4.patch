+{{define "content"}}
+{{template "shell_open" .}}
+{{$d := .Data}}
+
+<header style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:16px;margin-bottom:18px">
+  <div style="flex:1;min-width:220px">
+    <h1 style="margin:0;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#43284E">{{$d.Scenario.Name}}</h1>
+    <p style="margin:4px 0 0;font-size:12.5px;color:#6B7280">{{$d.PhaseLabel}} · {{$d.Cases}} case{{if ne $d.Cases 1}}s{{end}}{{if $d.Scenario.ArchivedAt}} · archived{{end}}</p>
+  </div>
+  {{if $d.CanWrite}}
+  {{template "lotus_modal_open" (dict "Name" "add-cases" "Title" "Add cases" "Trigger" "Add cases…")}}
+    <div class="lotus-modal-body" style="display:flex;flex-direction:column;gap:12px;min-width:min(560px,80vw)">
