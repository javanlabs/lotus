@@ -0,0 +1,91 @@
+package web
+
+import (
+	"context"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/repo"
+)
+
+func TestQAScenarios_ListCreateEditArchive(t *testing.T) {
+	e := newQAEnv(t, "acme-qascen")
+	ctx := context.Background()
+	member, _ := e.session(t, "qa@acme.example", "member")
+	p := e.project(t, "Portal")
+	_, cases := seedQALibrary(t, e, p) // "Regression core" holds both cases
+	repo.ArchiveQACase(ctx, e.s, cases[1].ID)
+	base := "/projects/" + p.String() + "/qa/scenarios"
+
+	status, body := e.get(t, member, base)
+	if status != http.StatusOK || !strings.Contains(body, "Regression core") || !strings.Contains(body, ">Regression<") ||
+		!strings.Contains(body, "1 archived") {
+		t.Fatalf("list = %d:\n%s", status, body)
+	}
+
+	resp, _ := e.post(t, member, base, url.Values{"name": {"UAT <b>RFS</b>"}, "phase": {"uat"}, "description": {"Client sign-off"}}, true)
+	list, _ := repo.ListQAScenarios(ctx, e.s, p, false)
+	var uat repo.QAScenario
+	for _, sc := range list {
+		if sc.Phase == "uat" {
+			uat = sc
+		}
+	}
+	// The dialog posts with htmx; it is sent on to the new scenario.
+	if resp.StatusCode != http.StatusNoContent || resp.Header.Get("HX-Redirect") != base+"/"+uat.ID.String() || uat.Name != "UAT <b>RFS</b>" {
+		t.Fatalf("create = %d HX-Redirect %q, %+v", resp.StatusCode, resp.Header.Get("HX-Redirect"), uat)
+	}
+	status, body = e.get(t, member, base+"/"+uat.ID.String())
+	if status != http.StatusOK || strings.Contains(body, "<b>RFS</b>") || !strings.Contains(body, "UAT &lt;b&gt;RFS&lt;/b&gt;") {
+		t.Fatalf("detail = %d or unescaped", status)
+	}
+
+	resp, body = e.post(t, member, base, url.Values{"name": {"X"}, "phase": {"exploratory"}}, true)
+	if !strings.Contains(body, "Choose a phase.") {
+		t.Fatalf("bad phase = %d %s", resp.StatusCode, body)
+	}
+	resp, _ = e.post(t, member, base+"/"+uat.ID.String(), url.Values{"name": {"UAT RFS"}, "phase": {"uat"}, "description": {""}}, true)
+	if got, _ := repo.GetQAScenario(ctx, e.s, uat.ID); resp.StatusCode != http.StatusNoContent || got.Name != "UAT RFS" {
+		t.Fatalf("edit = %d, %+v", resp.StatusCode, got)
+	}
+	resp, _ = e.post(t, member, base+"/"+uat.ID.String()+"/archive", nil, false)
+	if got, _ := repo.GetQAScenario(ctx, e.s, uat.ID); resp.StatusCode != http.StatusFound || got.ArchivedAt == nil ||
+		auditCount(t, e.db, e.orgID, "qa.scenario.archive") != 1 {
+		t.Fatalf("archive = %d", resp.StatusCode)
+	}
+	if _, body = e.get(t, member, base); strings.Contains(body, "UAT RFS") {
+		t.Fatal("archived scenario listed by default")
+	}
+	if _, body = e.get(t, member, base+"?archived=1"); !strings.Contains(body, "UAT RFS") {
+		t.Fatal("archived=1 hides the archived scenario")
+	}
+}
+
+func TestQAScenarios_OwnershipAndPermissions(t *testing.T) {
+	e := newQAEnv(t, "acme-qascen-perm")
+	ctx := context.Background()
+	viewer, _ := e.session(t, "viewer@acme.example", "viewer")
+	p := e.project(t, "Portal")
+	other := e.project(t, "Billing")
+	foreign, _ := repo.CreateQAScenario(ctx, e.s, other, "Billing SIT", "sit", "", nil)
+	base := "/projects/" + p.String() + "/qa/scenarios"
+
+	for _, path := range []string{base + "/" + foreign.ID.String(), base + "/" + uuid.NewString(), base + "/nope"} {
+		if status, _ := e.get(t, e.owner, path); status != http.StatusNotFound {
+			t.Fatalf("GET %s = %d; want 404", path, status)
+		}
+	}
+	if resp, _ := e.post(t, e.owner, base+"/"+foreign.ID.String()+"/archive", nil, false); resp.StatusCode != http.StatusNotFound {
+		t.Fatalf("archive another project's scenario = %d; want 404", resp.StatusCode)
+	}
+	if resp, _ := e.post(t, viewer, base, url.Values{"name": {"X"}, "phase": {"sit"}}, false); resp.StatusCode != http.StatusForbidden {
+		t.Fatalf("viewer create = %d; want 403", resp.StatusCode)
+	}
+	if _, body := e.get(t, viewer, base); strings.Contains(body, "New scenario") {
+		t.Fatal("viewer sees New scenario")
+	}
+}
diff --git a/internal/web/qa_sections.go b/internal/web/qa_sections.go
new file mode 100644
index 0000000..39cb0b2
--- /dev/null
+++ b/internal/web/qa_sections.go
@@ -0,0 +1,198 @@
+package web
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/gofiber/fiber/v2"
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/repo"
+	"github.com/uyab/lotus/internal/tenant"
+)
+
+// Section routes follow the folder routes (folders.go): form posts, a
+// rejection inside the still-open dialog for htmx, a success with a flash
+// and redirectAfterMutation. Only archiving is audited — it takes every
+// case in the subtree with it; creating, renaming and moving are routine.
+
+// qaSectionErr turns a repo error into the status and sentence a person sees.
+func qaSectionErr(err error, name string) (int, string, bool) {
+	switch {
+	case errors.Is(err, repo.ErrQANameTaken):
+		return fiber.StatusConflict, fmt.Sprintf("There's already a section called '%s' here.", name), true
+	case errors.Is(err, repo.ErrQASectionCycle):
+		return fiber.StatusConflict, "Can't move a section into itself or its own subsection.", true
+	case errors.Is(err, repo.ErrQASectionTooDeep):
+		return fiber.StatusConflict, fmt.Sprintf("Sections can nest at most %d levels.", repo.MaxQASectionDepth), true
+	case errors.Is(err, repo.ErrInvalidInput):
+		return fiber.StatusUnprocessableEntity,
+			fmt.Sprintf("Section name is required and can be at most %d characters.", repo.MaxQANameLength), true
+	case errors.Is(err, repo.ErrNotFound):
+		return fiber.StatusNotFound, "That section no longer exists.", true
+	}
+	return 0, "", false
+}
+
+// qaOptionalSection reads a parent picker: "" is the top level (nil); any
+// other value must be a section of this project.
+func qaOptionalSection(c *fiber.Ctx, s tenant.Scope, project *repo.Project, raw string) (*uuid.UUID, error) {
+	if strings.TrimSpace(raw) == "" {
+		return nil, nil
+	}
+	id, err := qaOwned(c, s, project, repo.QAKindSection, raw)
+	if err != nil {
+		return nil, err
+	}
+	return &id, nil
+}
+
+// qaSection loads :sid, which must belong to the project in the URL.
+func qaSection(c *fiber.Ctx, s tenant.Scope, project *repo.Project) (repo.QASection, error) {
+	id, err := qaOwned(c, s, project, repo.QAKindSection, c.Params("sid"))
+	if err != nil {
+		return repo.QASection{}, err
+	}
+	secs, err := repo.ListQASections(c.Context(), s, project.ID)
+	if err != nil {
+		return repo.QASection{}, err
+	}
+	for _, sec := range secs {
+		if sec.ID == id {
+			return sec, nil
+		}
+	}
+	return repo.QASection{}, fiber.ErrNotFound
+}
+
+func createQASectionUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		parentID, err := qaOptionalSection(c, s, project, c.FormValue("parent_id"))
+		if err != nil {
+			return err
+		}
+		name := c.FormValue("name")
+		sec, err := repo.CreateQASection(c.Context(), s, project.ID, name, parentID)
+		if err != nil {
+			if status, msg, ok := qaSectionErr(err, strings.TrimSpace(name)); ok {
+				return qaFormError(c, d, status, msg)
+			}
+			return err
+		}
+		setFlash(c, "qa.section.created", sec.Name)
+		return redirectAfterCreate(c, casesURL(qaBase(project), sec.ID.String(), "", false, 1))
+	}
+}
+
+func renameQASectionUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		sec, err := qaSection(c, s, project)
+		if err != nil {
+			return err
+		}
+		name := strings.TrimSpace(c.FormValue("name"))
+		if err := repo.RenameQASection(c.Context(), s, sec.ID, name); err != nil {
+			if status, msg, ok := qaSectionErr(err, name); ok {
+				return qaFormError(c, d, status, msg)
+			}
+			return err
+		}
+		setFlash(c, "qa.section.renamed", name)
+		return redirectAfterMutation(c, casesURL(qaBase(project), sec.ID.String(), "", false, 1))
+	}
+}
+
+func moveQASectionUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		sec, err := qaSection(c, s, project)
+		if err != nil {
+			return err
+		}
+		parentID, err := qaOptionalSection(c, s, project, c.FormValue("parent_id"))
+		if err != nil {
+			return err
+		}
+		if err := repo.MoveQASection(c.Context(), s, sec.ID, parentID); err != nil {
+			if status, msg, ok := qaSectionErr(err, sec.Name); ok {
+				return qaFormError(c, d, status, msg)
+			}
+			return err
+		}
+		setFlash(c, "qa.section.moved", sec.Name)
+		return redirectAfterMutation(c, casesURL(qaBase(project), sec.ID.String(), "", false, 1))
+	}
+}
+
+func archiveQASectionUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		sec, err := qaSection(c, s, project)
+		if err != nil {
+			return err
+		}
+		if err := repo.ArchiveQASection(c.Context(), s, sec.ID); err != nil {
+			if status, msg, ok := qaSectionErr(err, sec.Name); ok {
+				return qaFormError(c, d, status, msg)
+			}
+			return err
+		}
+		raw, _ := json.Marshal(fiber.Map{"name": sec.Name, "project_id": project.ID})
+		if err := repo.RecordAuditEvent(c.Context(), s, qaActor(c), "qa.section.archive", "qa_section", &sec.ID, raw); err != nil {
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "qa.section.archived", sec.Name)
+		return redirectAfterMutation(c, qaBase(project)+"/cases")
+	}
+}
+
+// moveQACasesUI files every selected case (form field case_id, repeated) in
+// one section. Ids of another project's cases are skipped by the repo, so a
+// tampered form moves only this project's cases.
+func moveQACasesUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		sectionID, err := qaOwned(c, s, project, repo.QAKindSection, c.FormValue("section_id"))
+		if err != nil {
+			return err
+		}
+		raw := c.Context().PostArgs().PeekMulti("case_id")
+		if len(raw) == 0 {
+			return qaFormError(c, d, fiber.StatusUnprocessableEntity, "Select at least one case.")
+		}
+		ids := make([]uuid.UUID, 0, len(raw))
+		for _, r := range raw {
+			id, err := uuid.Parse(string(r))
+			if err != nil {
+				return fiber.ErrNotFound
+			}
+			ids = append(ids, id)
+		}
+		n, err := repo.MoveQACases(c.Context(), s, ids, sectionID)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "qa.cases.moved", strconv.Itoa(n))
+		return redirectAfterMutation(c, casesURL(qaBase(project), sectionID.String(), "", false, 1))
+	}
+}
diff --git a/internal/web/qa_sections_test.go b/internal/web/qa_sections_test.go
new file mode 100644
index 0000000..96cb60f
--- /dev/null
+++ b/internal/web/qa_sections_test.go
@@ -0,0 +1,174 @@
+package web
+
+import (
+	"context"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/repo"
+)
+
+func qaSectionNamed(t *testing.T, e qaEnv, projectID uuid.UUID, name string) repo.QASection {
+	t.Helper()
+	secs, _ := repo.ListQASections(context.Background(), e.s, projectID)
+	for _, s := range secs {
+		if s.Name == name {
+			return s
+		}
+	}
+	t.Fatalf("no section %q in %+v", name, secs)
+	return repo.QASection{}
+}
+
+func TestQASections_CreateRenameMoveArchive(t *testing.T) {
+	e := newQAEnv(t, "acme-qasec")
+	member, _ := e.session(t, "qa@acme.example", "member")
+	p := e.project(t, "Portal")
+	base := "/projects/" + p.String() + "/qa"
+
+	resp, _ := e.post(t, member, base+"/sections", url.Values{"name": {"Auth"}}, false)
+	auth := qaSectionNamed(t, e, p, "Auth")
+	if resp.StatusCode != http.StatusFound || resp.Header.Get("Location") != base+"/cases?section="+auth.ID.String() {
+		t.Fatalf("create = %d %s; want 302 to the new section", resp.StatusCode, resp.Header.Get("Location"))
+	}
+	resp, _ = e.post(t, member, base+"/sections", url.Values{"name": {"Login"}, "parent_id": {auth.ID.String()}}, true)
+	login := qaSectionNamed(t, e, p, "Login")
+	// From the dialog, htmx is sent on to the new section, not left where it was.
+	if resp.StatusCode != http.StatusNoContent || resp.Header.Get("HX-Redirect") != base+"/cases?section="+login.ID.String() {
+		t.Fatalf("htmx create = %d, HX-Redirect %q", resp.StatusCode, resp.Header.Get("HX-Redirect"))
+	}
+	if login.ParentID == nil || *login.ParentID != auth.ID {
+		t.Fatal("Login not nested under Auth")
+	}
+
+	// Rejections come back inside the dialog, escaped.
+	resp, body := e.post(t, member, base+"/sections", url.Values{"name": {"auth"}}, true)
+	if resp.StatusCode != http.StatusOK || !hasText(body, "There's already a section called 'auth' here.") {
+		t.Fatalf("duplicate = %d %s", resp.StatusCode, body)
+	}
+	resp, body = e.post(t, member, base+"/sections/"+auth.ID.String()+"/move", url.Values{"parent_id": {login.ID.String()}}, true)
+	if !hasText(body, "Can't move a section into itself or its own subsection.") {
+		t.Fatalf("cycle = %d %s", resp.StatusCode, body)
+	}
+	resp, body = e.post(t, member, base+"/sections/"+login.ID.String()+"/rename", url.Values{"name": {"<b>Sign in</b>"}}, true)
+	if resp.StatusCode != http.StatusNoContent || qaSectionNamed(t, e, p, "<b>Sign in</b>").ID != login.ID {
+		t.Fatalf("rename = %d %s", resp.StatusCode, body)
+	}
+	resp, _ = e.post(t, member, base+"/sections/"+login.ID.String()+"/move", url.Values{"parent_id": {""}}, true)
+	if resp.StatusCode != http.StatusNoContent || qaSectionNamed(t, e, p, "<b>Sign in</b>").ParentID != nil {
+		t.Fatal("move to top level failed")
+	}
+
+	c, _ := repo.CreateQACase(context.Background(), e.s, p, repo.QACaseInput{SectionID: auth.ID, Title: "Session expires"}, nil)
+	resp, _ = e.post(t, member, base+"/sections/"+auth.ID.String()+"/archive", nil, false)
+	if resp.StatusCode != http.StatusFound || resp.Header.Get("Location") != base+"/cases" {
+		t.Fatalf("archive = %d %s", resp.StatusCode, resp.Header.Get("Location"))
+	}
+	got, _ := repo.GetQACase(context.Background(), e.s, c.ID)
+	if got.ArchivedAt == nil || qaSectionNamed(t, e, p, "Auth").ArchivedAt == nil {
+		t.Fatal("archive did not archive the section and its cases")
+	}
+	if n := auditCount(t, e.db, e.orgID, "qa.section.archive"); n != 1 {
+		t.Fatalf("qa.section.archive audit events = %d; want 1", n)
+	}
+}
+
+func TestQASections_PermissionsAndOwnership(t *testing.T) {
+	e := newQAEnv(t, "acme-qasec-perm")
+	ctx := context.Background()
+	viewer, _ := e.session(t, "viewer@acme.example", "viewer")
+	guest, guestID := e.session(t, "client@bank.example", "guest")
+	p := e.project(t, "Portal")
+	other := e.project(t, "Billing")
+	repo.AddProjectMember(ctx, e.s, p, guestID)
+	foreign, _ := repo.CreateQASection(ctx, e.s, other, "Invoices", nil)
+	base := "/projects/" + p.String() + "/qa"
+
+	for _, raw := range []string{viewer, guest} {
+		if resp, _ := e.post(t, raw, base+"/sections", url.Values{"name": {"X"}}, false); resp.StatusCode != http.StatusForbidden {
+			t.Fatalf("read-only create = %d; want 403", resp.StatusCode)
+		}
+	}
+	// Another project's section through this project's URL: 404, untouched.
+	resp, _ := e.post(t, e.owner, base+"/sections/"+foreign.ID.String()+"/rename", url.Values{"name": {"Hijacked"}}, false)
+	if resp.StatusCode != http.StatusNotFound || qaSectionNamed(t, e, other, "Invoices").ID != foreign.ID {
+		t.Fatalf("cross-project rename = %d", resp.StatusCode)
+	}
+	resp, _ = e.post(t, e.owner, base+"/sections", url.Values{"name": {"Child"}, "parent_id": {foreign.ID.String()}}, false)
+	if resp.StatusCode != http.StatusNotFound {
+		t.Fatalf("parent from another project = %d; want 404", resp.StatusCode)
+	}
+}
