+{{template "lotus_card_section_open" (dict "Padding" "4px" "Style" "overflow:hidden")}}
+  <div style="display:flex;justify-content:flex-end;padding:8px 10px">
+    <a href="{{$d.Base}}/scenarios{{if not $d.Archived}}?archived=1{{end}}" style="font-size:11.5px;color:#6B7280">{{if $d.Archived}}Hide archived{{else}}Show archived{{end}}</a>
+  </div>
+  {{if not $d.Rows}}
+  <p style="margin:0;padding:28px 14px;text-align:center;font-size:12.5px;color:#6B7280">No scenarios yet. A scenario is a reusable set of cases for one phase, such as "UAT alur RFS".</p>
+  {{else}}
+  <div class="lotus-table-head" style="grid-template-columns:minmax(0,1fr) 110px 90px 110px;gap:10px">
+    <div>SCENARIO</div><div>PHASE</div><div style="text-align:right">CASES</div><div>UPDATED</div>
+  </div>
+  {{range $d.Rows}}
+  <a href="{{.Href}}" class="lotus-repo-row" style="display:grid;grid-template-columns:minmax(0,1fr) 110px 90px 110px;gap:10px;align-items:center;padding:0 14px;text-decoration:none;color:inherit{{if .ArchivedAt}};opacity:.6{{end}}">
+    <span style="font-size:12.5px;font-weight:600;color:#111827;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{.Name}}</span>
+    <span><span class="lotus-badge lotus-badge-none">{{.PhaseLabel}}</span></span>
+    <span style="font:500 11.5px 'IBM Plex Mono',monospace;color:#374151;text-align:right">{{.Count.Cases}}{{if .Count.Archived}} <span style="color:#9E2B47">· {{.Count.Archived}} archived</span>{{end}}</span>
+    <span style="font:400 11px 'IBM Plex Mono',monospace;color:#9CA3AF">{{.UpdatedAt.Format "02 Jan 2006"}}</span>
+  </a>
+  {{end}}
+  {{end}}
+{{template "lotus_card_section_close" .}}
+
+{{template "shell_close" .}}
+{{end}}
