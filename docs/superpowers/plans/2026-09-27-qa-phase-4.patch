diff --git a/internal/web/qa_cases.go b/internal/web/qa_cases.go
new file mode 100644
index 0000000..33e1797
--- /dev/null
+++ b/internal/web/qa_cases.go
@@ -0,0 +1,246 @@
+package web
+
+import (
+	"net/url"
+	"strconv"
+	"strings"
+
+	"github.com/gofiber/fiber/v2"
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/httpx"
+	"github.com/uyab/lotus/internal/repo"
+)
+
+// qaCasesPerPage bounds the library table. Imported projects hold up to a
+// few thousand cases; the tree and the search box are how a reader narrows
+// them, the pager only walks what is left.
+const qaCasesPerPage = 100
+
+// qaTreeRow is one section in the library's tree, in display order.
+type qaTreeRow struct {
+	ID       uuid.UUID
+	ParentID *uuid.UUID
+	Name     string
+	Path     string // "Auth / Login"
+	Depth    int    // 0 at the top level
+	Count    int    // live cases in the section and everything below it
+	Archived bool
+	Active   bool
+	Href     string
+}
+
+// Indent is the row's left padding in px: one step per level.
+func (r qaTreeRow) Indent() int { return 10 + 14*r.Depth }
+
+// qaSectionTree flattens the sections into display order — depth first,
+// siblings in the repo's order — with subtree counts. Archived sections are
+// left out unless includeArchived.
+func qaSectionTree(sections []repo.QASection, counts map[uuid.UUID]int, includeArchived bool, active *uuid.UUID) []qaTreeRow {
+	children := map[uuid.UUID][]repo.QASection{}
+	var roots []repo.QASection
+	for _, s := range sections {
+		if s.ArchivedAt != nil && !includeArchived {
+			continue
+		}
+		if s.ParentID == nil {
+			roots = append(roots, s)
+		} else {
+			children[*s.ParentID] = append(children[*s.ParentID], s)
+		}
+	}
+	var out []qaTreeRow
+	var walk func(s repo.QASection, depth int, path string) int
+	walk = func(s repo.QASection, depth int, path string) int {
+		if path != "" {
+			path += " / "
+		}
+		path += s.Name
+		i := len(out)
+		out = append(out, qaTreeRow{
+			ID: s.ID, ParentID: s.ParentID, Name: s.Name, Path: path, Depth: depth, Archived: s.ArchivedAt != nil,
+			Active: active != nil && *active == s.ID,
+		})
+		total := counts[s.ID]
+		for _, c := range children[s.ID] {
+			total += walk(c, depth+1, path)
+		}
+		out[i].Count = total
+		return total
+	}
+	for _, r := range roots {
+		walk(r, 0, "")
+	}
+	return out
+}
+
+type qaCaseRow struct {
+	repo.QACase
+	Href string
+}
+
+type qaCasesData struct {
+	Project     repo.Project
+	Base        string
+	Tree        []qaTreeRow
+	AllCount    int
+	AllHref     string
+	SectionID   string // "" = all cases
+	SectionPath string
+	Query       string
+	Archived    bool
+	Rows        []qaCaseRow
+	Total       int
+	Page, Pages int
+	From, To    int
+	PrevHref    string
+	NextHref    string
+	ArchiveHref string // the same view with the archived toggle flipped
+
+	// Write controls, shown only with qa.case.write.
+	CanWrite       bool
+	SectionOptions []httpx.SelectOption // every live section, for "inside" and bulk move
+	Active         *qaTreeRow           // the chosen section, for its edit dialog
+	ParentValue    string               // the chosen section's parent, "" at the top level
+	MoveOptions    []httpx.SelectOption // where the chosen section may move: never into itself or below
+}
+
+// qaSectionOptions are the tree's live sections as picker options, minus
+// skip and everything below it (when skip is set).
+func qaSectionOptions(tree []qaTreeRow, skip *uuid.UUID) []httpx.SelectOption {
+	out := []httpx.SelectOption{}
+	skipDepth := -1
+	for _, r := range tree {
+		if skipDepth >= 0 {
+			if r.Depth > skipDepth {
+				continue
+			}
+			skipDepth = -1
+		}
+		if skip != nil && r.ID == *skip {
+			skipDepth = r.Depth
+			continue
+		}
+		if r.Archived {
+			continue
+		}
+		out = append(out, httpx.SelectOption{Value: r.ID.String(), Label: r.Path, Name: r.Name, Depth: r.Depth})
+	}
+	return out
+}
+
+// casesURL is the library URL for a section, search, archived toggle and page.
+func casesURL(base, section, q string, archived bool, page int) string {
+	v := url.Values{}
+	if section != "" {
+		v.Set("section", section)
+	}
+	if q != "" {
+		v.Set("q", q)
+	}
+	if archived {
+		v.Set("archived", "1")
+	}
+	if page > 1 {
+		v.Set("page", strconv.Itoa(page))
+	}
+	if len(v) == 0 {
+		return base + "/cases"
+	}
+	return base + "/cases?" + v.Encode()
+}
+
+// qaCasesPage is GET /projects/:id/qa/cases: the section tree beside the
+// cases of the chosen section (and its subsections), searchable and paged.
+func qaCasesPage(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		data := qaCasesData{
+			Project: *project, Base: qaBase(project),
+			Query:    strings.TrimSpace(c.Query("q")),
+			Archived: c.Query("archived") == "1",
+		}
+		filter := repo.QACaseFilter{IncludeSubsections: true, IncludeArchived: data.Archived, Query: data.Query}
+		var active *uuid.UUID
+		if raw := c.Query("section"); raw != "" {
+			id, err := qaOwned(c, s, project, repo.QAKindSection, raw)
+			if err != nil {
+				return err
+			}
+			active, filter.SectionID, data.SectionID = &id, &id, id.String()
+		}
+
+		sections, err := repo.ListQASections(c.Context(), s, project.ID)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		counts, err := repo.QASectionCaseCounts(c.Context(), s, project.ID)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		data.Tree = qaSectionTree(sections, counts, data.Archived, active)
+		data.AllHref = casesURL(data.Base, "", "", data.Archived, 1)
+		for i, r := range data.Tree {
+			data.Tree[i].Href = casesURL(data.Base, r.ID.String(), "", data.Archived, 1)
+			if r.Depth == 0 {
+				data.AllCount += r.Count
+			}
+			if r.Active {
+				data.SectionPath = r.Path
+			}
+		}
+
+		data.Total, err = repo.CountQACases(c.Context(), s, project.ID, filter)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		data.Pages = max(1, (data.Total+qaCasesPerPage-1)/qaCasesPerPage)
+		data.Page, _ = strconv.Atoi(c.Query("page"))
+		data.Page = min(max(data.Page, 1), data.Pages)
+		filter.Limit, filter.Offset = qaCasesPerPage, (data.Page-1)*qaCasesPerPage
+		cases, err := repo.ListQACases(c.Context(), s, project.ID, filter)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		for _, qc := range cases {
+			data.Rows = append(data.Rows, qaCaseRow{QACase: qc, Href: data.Base + "/cases/" + strconv.Itoa(qc.Key)})
+		}
+		if data.Total > 0 {
+			data.From, data.To = filter.Offset+1, filter.Offset+len(cases)
+		}
+		if data.Page > 1 {
+			data.PrevHref = casesURL(data.Base, data.SectionID, data.Query, data.Archived, data.Page-1)
+		}
+		if data.Page < data.Pages {
+			data.NextHref = casesURL(data.Base, data.SectionID, data.Query, data.Archived, data.Page+1)
+		}
+		data.ArchiveHref = casesURL(data.Base, data.SectionID, data.Query, !data.Archived, 1)
+		if mustPrincipal(c).Can("qa.case.write") {
+			data.CanWrite = true
+			data.SectionOptions = qaSectionOptions(data.Tree, nil)
+			for i := range data.Tree {
+				if data.Tree[i].Active && !data.Tree[i].Archived {
+					data.Active = &data.Tree[i]
+					data.ParentValue = uuidString(data.Tree[i].ParentID)
+					data.MoveOptions = qaSectionOptions(data.Tree, &data.Tree[i].ID)
+				}
+			}
+		}
+
+		org, user, err := shellChrome(c, d.DB)
+		if err != nil {
+			return err
+		}
+		nav, err := qaNav(c, s, project, httpx.NavCrumb{Label: "Cases"})
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		c.Type("html")
+		return renderPage(c, d, "pages/qa_cases.html", httpx.ViewData{
+			Title: "Cases · " + project.Name, Org: org, User: user, Nav: nav, Data: data,
+		})
+	}
+}
diff --git a/internal/web/qa_cases_test.go b/internal/web/qa_cases_test.go
new file mode 100644
index 0000000..0e8f27e
--- /dev/null
+++ b/internal/web/qa_cases_test.go
@@ -0,0 +1,115 @@
+package web
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/uyab/lotus/internal/repo"
+)
+
+func TestQACases_TreeFilterSearchAndEscaping(t *testing.T) {
+	e := newQAEnv(t, "acme-qacases")
+	ctx := context.Background()
+	p := e.project(t, "Portal")
+	auth, _ := repo.CreateQASection(ctx, e.s, p, "Auth <i>core</i>", nil)
+	login, _ := repo.CreateQASection(ctx, e.s, p, "Login", &auth.ID)
+	billing, _ := repo.CreateQASection(ctx, e.s, p, "Billing", nil)
+	for _, c := range []struct {
+		sec   *repo.QASection
+		title string
+	}{{auth, "Session expires"}, {login, `Login <script>alert(1)</script>`}, {login, "Login invalid"}, {billing, "Pay invoice"}} {
+		if _, err := repo.CreateQACase(ctx, e.s, p, repo.QACaseInput{SectionID: c.sec.ID, Title: c.title}, nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	base := "/projects/" + p.String() + "/qa/cases"
+
+	status, body := e.get(t, e.owner, base)
+	if status != http.StatusOK {
+		t.Fatalf("status = %d", status)
+	}
+	if strings.Contains(body, "<script>alert(1)</script>") || strings.Contains(body, "<i>core</i>") ||
+		!strings.Contains(body, "Auth &lt;i&gt;core&lt;/i&gt;") {
+		t.Fatal("section or case names are not escaped")
+	}
+	// The tree counts a section's whole subtree.
+	if !strings.Contains(body, `data-section-count="`+auth.ID.String()+`">3<`) {
+		t.Fatalf("Auth subtree count missing:\n%s", body)
+	}
+	if strings.Count(body, `data-case-row`) != 4 {
+		t.Fatalf("all cases: %d rows; want 4", strings.Count(body, `data-case-row`))
+	}
+
+	_, body = e.get(t, e.owner, base+"?section="+auth.ID.String())
+	if n := strings.Count(body, `data-case-row`); n != 3 || strings.Contains(body, "Pay invoice") {
+		t.Fatalf("Auth selected: %d rows; want its 3 cases including Login's", n)
+	}
+	_, body = e.get(t, e.owner, base+"?section="+auth.ID.String()+"&q=invalid")
+	if n := strings.Count(body, `data-case-row`); n != 1 || !strings.Contains(body, "Login invalid") {
+		t.Fatalf("search in Auth: %d rows", n)
+	}
+	if !strings.Contains(body, `href="`+base+`/3"`) || !strings.Contains(body, "TC-3") {
+		t.Fatal("the case row does not show its key or link to the case")
+	}
+}
+
+func TestQACases_ArchivedToggle(t *testing.T) {
+	e := newQAEnv(t, "acme-qacases-arch")
+	ctx := context.Background()
+	p := e.project(t, "Portal")
+	sec, _ := repo.CreateQASection(ctx, e.s, p, "Old", nil)
+	c, _ := repo.CreateQACase(ctx, e.s, p, repo.QACaseInput{SectionID: sec.ID, Title: "Legacy flow"}, nil)
+	repo.ArchiveQASection(ctx, e.s, sec.ID)
+	base := "/projects/" + p.String() + "/qa/cases"
+
+	_, body := e.get(t, e.owner, base)
+	if strings.Contains(body, "Legacy flow") || strings.Contains(body, ">Old<") {
+		t.Fatal("archived section or case shown by default")
+	}
+	_, body = e.get(t, e.owner, base+"?archived=1")
+	if !strings.Contains(body, "Legacy flow") || !strings.Contains(body, "Old") {
+		t.Fatalf("archived=1 hides archived rows:\n%s", body)
+	}
+	_ = c
+}
+
+func TestQACases_Pages(t *testing.T) {
+	e := newQAEnv(t, "acme-qacases-page")
+	ctx := context.Background()
+	p := e.project(t, "Portal")
+	sec, _ := repo.CreateQASection(ctx, e.s, p, "All", nil)
+	for i := 1; i <= qaCasesPerPage+5; i++ {
+		if _, err := repo.CreateQACase(ctx, e.s, p, repo.QACaseInput{SectionID: sec.ID, Title: fmt.Sprintf("Case %03d", i)}, nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	base := "/projects/" + p.String() + "/qa/cases"
+	_, body := e.get(t, e.owner, base+"?page=2")
+	if n := strings.Count(body, `data-case-row`); n != 5 {
+		t.Fatalf("page 2: %d rows; want 5", n)
+	}
+	if !strings.Contains(body, fmt.Sprintf("%d–%d of %d cases", qaCasesPerPage+1, qaCasesPerPage+5, qaCasesPerPage+5)) {
+		t.Fatalf("pager text missing:\n%s", body)
+	}
+	// Out of range pages clamp rather than showing an empty table.
+	_, body = e.get(t, e.owner, base+"?page=99")
+	if n := strings.Count(body, `data-case-row`); n != 5 {
+		t.Fatalf("page 99: %d rows; want the last page", n)
+	}
+}
+
+func TestQACases_SectionOfAnotherProjectIs404(t *testing.T) {
+	e := newQAEnv(t, "acme-qacases-404")
+	ctx := context.Background()
+	p := e.project(t, "Portal")
+	other := e.project(t, "Billing")
+	foreign, _ := repo.CreateQASection(ctx, e.s, other, "Invoices", nil)
+	for _, q := range []string{"?section=" + foreign.ID.String(), "?section=not-a-uuid"} {
+		if status, _ := e.get(t, e.owner, "/projects/"+p.String()+"/qa/cases"+q); status != http.StatusNotFound {
+			t.Fatalf("%s = %d; want 404", q, status)
+		}
+	}
+}
diff --git a/internal/web/qa_csv.go b/internal/web/qa_csv.go
new file mode 100644
index 0000000..c81c136
--- /dev/null
+++ b/internal/web/qa_csv.go
@@ -0,0 +1,213 @@
+package web
+
+import (
+	"bytes"
+	"encoding/csv"
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/uyab/lotus/internal/repo"
+)
+
+// The case CSV is one case per row:
+//
+//	section, title, precondition, steps, expected, priority, negative
+//
+// section is a path ("Auth / Login"); steps and expected hold one step per
+// line and are paired by line; priority is high, medium, low or empty;
+// negative is yes, no or empty. Export writes the same columns, so an
+// exported file imports back unchanged — except that a newline inside a
+// single step becomes a space, because lines are what separate steps.
+//
+// A cell starting with = + - @ is written with a leading apostrophe, so a
+// spreadsheet opening the file shows text instead of running a formula; the
+// importer takes that apostrophe off again.
+
+var qaCSVHeader = []string{"section", "title", "precondition", "steps", "expected", "priority", "negative"}
+
+// qaCSVMaxRows bounds one import: one request, one transaction.
+const qaCSVMaxRows = 5000
+
+type qaCSVRow struct {
+	Line         int // the spreadsheet row number; the header is 1
+	SectionPath  []string
+	Title        string
+	Precondition string
+	Steps        repo.QASteps
+	Priority     *string
+	Negative     bool
+}
+
+func qaCSVUnguard(cell string) string {
+	if len(cell) > 1 && cell[0] == '\'' && strings.ContainsRune("=+-@\t\r", rune(cell[1])) {
+		return cell[1:]
+	}
+	return cell
+}
+
+func qaCSVGuard(cell string) string {
+	if cell != "" && strings.ContainsRune("=+-@\t\r", rune(cell[0])) {
+		return "'" + cell
+	}
+	return cell
+}
+
+func qaCSVLines(cell string) []string {
+	if strings.TrimSpace(cell) == "" {
+		return nil
+	}
+	return strings.Split(strings.ReplaceAll(cell, "\r\n", "\n"), "\n")
+}
+
+// parseQACaseCSV reads a case CSV. err is a problem with the file as a whole
+// (header, size, encoding); rowErrs are per-row problems, one sentence each,
+// numbered as a spreadsheet numbers rows (the header is row 1).
+func parseQACaseCSV(r io.Reader) (rows []qaCSVRow, rowErrs []string, err error) {
+	raw, err := io.ReadAll(r)
+	if err != nil {
+		return nil, nil, err
+	}
+	raw = bytes.TrimPrefix(raw, []byte("\xef\xbb\xbf"))
+	if !utf8.Valid(raw) {
+		return nil, nil, errors.New("The file is not UTF-8 text. Save it as CSV UTF-8 and upload it again.")
+	}
+	first, _, _ := bytes.Cut(raw, []byte("\n"))
+	cr := csv.NewReader(bytes.NewReader(raw))
+	if bytes.Contains(first, []byte(";")) && !bytes.Contains(first, []byte(",")) {
+		cr.Comma = ';'
+	}
+	cr.FieldsPerRecord = -1
+	cr.LazyQuotes = true
+	records, err := cr.ReadAll()
+	if err != nil {
+		return nil, nil, fmt.Errorf("The file could not be read as CSV: %v.", err)
+	}
+	headerErr := errors.New("The first row must be the header: " + strings.Join(qaCSVHeader, ", ") + ".")
+	if len(records) == 0 || len(records[0]) < len(qaCSVHeader) {
+		return nil, nil, headerErr
+	}
+	for i, h := range qaCSVHeader {
+		if strings.ToLower(strings.TrimSpace(records[0][i])) != h {
+			return nil, nil, headerErr
+		}
+	}
+	if len(records)-1 > qaCSVMaxRows {
+		return nil, nil, fmt.Errorf("The file has more than %d rows. Split it and import each part.", qaCSVMaxRows)
+	}
+	for n, rec := range records[1:] {
+		line := n + 2
+		cell := func(i int) string {
+			if i < len(rec) {
+				return qaCSVUnguard(strings.TrimSpace(rec[i]))
+			}
+			return ""
+		}
+		if strings.TrimSpace(strings.Join(rec, "")) == "" {
+			continue
+		}
+		row := qaCSVRow{Line: line, Title: cell(1), Precondition: cell(2)}
+		for _, part := range strings.Split(cell(0), "/") {
+			if part = strings.TrimSpace(part); part != "" {
+				row.SectionPath = append(row.SectionPath, part)
+			}
+		}
+		fail := func(msg string) { rowErrs = append(rowErrs, fmt.Sprintf("Row %d: %s", line, msg)) }
+		switch {
+		case len(row.SectionPath) == 0:
+			fail("section is required.")
+			continue
+		case len(row.SectionPath) > repo.MaxQASectionDepth:
+			fail(fmt.Sprintf("sections can nest at most %d levels.", repo.MaxQASectionDepth))
+			continue
+		case row.Title == "":
+			fail("title is required.")
+			continue
+		case utf8.RuneCountInString(row.Title) > repo.MaxQATitleLength:
+			fail(fmt.Sprintf("title can be at most %d characters.", repo.MaxQATitleLength))
+			continue
+		}
+		tooLong := false
+		for _, p := range row.SectionPath {
+			tooLong = tooLong || utf8.RuneCountInString(p) > repo.MaxQANameLength
+		}
+		if tooLong {
+			fail(fmt.Sprintf("section names can be at most %d characters.", repo.MaxQANameLength))
+			continue
+		}
+		switch p := strings.ToLower(cell(5)); p {
+		case "":
+		case "high", "medium", "low":
+			row.Priority = &p
+		default:
+			fail("priority must be high, medium, low or empty.")
+			continue
+		}
+		switch strings.ToLower(cell(6)) {
+		case "", "no", "n", "false", "0":
+		case "yes", "y", "true", "1":
+			row.Negative = true
+		default:
+			fail("negative must be yes, no or empty.")
+			continue
+		}
+		var actions, expected []string
+		if len(rec) > 3 {
+			actions = qaCSVLines(rec[3])
+		}
+		if len(rec) > 4 {
+			expected = qaCSVLines(rec[4])
+		}
+		row.Steps = repo.QASteps{}
+		for i := 0; i < max(len(actions), len(expected)); i++ {
+			var a, x string
+			if i < len(actions) {
+				a = qaCSVUnguard(strings.TrimSpace(actions[i]))
+			}
+			if i < len(expected) {
+				x = qaCSVUnguard(strings.TrimSpace(expected[i]))
+			}
+			if a != "" || x != "" {
+				row.Steps = append(row.Steps, repo.QAStep{Action: a, Expected: x})
+			}
+		}
+		rows = append(rows, row)
+	}
+	return rows, rowErrs, nil
+}
+
+// writeQACaseCSV writes rows in the import format.
+func writeQACaseCSV(w io.Writer, rows []qaCSVRow) error {
+	cw := csv.NewWriter(w)
+	if err := cw.Write(qaCSVHeader); err != nil {
+		return err
+	}
+	oneLine := func(s string) string {
+		return strings.Join(strings.Fields(strings.ReplaceAll(s, "\r", " ")), " ")
+	}
+	for _, r := range rows {
+		actions := make([]string, len(r.Steps))
+		expected := make([]string, len(r.Steps))
+		for i, s := range r.Steps {
+			actions[i] = qaCSVGuard(oneLine(s.Action))
+			expected[i] = qaCSVGuard(oneLine(s.Expected))
+		}
+		priority, negative := "", ""
+		if r.Priority != nil {
+			priority = *r.Priority
+		}
+		if r.Negative {
+			negative = "yes"
+		}
+		if err := cw.Write([]string{
+			qaCSVGuard(strings.Join(r.SectionPath, " / ")), qaCSVGuard(r.Title), qaCSVGuard(r.Precondition),
+			strings.Join(actions, "\n"), strings.Join(expected, "\n"), priority, negative,
+		}); err != nil {
+			return err
+		}
+	}
+	cw.Flush()
+	return cw.Error()
+}
diff --git a/internal/web/qa_csv_test.go b/internal/web/qa_csv_test.go
new file mode 100644
index 0000000..ab944e5
--- /dev/null
+++ b/internal/web/qa_csv_test.go
@@ -0,0 +1,96 @@
+package web
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/uyab/lotus/internal/repo"
+)
+
+func TestParseQACaseCSV_RowsAndErrors(t *testing.T) {
+	in := "\xef\xbb\xbfSection,Title,Precondition,Steps,Expected,Priority,Negative\n" +
+		"Auth / Login,Login valid,User exists,\"Open portal\nSubmit\",\"Login page\nDashboard\",High,no\n" +
+		"Auth,Session expires,,,,,\n" +
+		",No section,,,,,\n" +
+		"Auth,,,,,,\n" +
+		"Auth,Bad priority,,,,urgent,\n" +
+		"Auth,Bad negative,,,,,maybe\n" +
+		"Auth,'=SUM(A1),,'-1 then enter,,,yes\n"
+	rows, errs, err := parseQACaseCSV(strings.NewReader(in))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 3 {
+		t.Fatalf("rows = %+v", rows)
+	}
+	r := rows[0]
+	if strings.Join(r.SectionPath, "|") != "Auth|Login" || r.Title != "Login valid" || r.Precondition != "User exists" ||
+		len(r.Steps) != 2 || r.Steps[1] != (repo.QAStep{Action: "Submit", Expected: "Dashboard"}) || *r.Priority != "high" || r.Negative {
+		t.Fatalf("row 1 = %+v", r)
+	}
+	if rows[1].Priority != nil || len(rows[1].Steps) != 0 {
+		t.Fatalf("row 2 = %+v", rows[1])
+	}
+	// A leading apostrophe that guards a formula is the exporter's; it goes.
+	if rows[2].Title != "=SUM(A1)" || rows[2].Steps[0].Action != "-1 then enter" || !rows[2].Negative {
+		t.Fatalf("guarded row = %+v", rows[2])
+	}
+	want := []string{
+		"Row 4: section is required.",
+		"Row 5: title is required.",
+		"Row 6: priority must be high, medium, low or empty.",
+		"Row 7: negative must be yes, no or empty.",
+	}
+	if strings.Join(errs, "\n") != strings.Join(want, "\n") {
+		t.Fatalf("errors =\n%s\nwant\n%s", strings.Join(errs, "\n"), strings.Join(want, "\n"))
+	}
+}
+
+func TestParseQACaseCSV_SemicolonsAndHeaderChecks(t *testing.T) {
+	rows, errs, err := parseQACaseCSV(strings.NewReader("section;title;precondition;steps;expected;priority;negative\nAuth;Login;;;;low;\n"))
+	if err != nil || len(errs) != 0 || len(rows) != 1 || *rows[0].Priority != "low" {
+		t.Fatalf("semicolon file = %+v %v %v", rows, errs, err)
+	}
+	if _, _, err := parseQACaseCSV(strings.NewReader("title,section\nx,y\n")); err == nil ||
+		err.Error() != "The first row must be the header: section, title, precondition, steps, expected, priority, negative." {
+		t.Fatalf("bad header = %v", err)
+	}
+	if _, _, err := parseQACaseCSV(strings.NewReader("")); err == nil {
+		t.Fatal("empty file accepted")
+	}
+	long := "section,title,precondition,steps,expected,priority,negative\n" + strings.Repeat("Auth,x,,,,,\n", qaCSVMaxRows+1)
+	if _, _, err := parseQACaseCSV(strings.NewReader(long)); err == nil || !strings.Contains(err.Error(), "5000") {
+		t.Fatalf("oversized file = %v", err)
+	}
+}
+
+func TestWriteQACaseCSV_RoundTrips(t *testing.T) {
+	high := "high"
+	cases := []qaCSVRow{
+		{SectionPath: []string{"Auth", "Login"}, Title: "Login valid", Precondition: "User, with comma", Priority: &high,
+			Steps: repo.QASteps{{Action: "Open", Expected: "Page"}, {Action: "Submit", Expected: ""}}},
+		{SectionPath: []string{"Auth"}, Title: "=HYPERLINK(\"x\")", Negative: true,
+			Steps: repo.QASteps{{Action: "Type -1\nthen enter", Expected: "@error shown"}}},
+	}
+	var buf bytes.Buffer
+	if err := writeQACaseCSV(&buf, cases); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(buf.String(), `'=HYPERLINK`) || !strings.Contains(buf.String(), `'@error`) {
+		t.Fatalf("formulas not guarded:\n%s", buf.String())
+	}
+	back, errs, err := parseQACaseCSV(&buf)
+	if err != nil || len(errs) != 0 || len(back) != 2 {
+		t.Fatalf("parse back = %v %v", errs, err)
+	}
+	if back[0].Title != "Login valid" || back[0].Precondition != "User, with comma" || len(back[0].Steps) != 2 ||
+		back[0].Steps[1].Action != "Submit" || *back[0].Priority != "high" {
+		t.Fatalf("row 1 back = %+v", back[0])
+	}
+	// A newline inside one step cannot survive line pairing; it becomes a space.
+	if back[1].Title != `=HYPERLINK("x")` || !back[1].Negative || back[1].Steps[0].Action != "Type -1 then enter" ||
+		back[1].Steps[0].Expected != "@error shown" {
+		t.Fatalf("row 2 back = %+v", back[1])
+	}
+}
diff --git a/internal/web/qa_helpers_test.go b/internal/web/qa_helpers_test.go
new file mode 100644
index 0000000..8e3c886
--- /dev/null
+++ b/internal/web/qa_helpers_test.go
@@ -0,0 +1,93 @@
+package web
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/gofiber/fiber/v2"
+	"github.com/google/uuid"
+	"github.com/jmoiron/sqlx"
+
+	"github.com/uyab/lotus/internal/repo"
+	"github.com/uyab/lotus/internal/tenant"
+)
+
+// qaEnv is one organization with an owner session, for the QA screens.
+type qaEnv struct {
+	app   *fiber.App
+	db    *sqlx.DB
+	orgID uuid.UUID
+	s     tenant.Scope
+	host  string
+	owner string // owner session cookie
+}
+
+func newQAEnv(t *testing.T, sub string) qaEnv {
+	t.Helper()
+	app, db := newDashboardTestApp(t)
+	orgID, ownerID := seedMember(t, db, sub, "owner")
+	return qaEnv{
+		app: app, db: db, orgID: orgID, s: tenant.FromRun(db, orgID),
+		host: sub + "." + dashboardTestDomain, owner: seedSession(t, db, orgID, ownerID),
+	}
+}
+
+// session adds a user with roleKey to the organization and returns its
+// session cookie and user id.
+func (e qaEnv) session(t *testing.T, email, roleKey string) (string, uuid.UUID) {
+	t.Helper()
+	var userID, roleID uuid.UUID
+	if err := e.db.Get(&userID, `INSERT INTO users (email, email_verified_at) VALUES ($1, now()) RETURNING id`, email); err != nil {
+		t.Fatalf("insert user: %v", err)
+	}
+	if err := e.db.Get(&roleID, `SELECT id FROM roles WHERE key = $1 AND org_id IS NULL`, roleKey); err != nil {
+		t.Fatalf("lookup role %s: %v", roleKey, err)
+	}
+	if _, err := e.db.Exec(`INSERT INTO memberships (org_id, user_id, role_id) VALUES ($1, $2, $3)`, e.orgID, userID, roleID); err != nil {
+		t.Fatalf("insert membership: %v", err)
+	}
+	return seedSession(t, e.db, e.orgID, userID), userID
+}
+
+func (e qaEnv) project(t *testing.T, name string) uuid.UUID {
+	t.Helper()
+	p, err := repo.CreateProject(context.Background(), e.s, repo.NewProject{Slug: url.PathEscape(name), Name: name})
+	if err != nil {
+		t.Fatalf("create project %q: %v", name, err)
+	}
+	return p.ID
+}
+
+// get fetches path with the given session and returns status and body.
+func (e qaEnv) get(t *testing.T, raw, path string) (int, string) {
+	t.Helper()
+	resp, err := e.app.Test(reqWithSession(http.MethodGet, e.host, path, raw))
+	if err != nil {
+		t.Fatalf("GET %s: %v", path, err)
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(resp.Body)
+	return resp.StatusCode, string(body)
+}
+
+// post submits a form (htmx when hx is true) and returns the response.
+func (e qaEnv) post(t *testing.T, raw, path string, form url.Values, hx bool) (*http.Response, string) {
+	t.Helper()
+	resp, err := e.app.Test(folderFormReq(e.host, path, raw, form, hx), 30_000)
+	if err != nil {
+		t.Fatalf("POST %s: %v", path, err)
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(resp.Body)
+	return resp, string(body)
+}
+
+// hasText reports whether body shows text, allowing for html/template's
+// escaping of apostrophes.
+func hasText(body, text string) bool {
+	return strings.Contains(body, text) || strings.Contains(body, strings.ReplaceAll(text, "'", "&#39;"))
+}
