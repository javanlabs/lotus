+      <form method="get" action="{{$d.Base}}/scenarios/{{$d.Scenario.ID}}/picker" hx-get="{{$d.Base}}/scenarios/{{$d.Scenario.ID}}/picker"
+            hx-target="#picker-results" hx-trigger="submit, input changed delay:300ms from:find input[name=q]" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px">
+        <input type="search" name="q" placeholder="Search titles" aria-label="Search titles" class="lotus-input">
+        {{template "lotus_select" (dict "Placeholder" "All sections" "Name" "section" "ID" "picker-section" "Value" "" "Label" "Section" "AutoSubmit" true "Options" (selectOptions $d.SectionOptions))}}
+      </form>
+      <div id="picker-results" hx-get="{{$d.Base}}/scenarios/{{$d.Scenario.ID}}/picker" hx-trigger="load"></div>
+      <form id="add-cases" method="post" action="{{$d.Base}}/scenarios/{{$d.Scenario.ID}}/cases" hx-post="{{$d.Base}}/scenarios/{{$d.Scenario.ID}}/cases"
+            hx-target="#add-cases-error" hx-swap="innerHTML" style="display:flex;gap:8px;align-items:center;justify-content:flex-end">
+        <span style="font-size:12px;color:#6B7280">Into</span>
+        <div style="min-width:180px">{{template "lotus_select" (dict "Name" "group_id" "ID" "add-cases-group" "Value" "" "Label" "Group" "Options" (selectOptions $d.GroupOptions))}}</div>
+        <button type="submit" class="btn-lotus btn-lotus-primary">Add selected</button>
+      </form>
+    </div>
+  {{template "lotus_modal_close" .}}
+  {{template "lotus_modal_open" (dict "Name" "new-group" "Title" "New group" "Trigger" "New group" "Variant" "secondary")}}
+    <div class="lotus-modal-form">
+      <form method="post" action="{{$d.Base}}/scenarios/{{$d.Scenario.ID}}/groups" hx-post="{{$d.Base}}/scenarios/{{$d.Scenario.ID}}/groups" hx-target="#new-group-error" hx-swap="innerHTML">
+        <div class="lotus-modal-body" style="display:flex;flex-direction:column;gap:14px">
+          <div id="new-group-error"></div>
+          <label style="display:flex;flex-direction:column;gap:6px">
+            <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">NAME</span>
+            <input type="text" name="name" required maxlength="200" placeholder="Day 1" class="lotus-input">
+          </label>
+        </div>
+        <div class="lotus-modal-foot">
+          <button type="button" class="btn-lotus btn-lotus-secondary" onclick="this.closest('dialog').close()">Cancel</button>
+          <button type="submit" class="btn-lotus btn-lotus-primary">Add group</button>
+        </div>
+      </form>
+    </div>
+  {{template "lotus_modal_close" .}}
+  <div x-data="lotusModal('edit-scenario')" style="display:contents">
+    <button type="button" class="btn-lotus btn-lotus-secondary" @click="open()">Edit scenario…</button>
