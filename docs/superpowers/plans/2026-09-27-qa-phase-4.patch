+    {{template "qa_step_button" (dict "Action" (printf "%s/groups/%s/move" $scen $g.ID) "Dir" "up" "Off" $g.First "Label" (printf "Move %s up" $g.Name))}}
+    {{template "qa_step_button" (dict "Action" (printf "%s/groups/%s/move" $scen $g.ID) "Dir" "down" "Off" $g.Last "Label" (printf "Move %s down" $g.Name))}}
+    <form method="post" action="{{$scen}}/groups/{{$g.ID}}/rename" hx-post="{{$scen}}/groups/{{$g.ID}}/rename" hx-target="#scenario-error" hx-swap="innerHTML" style="display:flex;gap:4px">
+      <input type="text" name="name" required maxlength="200" value="{{$g.Name}}" aria-label="Group name" class="lotus-input" style="height:26px;font-size:11.5px;width:140px">
+      <button type="submit" class="lotus-row-action" style="font-size:11px">Rename</button>
+    </form>
+    {{end}}
+  </div>
+  {{end}}
+  {{range $g.Items}}
+  <div data-scenario-item class="lotus-repo-row" style="display:grid;grid-template-columns:{{if $d.CanWrite}}18px {{end}}70px minmax(0,1fr){{if $d.CanWrite}} auto{{end}};gap:10px;align-items:center;padding:0 14px">
+    {{if $d.CanWrite}}<input type="checkbox" name="item_id" value="{{.ItemID}}" form="scenario-items" aria-label="Select TC-{{.CaseKey}}" style="accent-color:var(--text-brand)">{{end}}
+    <span style="font:500 11px 'IBM Plex Mono',monospace;color:#6B7280">TC-{{.CaseKey}}</span>
+    <a href="{{.Href}}" style="font-size:12.5px;color:#111827;text-decoration:{{if .CaseArchived}}line-through{{else}}none{{end}};min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{.Title}}</a>
+    {{if $d.CanWrite}}
+    <span style="display:flex;gap:4px">
+      {{template "qa_step_button" (dict "Action" (printf "%s/items/%s/move" $scen .ItemID) "Dir" "up" "Off" .First "Label" (printf "Move TC-%d up" .CaseKey))}}
+      {{template "qa_step_button" (dict "Action" (printf "%s/items/%s/move" $scen .ItemID) "Dir" "down" "Off" .Last "Label" (printf "Move TC-%d down" .CaseKey))}}
