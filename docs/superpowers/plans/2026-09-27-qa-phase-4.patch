+  <button type="submit" class="lotus-row-action" aria-label="{{.Label}}"{{if .Off}} disabled{{end}}>{{if eq .Dir "up"}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="transform:rotate(180deg)"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9s-4.419 6-6 6s-6-6-6-6"></path></svg>{{else}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9s-4.419 6-6 6s-6-6-6-6"></path></svg>{{end}}</button>
+</form>
+{{end}}
diff --git a/web/templates/pages/qa_scenarios.html b/web/templates/pages/qa_scenarios.html
