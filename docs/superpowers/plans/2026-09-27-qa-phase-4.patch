diff --git a/web/templates/pages/qa_case.html b/web/templates/pages/qa_case.html
new file mode 100644
index 0000000..305896b
--- /dev/null
+++ b/web/templates/pages/qa_case.html
@@ -0,0 +1,102 @@
+{{define "content"}}
+{{template "shell_open" .}}
+{{$d := .Data}}
+
+<header style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:16px;margin-bottom:18px">
+  <div style="flex:1;min-width:220px">
+    <h1 style="margin:0;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#43284E">{{if $d.Case}}<span style="font-family:'IBM Plex Mono',monospace;font-weight:600;color:#9E2B47">TC-{{$d.Case.Key}}</span> {{$d.Case.Title}}{{else}}New case{{end}}</h1>
+    {{with $d.Case}}<p style="margin:4px 0 0;font-size:12.5px;color:#6B7280">{{$d.SectionPath}} · Version {{.Version}} · updated {{.UpdatedAt.Format "02 Jan 2006"}}{{if .ArchivedAt}} · archived{{end}}</p>{{end}}
+  </div>
+  {{if and $d.Case $d.CanWrite}}
+  <form method="post" action="{{$d.Action}}/{{if $d.Case.ArchivedAt}}restore{{else}}archive{{end}}">
+    <button type="submit" class="btn-lotus btn-lotus-secondary">{{if $d.Case.ArchivedAt}}Restore{{else}}Archive{{end}}</button>
+  </form>
+  {{end}}
+</header>
+
+{{if $d.CanWrite}}
+<form method="post" action="{{$d.Action}}" style="display:flex;flex-direction:column;gap:14px;max-width:880px">
+  {{if $d.Error}}{{template "form_error" $d.Error}}{{end}}
+  {{template "lotus_card_section_open" (dict "Padding" "18px" "Style" "display:flex;flex-direction:column;gap:14px")}}
+    <label style="display:flex;flex-direction:column;gap:6px">
+      <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">TITLE</span>
+      <input type="text" name="title" required maxlength="500" value="{{$d.Title}}" placeholder="Login with valid credentials" class="lotus-input">
+    </label>
+    <div style="display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr) auto;gap:14px;align-items:end">
+      <label style="display:flex;flex-direction:column;gap:6px;min-width:0">
+        <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">SECTION</span>
+        {{template "lotus_select" (dict "Name" "section_id" "ID" "case-section" "Value" $d.SectionID "Label" "Section" "Options" (selectOptions $d.SectionOptions))}}
+      </label>
+      <label style="display:flex;flex-direction:column;gap:6px">
+        <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">PRIORITY</span>
+        {{template "lotus_select" (dict "Name" "priority" "ID" "case-priority" "Value" $d.Priority "Label" "Priority" "Options" (selectOptions $d.PriorityOpts))}}
+      </label>
+      <label style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:#374151;padding-bottom:9px">
+        <input type="checkbox" name="negative" value="1"{{if $d.Negative}} checked{{end}} style="accent-color:var(--text-brand)"> Negative case
+      </label>
+    </div>
+    <label style="display:flex;flex-direction:column;gap:6px">
+      <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">PRECONDITION</span>
+      <textarea name="precondition" rows="2" class="lotus-textarea" placeholder="A registered user with a verified email">{{$d.Precondition}}</textarea>
+    </label>
+  {{template "lotus_card_section_close" .}}
+
+  {{template "lotus_card_section_open" (dict "Padding" "18px" "Style" "display:flex;flex-direction:column;gap:10px")}}
+    <script type="application/json" id="qa-steps-data">{{$d.Steps}}</script>
+    <div x-data="qaSteps('qa-steps-data')" style="display:flex;flex-direction:column;gap:10px">
+      <div style="display:grid;grid-template-columns:28px minmax(0,1fr) minmax(0,1fr) 84px;gap:10px;font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">
+        <span>#</span><span>STEP</span><span>EXPECTED</span><span></span>
+      </div>
+      <template x-for="(step, i) in steps" :key="step.id">
+        <div style="display:grid;grid-template-columns:28px minmax(0,1fr) minmax(0,1fr) 84px;gap:10px;align-items:start" data-step-row>
+          <span style="font:500 11px 'IBM Plex Mono',monospace;color:#9CA3AF;padding-top:9px" x-text="i + 1"></span>
+          <textarea name="step_action" rows="2" class="lotus-textarea" x-model="step.action" :aria-label="'Step ' + (i + 1)"></textarea>
+          <textarea name="step_expected" rows="2" class="lotus-textarea" x-model="step.expected" :aria-label="'Expected result ' + (i + 1)"></textarea>
+          <span style="display:flex;gap:4px;padding-top:4px">
+            <button type="button" class="lotus-row-action" @click="move(i, -1)" :disabled="i === 0" aria-label="Move step up"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="transform:rotate(180deg)"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9s-4.419 6-6 6s-6-6-6-6"></path></svg></button>
+            <button type="button" class="lotus-row-action" @click="move(i, 1)" :disabled="i === steps.length - 1" aria-label="Move step down"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9s-4.419 6-6 6s-6-6-6-6"></path></svg></button>
+            <button type="button" class="lotus-row-action" @click="remove(i)" aria-label="Remove step">
+              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="transform:rotate(45deg)"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
+            </button>
+          </span>
+        </div>
+      </template>
+      <div><button type="button" class="btn-lotus btn-lotus-secondary" @click="add()">Add step</button></div>
+    </div>
+  {{template "lotus_card_section_close" .}}
+
+  {{template "lotus_card_section_open" (dict "Padding" "18px")}}
+    <label style="display:flex;flex-direction:column;gap:6px">
+      <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">NOTES</span>
+      <textarea name="notes" rows="3" class="lotus-textarea" placeholder="Links, test data, anything a tester needs">{{$d.Notes}}</textarea>
+    </label>
+  {{template "lotus_card_section_close" .}}
+
+  <div style="display:flex;gap:8px;justify-content:flex-end">
+    <a href="{{$d.Base}}/cases" class="btn-lotus btn-lotus-secondary">Cancel</a>
+    <button type="submit" class="btn-lotus btn-lotus-primary">{{if $d.Case}}Save{{else}}Create case{{end}}</button>
+  </div>
+</form>
+{{else}}
+{{with $d.Case}}
+<div style="display:flex;flex-direction:column;gap:14px;max-width:880px">
+  {{template "lotus_card_section_open" (dict "Padding" "18px" "Style" "display:flex;flex-direction:column;gap:10px;font-size:12.5px;color:#374151")}}
+    <div><span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">PRIORITY</span> {{if .Priority}}{{.Priority}}{{else}}—{{end}}{{if .Negative}} · negative{{end}}</div>
+    {{if .Precondition}}<div><div style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label);margin-bottom:4px">PRECONDITION</div><div style="white-space:pre-wrap">{{.Precondition}}</div></div>{{end}}
+  {{template "lotus_card_section_close" .}}
+  {{template "lotus_card_section_open" (dict "Padding" "4px")}}
+    <div class="lotus-table-head" style="grid-template-columns:28px minmax(0,1fr) minmax(0,1fr);gap:10px"><div>#</div><div>STEP</div><div>EXPECTED</div></div>
+    {{range $i, $s := .Steps}}
+    <div style="display:grid;grid-template-columns:28px minmax(0,1fr) minmax(0,1fr);gap:10px;padding:8px 14px;border-bottom:1px solid #F3F4F6;font-size:12.5px;color:#111827">
+      <span style="font:500 11px 'IBM Plex Mono',monospace;color:#9CA3AF">{{inc $i}}</span>
+      <span style="white-space:pre-wrap">{{$s.Action}}</span><span style="white-space:pre-wrap">{{$s.Expected}}</span>
+    </div>
+    {{else}}<p style="margin:0;padding:18px 14px;color:#9CA3AF;font-size:12.5px">No steps.</p>{{end}}
+  {{template "lotus_card_section_close" .}}
+  {{if .Notes}}{{template "lotus_card_section_open" (dict "Padding" "18px" "Style" "font-size:12.5px;color:#374151;white-space:pre-wrap")}}{{.Notes}}{{template "lotus_card_section_close" .}}{{end}}
+</div>
+{{end}}
+{{end}}
+
+{{template "shell_close" .}}
+{{end}}
diff --git a/web/templates/pages/qa_case_import.html b/web/templates/pages/qa_case_import.html
new file mode 100644
index 0000000..694c032
--- /dev/null
+++ b/web/templates/pages/qa_case_import.html
@@ -0,0 +1,63 @@
+{{define "content"}}
+{{template "shell_open" .}}
+{{$d := .Data}}
+
+<header style="margin-bottom:18px">
+  <h1 style="margin:0;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#43284E">Import cases</h1>
+  <p style="margin:4px 0 0;font-size:12.5px;color:#6B7280">{{$d.Project.Name}} · CSV, up to 5000 rows and 4 MB</p>
+</header>
+
+<div style="display:flex;flex-direction:column;gap:14px;max-width:760px">
+{{if $d.Previewed}}
+  {{template "lotus_card_section_open" (dict "Padding" "18px" "Style" "display:flex;flex-direction:column;gap:12px")}}
+    {{if $d.FileError}}
+      {{template "form_error" $d.FileError}}
+    {{else}}
+      <div style="font-size:15px;font-weight:600;color:#111827">{{$d.Cases}} case{{if ne $d.Cases 1}}s{{end}} · {{len $d.NewSections}}{{if $d.MoreNew}}+{{end}} new section{{if ne (len $d.NewSections) 1}}s{{end}}</div>
+      {{if $d.NewSections}}
+      <div>
+        <div style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label);margin-bottom:6px">NEW SECTIONS</div>
+        <ul style="margin:0;padding-left:18px;font-size:12.5px;color:#374151;line-height:1.6">
+          {{range $d.NewSections}}<li>{{.}}</li>{{end}}
+          {{if $d.MoreNew}}<li style="color:#6B7280">and {{$d.MoreNew}} more</li>{{end}}
+        </ul>
+      </div>
+      {{end}}
+      {{if $d.RowErrors}}
+      <div role="alert" style="display:flex;flex-direction:column;gap:6px">
+        <div style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--status-fail)">{{len $d.RowErrors}} ROW{{if ne (len $d.RowErrors) 1}}S{{end}} TO FIX</div>
+        <ul style="margin:0;padding-left:18px;font-size:12.5px;color:var(--status-fail);line-height:1.6">
+          {{range $d.RowErrors}}<li>{{.}}</li>{{end}}
+        </ul>
+      </div>
+      {{end}}
+    {{end}}
+    {{if $d.CSV}}
+    <form method="post" action="{{$d.Base}}/cases/import/confirm" style="display:flex;gap:8px;justify-content:flex-end">
+      <textarea name="csv" hidden>{{$d.CSV}}</textarea>
+      <a href="{{$d.Base}}/cases/import" class="btn-lotus btn-lotus-secondary">Choose another file</a>
+      <button type="submit" class="btn-lotus btn-lotus-primary">Import {{$d.Cases}} case{{if ne $d.Cases 1}}s{{end}}</button>
+    </form>
+    {{else}}
+    <p style="margin:0;font-size:12.5px;color:#6B7280">Nothing was imported. Fix the file and upload it again.</p>
+    {{end}}
+  {{template "lotus_card_section_close" .}}
+{{end}}
+
+{{if not $d.CSV}}
+  {{template "lotus_card_section_open" (dict "Padding" "18px" "Style" "display:flex;flex-direction:column;gap:12px")}}
+    <p style="margin:0;font-size:12.5px;color:#374151;line-height:1.6">One case per row, with the header
+      <code style="font:500 11.5px 'IBM Plex Mono',monospace">section, title, precondition, steps, expected, priority, negative</code>.
+      Sections are paths such as <code style="font:500 11.5px 'IBM Plex Mono',monospace">Auth / Login</code> and are created when missing.
+      Steps and expected results hold one step per line, paired by line. Priority is high, medium, low or empty; negative is yes or empty.</p>
+    <p style="margin:0;font-size:12px;color:#6B7280"><a href="{{$d.Base}}/cases/export" style="color:#43284E">Export the current cases</a> for a file in this format.</p>
+    <form method="post" action="{{$d.Base}}/cases/import" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center">
+      <input type="file" name="file" accept=".csv,text/csv" required class="lotus-input" style="flex:1">
+      <button type="submit" class="btn-lotus btn-lotus-primary">Preview</button>
+    </form>
+  {{template "lotus_card_section_close" .}}
+{{end}}
+</div>
+
+{{template "shell_close" .}}
+{{end}}
diff --git a/web/templates/pages/qa_cases.html b/web/templates/pages/qa_cases.html
new file mode 100644
index 0000000..542e444
--- /dev/null
+++ b/web/templates/pages/qa_cases.html
@@ -0,0 +1,168 @@
+{{define "content"}}
+{{template "shell_open" .}}
+{{$d := .Data}}
+
+<header style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:16px;margin-bottom:18px">
+  <div style="flex:1;min-width:220px">
+    <h1 style="margin:0;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#43284E">{{$d.Project.Name}}</h1>
+    <p style="margin:4px 0 0;font-size:12.5px;color:#6B7280">{{if $d.SectionPath}}{{$d.SectionPath}}{{else}}All cases{{end}} · {{$d.Total}} case{{if ne $d.Total 1}}s{{end}}</p>
+  </div>
+  {{if $d.CanWrite}}{{template "qa_section_actions" $d}}{{end}}
+  {{template "qa_subnav" (dict "Base" $d.Base "Active" "cases")}}
+</header>
+
+<div style="display:grid;grid-template-columns:minmax(200px,260px) minmax(0,1fr);gap:14px;align-items:start">
+  {{template "lotus_card_section_open" (dict "Padding" "6px" "Attrs" "aria-label=\"Sections\"")}}
+    <a href="{{$d.AllHref}}" class="lotus-nav-item{{if not $d.SectionID}} is-active{{end}}" style="justify-content:space-between">
+      <span>All cases</span><span style="font:500 10.5px 'IBM Plex Mono',monospace;color:#9CA3AF">{{$d.AllCount}}</span>
+    </a>
+    {{range $d.Tree}}
+    <a href="{{.Href}}" class="lotus-nav-item{{if .Active}} is-active{{end}}" data-section="{{.ID}}"
+       style="justify-content:space-between;padding-left:{{.Indent}}px{{if .Archived}};opacity:.6{{end}}">
+      <span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{.Name}}</span>
+      <span style="font:500 10.5px 'IBM Plex Mono',monospace;color:#9CA3AF" data-section-count="{{.ID}}">{{.Count}}</span>
+    </a>
+    {{end}}
+    {{if not $d.Tree}}<p style="margin:8px 10px;font-size:11.5px;color:#9CA3AF">No sections yet.</p>{{end}}
+  {{template "lotus_card_section_close" .}}
+
+  {{template "lotus_card_section_open" (dict "Padding" "4px" "Style" "overflow:hidden;min-width:0")}}
+    <form method="get" action="{{$d.Base}}/cases" style="display:flex;gap:8px;align-items:center;padding:8px 10px">
+      {{if $d.SectionID}}<input type="hidden" name="section" value="{{$d.SectionID}}">{{end}}
+      {{if $d.Archived}}<input type="hidden" name="archived" value="1">{{end}}
+      <input type="search" name="q" value="{{$d.Query}}" placeholder="Search titles" aria-label="Search titles" class="lotus-input" style="flex:1">
+      <a href="{{$d.Base}}/cases/export{{if $d.SectionID}}?section={{$d.SectionID}}{{end}}" style="font-size:11.5px;color:#6B7280;white-space:nowrap">Export CSV</a>
+      <a href="{{$d.ArchiveHref}}" style="font-size:11.5px;color:#6B7280;white-space:nowrap">{{if $d.Archived}}Hide archived{{else}}Show archived{{end}}</a>
+    </form>
+    {{template "qa_case_table" $d}}
+  {{template "lotus_card_section_close" .}}
+</div>
+
+{{template "shell_close" .}}
+{{end}}
+
+{{/* qa_case_table is the library's case list and pager. Takes the page's
+     qaCasesData. */}}
+{{define "qa_case_table"}}
+{{if not .Rows}}
+<p style="margin:0;padding:28px 14px;text-align:center;font-size:12.5px;color:#6B7280">{{if .Query}}No cases match "{{.Query}}".{{else}}No cases here yet.{{end}}</p>
+{{else}}
+<div class="lotus-table-head" style="grid-template-columns:70px minmax(0,1fr) 80px 60px 100px;gap:10px">
+  <div>KEY</div><div>TITLE</div><div>PRIORITY</div><div style="text-align:right">STEPS</div><div>UPDATED</div>
+</div>
+{{$canWrite := .CanWrite}}
+{{range .Rows}}
+<div data-case-row class="lotus-repo-row lotus-repo-row-selectable" style="display:grid;grid-template-columns:70px minmax(0,1fr) 80px 60px 100px;gap:10px;align-items:center;padding:0 14px{{if .ArchivedAt}};opacity:.6{{end}}">
+  <span style="display:flex;align-items:center;gap:8px">
+    {{if $canWrite}}<span class="lotus-row-select"><input type="checkbox" name="case_id" value="{{.ID}}" form="qa-move-cases" aria-label="Select TC-{{.Key}}"></span>{{end}}
+    <span style="font:500 11px 'IBM Plex Mono',monospace;color:#6B7280">TC-{{.Key}}</span>
+  </span>
+  <a href="{{.Href}}" class="lotus-row-link" style="font-size:12.5px;color:#111827;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{.Title}}{{if .Negative}} <span class="lotus-badge lotus-badge-none">negative</span>{{end}}</a>
+  <span style="font:500 11px 'IBM Plex Mono',monospace;color:#6B7280">{{if .Priority}}{{.Priority}}{{else}}—{{end}}</span>
+  <span style="font:500 11px 'IBM Plex Mono',monospace;color:#6B7280;text-align:right">{{len .Steps}}</span>
+  <span style="font:400 11px 'IBM Plex Mono',monospace;color:#9CA3AF">{{.UpdatedAt.Format "02 Jan 2006"}}</span>
+</div>
+{{end}}
+{{if gt .Pages 1}}
+<div class="lotus-pager">
+  <span>{{.From}}–{{.To}} of {{.Total}} cases</span>
+  <span class="lotus-pager-spacer">
+    {{if .PrevHref}}<a href="{{.PrevHref}}" rel="prev">← Previous</a>{{else}}<span aria-disabled="true">← Previous</span>{{end}}
+    <span style="align-self:center;font:400 10.5px 'IBM Plex Mono',monospace;color:#9CA3AF">{{.Page}} / {{.Pages}}</span>
+    {{if .NextHref}}<a href="{{.NextHref}}" rel="next">Next →</a>{{else}}<span aria-disabled="true">Next →</span>{{end}}
+  </span>
+</div>
+{{end}}
+{{end}}
+{{end}}
+
+{{/* qa_section_actions: New case, New section, Edit section… (when one is chosen)
+     and Move to section… for the ticked rows. Takes qaCasesData. */}}
+{{define "qa_section_actions"}}
+<a href="{{.Base}}/cases/new{{if .SectionID}}?section={{.SectionID}}{{end}}" class="btn-lotus btn-lotus-primary">
+  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="color:var(--text-on-dark-accent)"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>New case
+</a>
+<a href="{{.Base}}/cases/import" class="btn-lotus btn-lotus-secondary">Import…</a>
+{{template "lotus_modal_open" (dict "Name" "new-section" "Title" "New section" "Trigger" "New section" "Variant" "secondary")}}
+  <div class="lotus-modal-form">
+    <form method="post" action="{{.Base}}/sections" hx-post="{{.Base}}/sections" hx-target="#new-section-error" hx-swap="innerHTML">
+      <div class="lotus-modal-body" style="display:flex;flex-direction:column;gap:14px">
+        <div id="new-section-error"></div>
+        <label style="display:flex;flex-direction:column;gap:6px">
+          <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">NAME</span>
+          <input type="text" name="name" required maxlength="200" placeholder="Login" class="lotus-input">
+        </label>
+        <label style="display:flex;flex-direction:column;gap:6px">
+          <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">INSIDE</span>
+          {{template "lotus_select" (dict "Placeholder" "Top level" "Name" "parent_id" "ID" "new-section-parent" "Value" .SectionID "Label" "Inside" "Options" (selectOptions .SectionOptions))}}
+        </label>
+      </div>
+      <div class="lotus-modal-foot">
+        <button type="button" class="btn-lotus btn-lotus-secondary" onclick="this.closest('dialog').close()">Cancel</button>
+        <button type="submit" class="btn-lotus btn-lotus-primary">Create section</button>
+      </div>
+    </form>
+  </div>
+{{template "lotus_modal_close" .}}
+
+{{with .Active}}
+<div x-data="lotusModal('edit-section')" style="display:contents">
+  <button type="button" class="btn-lotus btn-lotus-secondary" @click="open()">Edit section…</button>
+  <dialog class="lotus-modal lotus-shape" x-ref="dialog" aria-labelledby="edit-section-title">
+    <div class="lotus-modal-head">
+      <div class="lotus-modal-title" id="edit-section-title">{{.Name}}</div>
+      <button type="button" class="lotus-modal-close" @click="close()" aria-label="Close">
+        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
+      </button>
+    </div>
+    <div class="lotus-modal-body" style="display:flex;flex-direction:column;gap:18px">
+      <div id="edit-section-error"></div>
+      <form method="post" action="{{$.Base}}/sections/{{.ID}}/rename" hx-post="{{$.Base}}/sections/{{.ID}}/rename"
+            hx-target="#edit-section-error" hx-swap="innerHTML" style="display:flex;flex-direction:column;gap:6px">
+        <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">NAME</span>
+        <div style="display:flex;gap:8px">
+          <input type="text" name="name" required maxlength="200" value="{{.Name}}" class="lotus-input" style="flex:1" aria-label="Section name">
+          <button type="submit" class="btn-lotus btn-lotus-secondary">Rename</button>
+        </div>
+      </form>
+      <form method="post" action="{{$.Base}}/sections/{{.ID}}/move" hx-post="{{$.Base}}/sections/{{.ID}}/move"
+            hx-target="#edit-section-error" hx-swap="innerHTML" style="display:flex;flex-direction:column;gap:6px">
+        <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">MOVE INTO</span>
+        <div style="display:flex;gap:8px;align-items:center">
+          <div style="flex:1;min-width:0">
+            {{template "lotus_select" (dict "Placeholder" "Top level" "Name" "parent_id" "ID" "edit-section-parent" "Value" $.ParentValue "Label" "Move into" "Options" (selectOptions $.MoveOptions))}}
+          </div>
+          <button type="submit" class="btn-lotus btn-lotus-secondary">Move</button>
+        </div>
+      </form>
+      <form method="post" action="{{$.Base}}/sections/{{.ID}}/archive" hx-post="{{$.Base}}/sections/{{.ID}}/archive"
+            hx-target="#edit-section-error" hx-swap="innerHTML" style="display:flex;align-items:center;justify-content:space-between;gap:12px">
+        <span style="font-size:11.5px;color:#6B7280">Archives this section, its subsections and their {{.Count}} case{{if ne .Count 1}}s{{end}}.</span>
+        <button type="submit" class="btn-lotus btn-lotus-secondary">Archive</button>
+      </form>
+    </div>
+  </dialog>
+</div>
+{{end}}
+
+{{if .Rows}}
+{{template "lotus_modal_open" (dict "Name" "move-cases" "Title" "Move to section" "Trigger" "Move to section…" "Variant" "secondary")}}
+  <div class="lotus-modal-form">
+    <form id="qa-move-cases" method="post" action="{{.Base}}/cases/move" hx-post="{{.Base}}/cases/move" hx-target="#move-cases-error" hx-swap="innerHTML">
+      <div class="lotus-modal-body" style="display:flex;flex-direction:column;gap:14px">
+        <div id="move-cases-error"></div>
+        <p style="margin:0;font-size:12px;color:#6B7280">Moves the ticked cases.</p>
+        <label style="display:flex;flex-direction:column;gap:6px">
+          <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">SECTION</span>
+          {{template "lotus_select" (dict "Name" "section_id" "ID" "move-cases-section" "Value" "" "Label" "Section" "Options" (selectOptions .SectionOptions))}}
+        </label>
+      </div>
+      <div class="lotus-modal-foot">
+        <button type="button" class="btn-lotus btn-lotus-secondary" onclick="this.closest('dialog').close()">Cancel</button>
+        <button type="submit" class="btn-lotus btn-lotus-primary">Move</button>
+      </div>
+    </form>
+  </div>
+{{template "lotus_modal_close" .}}
+{{end}}
+{{end}}
diff --git a/web/templates/pages/qa_home.html b/web/templates/pages/qa_home.html
new file mode 100644
