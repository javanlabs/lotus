--- /dev/null
+++ b/web/templates/pages/qa_home.html
@@ -0,0 +1,31 @@
+{{define "content"}}
+{{template "shell_open" .}}
+
+<header style="margin-bottom:18px">
+  <h1 style="margin:0;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#43284E">QA Tools</h1>
+  <p style="margin:4px 0 0;font-size:12.5px;color:#6B7280">{{len .Data.Rows}} project{{if ne (len .Data.Rows) 1}}s{{end}} · {{.Data.Cases}} test case{{if ne .Data.Cases 1}}s{{end}}</p>
+</header>
+
+{{if not .Data.Rows}}
+{{template "lotus_card_section_open" (dict "Padding" "40px 32px" "Style" "text-align:center;color:#6B7280;font-size:12.5px")}}
+  No projects to test yet.
+{{template "lotus_card_section_close" .}}
+{{else}}
+{{template "lotus_card_section_open" (dict "Padding" "4px" "Style" "overflow:hidden")}}
+  <div class="lotus-table-head" style="grid-template-columns:1fr 90px 90px 90px 90px;gap:10px">
+    <div>PROJECT</div><div style="text-align:right">CASES</div><div style="text-align:right">SCENARIOS</div><div style="text-align:right">OPEN PLANS</div><div style="text-align:right">OPEN ISSUES</div>
+  </div>
+  {{range .Data.Rows}}
+  <a href="/projects/{{.ProjectID}}/qa" class="lotus-repo-row" style="display:grid;grid-template-columns:1fr 90px 90px 90px 90px;gap:10px;align-items:center;padding:0 14px;text-decoration:none;color:inherit">
+    <span style="font-size:12.5px;font-weight:600;color:#111827;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{.ProjectName}}</span>
+    <span data-qa-cases="{{.Cases}}" style="font:500 11.5px 'IBM Plex Mono',monospace;color:#374151;text-align:right">{{if .Cases}}{{.Cases}}{{else}}—{{end}}</span>
+    <span style="font:500 11.5px 'IBM Plex Mono',monospace;color:#374151;text-align:right">{{if .Scenarios}}{{.Scenarios}}{{else}}—{{end}}</span>
+    <span style="font:500 11.5px 'IBM Plex Mono',monospace;color:#374151;text-align:right">{{if .OpenPlans}}{{.OpenPlans}}{{else}}—{{end}}</span>
+    <span style="font:500 11.5px 'IBM Plex Mono',monospace;color:{{if .OpenIssues}}#9E2B47{{else}}#374151{{end}};text-align:right">{{if .OpenIssues}}{{.OpenIssues}}{{else}}—{{end}}</span>
+  </a>
+  {{end}}
+{{template "lotus_card_section_close" .}}
+{{end}}
+
+{{template "shell_close" .}}
+{{end}}
diff --git a/web/templates/pages/qa_project.html b/web/templates/pages/qa_project.html
new file mode 100644
index 0000000..e7444c7
--- /dev/null
+++ b/web/templates/pages/qa_project.html
@@ -0,0 +1,32 @@
+{{define "content"}}
+{{template "shell_open" .}}
+{{$d := .Data}}
+
+<header style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:16px;margin-bottom:18px">
+  <div style="flex:1;min-width:220px">
+    <h1 style="margin:0;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#43284E">{{$d.Project.Name}}</h1>
+    <p style="margin:4px 0 0;font-size:12.5px;color:#6B7280">QA · {{$d.Summary.Cases}} case{{if ne $d.Summary.Cases 1}}s{{end}} · {{$d.Summary.Scenarios}} scenario{{if ne $d.Summary.Scenarios 1}}s{{end}}</p>
+  </div>
+  {{template "qa_subnav" (dict "Base" $d.Base "Active" "overview")}}
+</header>
+
+<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px">
+  {{template "qa_tile" (dict "Label" "CASES" "Key" "cases" "Value" $d.Summary.Cases "Href" (printf "%s/cases" $d.Base))}}
+  {{template "qa_tile" (dict "Label" "SCENARIOS" "Key" "scenarios" "Value" $d.Summary.Scenarios "Href" (printf "%s/scenarios" $d.Base))}}
+  {{template "qa_tile" (dict "Label" "OPEN PLANS" "Key" "plans" "Value" $d.Summary.OpenPlans "Href" "")}}
+  {{template "qa_tile" (dict "Label" "OPEN ISSUES" "Key" "issues" "Value" $d.Summary.OpenIssues "Href" "")}}
+</div>
+
+{{template "shell_close" .}}
+{{end}}
+
+{{/* qa_tile is one count on the QA landing. Tiles whose screen exists
+     link to it; plans and issues get theirs in later phases. */}}
+{{define "qa_tile"}}
+{{if .Href}}<a href="{{.Href}}" style="text-decoration:none;color:inherit;display:block">{{end}}
+{{template "lotus_card_open" (dict "Padding" "13px 14px" "Style" "display:flex;flex-direction:column")}}
+  <div style="font:600 9.5px 'IBM Plex Mono',monospace;letter-spacing:.09em;color:#9CA3AF;white-space:nowrap">{{.Label}}</div>
+  <div style="font-size:22px;font-weight:700;letter-spacing:-.02em;line-height:1;margin-top:8px;color:#43284E" data-qa-count="{{.Key}}">{{.Value}}</div>
+{{template "lotus_card_close" .}}
+{{if .Href}}</a>{{end}}
+{{end}}
diff --git a/web/templates/pages/qa_scenario.html b/web/templates/pages/qa_scenario.html
