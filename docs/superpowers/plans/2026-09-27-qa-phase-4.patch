diff --git a/internal/web/qa_access.go b/internal/web/qa_access.go
new file mode 100644
index 0000000..7aeaffc
--- /dev/null
+++ b/internal/web/qa_access.go
@@ -0,0 +1,127 @@
+package web
+
+import (
+	"errors"
+
+	"github.com/gofiber/fiber/v2"
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/authz"
+	"github.com/uyab/lotus/internal/httpx"
+	"github.com/uyab/lotus/internal/repo"
+	"github.com/uyab/lotus/internal/tenant"
+)
+
+// Every /projects/:id/qa… route runs qaRoute's chain: the tenant and session
+// guards, then RequireProjectAccess (a guest reaches only the projects it is
+// listed on, and gets 404 for any other), then the route's permission.
+//
+// RLS pins every query to the organization, not to the project, and the
+// repo's by-id functions look rows up by id alone. So a handler that takes
+// any other id from the URL or the form — section, case, scenario, group —
+// checks it belongs to :id with qaOwned before using it, and answers 404
+// when it does not.
+
+func projectMemberCheck() authz.ProjectMemberCheck {
+	return func(c *fiber.Ctx, projectID, userID uuid.UUID) (bool, error) {
+		s, err := mustScope(c)
+		if err != nil {
+			return false, err
+		}
+		return repo.IsProjectMember(c.Context(), s, projectID, userID)
+	}
+}
+
+// qaRoute returns the middleware chain for a /projects/:id/qa… route
+// followed by the handler.
+func qaRoute(requireSession, loadPrincipal fiber.Handler, perm string, h fiber.Handler) []fiber.Handler {
+	return []fiber.Handler{
+		tenant.RequireTenant(), requireSession, loadPrincipal,
+		authz.RequireProjectAccess(projectMemberCheck(), "id"), authz.Require(perm), h,
+	}
+}
+
+// loadQAProject reads :id. An unknown project is 404.
+func loadQAProject(c *fiber.Ctx) (tenant.Scope, *repo.Project, error) {
+	s, err := mustScope(c)
+	if err != nil {
+		return s, nil, err
+	}
+	id, err := uuid.Parse(c.Params("id"))
+	if err != nil {
+		return s, nil, fiber.ErrNotFound
+	}
+	p, err := repo.ProjectByID(c.Context(), s, id)
+	if errors.Is(err, repo.ErrNotFound) {
+		return s, nil, fiber.ErrNotFound
+	}
+	return s, p, err
+}
+
+// qaOwned checks that a row named in the request belongs to the project in
+// the URL. Anything else — another project's row, an unknown id, a
+// malformed one — is 404.
+func qaOwned(c *fiber.Ctx, s tenant.Scope, project *repo.Project, kind repo.QAKind, raw string) (uuid.UUID, error) {
+	id, err := uuid.Parse(raw)
+	if err != nil {
+		return uuid.Nil, fiber.ErrNotFound
+	}
+	owner, err := repo.QAProjectOf(c.Context(), s, kind, id)
+	if errors.Is(err, repo.ErrNotFound) || (err == nil && owner != project.ID) {
+		return uuid.Nil, fiber.ErrNotFound
+	}
+	return id, err
+}
+
+func qaBase(p *repo.Project) string { return "/projects/" + p.ID.String() + "/qa" }
+
+// qaNav is the sidebar and breadcrumb for a project's QA page. Members
+// follow the project's folder path through the project page; a guest has no
+// dashboard.read, so its path runs QA Tools → project instead. deeper are
+// the segments below the QA landing; the last segment is the current page
+// and is never a link.
+func qaNav(c *fiber.Ctx, s tenant.Scope, project *repo.Project, deeper ...httpx.NavCrumb) (*httpx.Nav, error) {
+	projects, err := repo.ListProjects(c.Context(), s, false)
+	if err != nil {
+		return nil, err
+	}
+	var trail []httpx.NavCrumb
+	if authz.IsProjectScoped(mustPrincipal(c)) {
+		trail = []httpx.NavCrumb{{Label: "QA Tools", Href: "/qa"}, {Label: project.Name, Href: qaBase(project)}}
+	} else {
+		folders, err := repo.ListFolders(c.Context(), s)
+		if err != nil {
+			return nil, err
+		}
+		trail = append(projectFolderPath(folders, project),
+			httpx.NavCrumb{Label: project.Name, Href: "/projects/" + project.ID.String()},
+			httpx.NavCrumb{Label: "QA", Href: qaBase(project)})
+	}
+	trail = append(trail, deeper...)
+	trail[len(trail)-1].Href = ""
+	return navWithTrail("qa_tools", len(projects), trail), nil
+}
+
+// qaFormError answers a rejected QA form the way folderFormError does: the
+// message inside the still-open dialog for htmx, the status otherwise.
+func qaFormError(c *fiber.Ctx, d Deps, status int, msg string) error {
+	if c.Get("HX-Request") == "" {
+		return fiber.NewError(status, msg)
+	}
+	c.Type("html")
+	return d.Renderer.RenderNamed(c, "form_error", msg)
+}
+
+func qaActor(c *fiber.Ctx) *uuid.UUID { return folderAuditActor(c) }
+
+// redirectAfterCreate ends a successful create that should open what it
+// made. A plain post gets a redirect to it; an htmx post (a dialog) gets
+// HX-Redirect, because HX-Refresh — what redirectAfterMutation sends —
+// would reload the page the dialog sits on and leave the person there.
+func redirectAfterCreate(c *fiber.Ctx, to string) error {
+	if c.Get("HX-Request") != "" {
+		c.Set("HX-Redirect", to)
+		return c.SendStatus(fiber.StatusNoContent)
+	}
+	return c.Redirect(to, fiber.StatusFound)
+}
diff --git a/internal/web/qa_case.go b/internal/web/qa_case.go
new file mode 100644
index 0000000..e6a8d28
--- /dev/null
+++ b/internal/web/qa_case.go
@@ -0,0 +1,296 @@
+package web
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/gofiber/fiber/v2"
+
+	"github.com/uyab/lotus/internal/httpx"
+	"github.com/uyab/lotus/internal/repo"
+	"github.com/uyab/lotus/internal/tenant"
+)
+
+var qaPriorityOptions = []httpx.SelectOption{
+	{Value: "", Label: "—"}, {Value: "high", Label: "high"}, {Value: "medium", Label: "medium"}, {Value: "low", Label: "low"},
+}
+
+// qaCaseForm is the editor's state: what was loaded or what was typed, so a
+// rejected save shows the form again exactly as submitted.
+type qaCaseForm struct {
+	Project        repo.Project
+	Base           string
+	Case           *repo.QACase // nil while creating
+	Title          string
+	SectionID      string
+	Priority       string
+	Negative       bool
+	Precondition   string
+	Notes          string
+	Steps          repo.QASteps
+	Error          string
+	CanWrite       bool
+	SectionOptions []httpx.SelectOption
+	PriorityOpts   []httpx.SelectOption
+	SectionPath    string
+}
+
+// Action is where the form posts.
+func (f qaCaseForm) Action() string {
+	if f.Case == nil {
+		return f.Base + "/cases/new"
+	}
+	return fmt.Sprintf("%s/cases/%d", f.Base, f.Case.Key)
+}
+
+// qaStepsFromForm pairs step_action[i] with step_expected[i]. A pair with
+// both halves blank is an empty editor row and is dropped.
+func qaStepsFromForm(c *fiber.Ctx) repo.QASteps {
+	actions := c.Context().PostArgs().PeekMulti("step_action")
+	expected := c.Context().PostArgs().PeekMulti("step_expected")
+	steps := repo.QASteps{}
+	for i := 0; i < max(len(actions), len(expected)); i++ {
+		var a, x string
+		if i < len(actions) {
+			a = strings.TrimSpace(string(actions[i]))
+		}
+		if i < len(expected) {
+			x = strings.TrimSpace(string(expected[i]))
+		}
+		if a == "" && x == "" {
+			continue
+		}
+		steps = append(steps, repo.QAStep{Action: a, Expected: x})
+	}
+	return steps
+}
+
+// readQACaseForm reads a submitted case. It returns the repo input, or the
+// sentence to show; an unknown or foreign section is 404.
+func readQACaseForm(c *fiber.Ctx, s tenant.Scope, project *repo.Project, f *qaCaseForm) (repo.QACaseInput, error) {
+	f.Title = c.FormValue("title")
+	f.SectionID = c.FormValue("section_id")
+	f.Priority = strings.TrimSpace(c.FormValue("priority"))
+	f.Negative = c.FormValue("negative") != ""
+	f.Precondition = c.FormValue("precondition")
+	f.Notes = c.FormValue("notes")
+	f.Steps = qaStepsFromForm(c)
+	if strings.TrimSpace(f.SectionID) == "" {
+		f.Error = "Choose a section."
+		return repo.QACaseInput{}, nil
+	}
+	sectionID, err := qaOwned(c, s, project, repo.QAKindSection, f.SectionID)
+	if err != nil {
+		return repo.QACaseInput{}, err
+	}
+	in := repo.QACaseInput{
+		SectionID: sectionID, Title: f.Title, Precondition: f.Precondition, Notes: f.Notes,
+		Steps: f.Steps, Negative: f.Negative,
+	}
+	switch f.Priority {
+	case "":
+	case "high", "medium", "low":
+		p := f.Priority
+		in.Priority = &p
+	default:
+		f.Error = "Choose a priority: high, medium or low."
+	}
+	return in, nil
+}
+
+func qaCaseErrMessage(err error) (string, bool) {
+	if errors.Is(err, repo.ErrInvalidInput) {
+		return fmt.Sprintf("Title is required and can be at most %d characters.", repo.MaxQATitleLength), true
+	}
+	return "", false
+}
+
+// renderQACase shows the editor (or, without qa.case.write, the read-only
+// case).
+func renderQACase(c *fiber.Ctx, d Deps, s tenant.Scope, f qaCaseForm, status int) error {
+	sections, err := repo.ListQASections(c.Context(), s, f.Project.ID)
+	if err != nil {
+		return writeRepoErr(c, err)
+	}
+	tree := qaSectionTree(sections, nil, false, nil)
+	f.SectionOptions = qaSectionOptions(tree, nil)
+	f.PriorityOpts = qaPriorityOptions
+	for _, r := range tree {
+		if r.ID.String() == f.SectionID {
+			f.SectionPath = r.Path
+		}
+	}
+	if f.SectionPath == "" && f.Case != nil { // the case sits in an archived section
+		for _, r := range qaSectionTree(sections, nil, true, nil) {
+			if r.ID == f.Case.SectionID {
+				f.SectionPath = r.Path
+			}
+		}
+	}
+	org, user, err := shellChrome(c, d.DB)
+	if err != nil {
+		return err
+	}
+	label := "New case"
+	if f.Case != nil {
+		label = fmt.Sprintf("TC-%d", f.Case.Key)
+	}
+	nav, err := qaNav(c, s, &f.Project, httpx.NavCrumb{Label: "Cases", Href: f.Base + "/cases"}, httpx.NavCrumb{Label: label})
+	if err != nil {
+		return writeRepoErr(c, err)
+	}
+	c.Type("html")
+	c.Status(status)
+	return renderPage(c, d, "pages/qa_case.html", httpx.ViewData{
+		Title: label + " · " + f.Project.Name, Org: org, User: user, Nav: nav, Data: f,
+	})
+}
+
+func formFromCase(project *repo.Project, qc *repo.QACase) qaCaseForm {
+	f := qaCaseForm{
+		Project: *project, Base: qaBase(project), Case: qc, Title: qc.Title, SectionID: qc.SectionID.String(),
+		Negative: qc.Negative, Precondition: qc.Precondition, Notes: qc.Notes, Steps: qc.Steps,
+	}
+	if qc.Priority != nil {
+		f.Priority = *qc.Priority
+	}
+	return f
+}
+
+// loadQACase reads :key within the project in the URL.
+func loadQACase(c *fiber.Ctx, s tenant.Scope, project *repo.Project) (*repo.QACase, error) {
+	key, err := strconv.Atoi(c.Params("key"))
+	if err != nil || key < 1 {
+		return nil, fiber.ErrNotFound
+	}
+	qc, err := repo.GetQACaseByKey(c.Context(), s, project.ID, key)
+	if errors.Is(err, repo.ErrNotFound) {
+		return nil, fiber.ErrNotFound
+	}
+	return qc, err
+}
+
+func newQACasePage(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		f := qaCaseForm{Project: *project, Base: qaBase(project), CanWrite: true, Steps: repo.QASteps{}}
+		if raw := c.Query("section"); raw != "" {
+			if _, err := qaOwned(c, s, project, repo.QAKindSection, raw); err == nil {
+				f.SectionID = raw
+			}
+		}
+		return renderQACase(c, d, s, f, fiber.StatusOK)
+	}
+}
+
+func createQACaseUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		f := qaCaseForm{Project: *project, Base: qaBase(project), CanWrite: true}
+		in, err := readQACaseForm(c, s, project, &f)
+		if err != nil {
+			return err
+		}
+		if f.Error != "" {
+			return renderQACase(c, d, s, f, fiber.StatusUnprocessableEntity)
+		}
+		qc, err := repo.CreateQACase(c.Context(), s, project.ID, in, qaActor(c))
+		if err != nil {
+			if msg, ok := qaCaseErrMessage(err); ok {
+				f.Error = msg
+				return renderQACase(c, d, s, f, fiber.StatusUnprocessableEntity)
+			}
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "qa.case.created", fmt.Sprintf("TC-%d", qc.Key))
+		return c.Redirect(fmt.Sprintf("%s/cases/%d", f.Base, qc.Key), fiber.StatusFound)
+	}
+}
+
+func qaCasePage(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		qc, err := loadQACase(c, s, project)
+		if err != nil {
+			return err
+		}
+		f := formFromCase(project, qc)
+		f.CanWrite = mustPrincipal(c).Can("qa.case.write")
+		return renderQACase(c, d, s, f, fiber.StatusOK)
+	}
+}
+
+func updateQACaseUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		qc, err := loadQACase(c, s, project)
+		if err != nil {
+			return err
+		}
+		f := formFromCase(project, qc)
+		f.CanWrite = true
+		in, err := readQACaseForm(c, s, project, &f)
+		if err != nil {
+			return err
+		}
+		if f.Error != "" {
+			return renderQACase(c, d, s, f, fiber.StatusUnprocessableEntity)
+		}
+		if _, err := repo.UpdateQACase(c.Context(), s, qc.ID, in); err != nil {
+			if msg, ok := qaCaseErrMessage(err); ok {
+				f.Error = msg
+				return renderQACase(c, d, s, f, fiber.StatusUnprocessableEntity)
+			}
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "qa.case.saved", fmt.Sprintf("TC-%d", qc.Key))
+		return c.Redirect(f.Action(), fiber.StatusFound)
+	}
+}
+
+// setQACaseArchivedUI archives or restores :key. Archiving is audited;
+// runs already holding the case keep their copy of it.
+func setQACaseArchivedUI(archive bool) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		qc, err := loadQACase(c, s, project)
+		if err != nil {
+			return err
+		}
+		label := fmt.Sprintf("TC-%d", qc.Key)
+		if archive {
+			if err := repo.ArchiveQACase(c.Context(), s, qc.ID); err != nil {
+				return writeRepoErr(c, err)
+			}
+			raw, _ := json.Marshal(fiber.Map{"key": qc.Key, "title": qc.Title, "project_id": project.ID})
+			if err := repo.RecordAuditEvent(c.Context(), s, qaActor(c), "qa.case.archive", "qa_case", &qc.ID, raw); err != nil {
+				return writeRepoErr(c, err)
+			}
+			setFlash(c, "qa.case.archived", label)
+		} else {
+			if err := repo.RestoreQACase(c.Context(), s, qc.ID); err != nil {
+				return writeRepoErr(c, err)
+			}
+			setFlash(c, "qa.case.restored", label)
+		}
+		return c.Redirect(fmt.Sprintf("%s/cases/%d", qaBase(project), qc.Key), fiber.StatusFound)
+	}
+}
diff --git a/internal/web/qa_case_import.go b/internal/web/qa_case_import.go
new file mode 100644
index 0000000..a7d9e1a
--- /dev/null
+++ b/internal/web/qa_case_import.go
@@ -0,0 +1,233 @@
+package web
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+
+	"github.com/gofiber/fiber/v2"
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/httpx"
+	"github.com/uyab/lotus/internal/repo"
+	"github.com/uyab/lotus/internal/tenant"
+)
+
+// Import is two requests. The upload is parsed and checked against the
+// project's sections and nothing is written; the preview says what would
+// happen and, when every row is valid, carries the file's text in its
+// confirm form. The confirm parses and checks that text again — it is
+// client input like any other — and writes every case in one transaction.
+
+type qaImportData struct {
+	Project     repo.Project
+	Base        string
+	Previewed   bool
+	FileError   string
+	RowErrors   []string
+	Cases       int
+	NewSections []string
+	MoreNew     int // new sections beyond the ones listed
+	CSV         string
+}
+
+const qaImportListedSections = 20
+
+// qaImportCheck compares parsed rows with the project's sections: which
+// paths would be created, and which rows run through an archived section.
+func qaImportCheck(rows []qaCSVRow, sections []repo.QASection) (newPaths, rowErrs []string) {
+	archived := map[string]string{} // lower path -> display path
+	live := map[string]bool{}
+	for _, r := range qaSectionTree(sections, nil, true, nil) {
+		if r.Archived {
+			archived[strings.ToLower(r.Path)] = r.Path
+		} else {
+			live[strings.ToLower(r.Path)] = true
+		}
+	}
+	seen := map[string]bool{}
+	for _, row := range rows {
+		for i := range row.SectionPath {
+			display := strings.Join(row.SectionPath[:i+1], " / ")
+			key := strings.ToLower(display)
+			if p, ok := archived[key]; ok {
+				rowErrs = append(rowErrs, fmt.Sprintf("Row %d: section '%s' is archived.", row.Line, p))
+				break
+			}
+			if !live[key] && !seen[key] {
+				seen[key] = true
+				newPaths = append(newPaths, display)
+			}
+		}
+	}
+	return newPaths, rowErrs
+}
+
+// previewQAImport parses csv and fills the preview. ok is false when the
+// file or any row is rejected.
+func previewQAImport(c *fiber.Ctx, s tenant.Scope, project *repo.Project, csv string) (qaImportData, []qaCSVRow, bool, error) {
+	data := qaImportData{Project: *project, Base: qaBase(project), Previewed: true}
+	rows, rowErrs, err := parseQACaseCSV(strings.NewReader(csv))
+	if err != nil {
+		data.FileError = err.Error()
+		return data, nil, false, nil
+	}
+	sections, err := repo.ListQASections(c.Context(), s, project.ID)
+	if err != nil {
+		return data, nil, false, err
+	}
+	newPaths, archivedErrs := qaImportCheck(rows, sections)
+	data.RowErrors = append(rowErrs, archivedErrs...)
+	data.Cases = len(rows)
+	if len(newPaths) > qaImportListedSections {
+		data.MoreNew = len(newPaths) - qaImportListedSections
+		newPaths = newPaths[:qaImportListedSections]
+	}
+	data.NewSections = newPaths
+	ok := len(data.RowErrors) == 0 && len(rows) > 0
+	if len(rows) == 0 && len(data.RowErrors) == 0 {
+		data.FileError = "The file has no cases."
+	}
+	if ok {
+		data.CSV = csv
+	}
+	return data, rows, ok, nil
+}
+
+func renderQAImport(c *fiber.Ctx, d Deps, s tenant.Scope, data qaImportData, status int) error {
+	org, user, err := shellChrome(c, d.DB)
+	if err != nil {
+		return err
+	}
+	nav, err := qaNav(c, s, &data.Project, httpx.NavCrumb{Label: "Cases", Href: data.Base + "/cases"}, httpx.NavCrumb{Label: "Import"})
+	if err != nil {
+		return writeRepoErr(c, err)
+	}
+	c.Type("html")
+	c.Status(status)
+	return renderPage(c, d, "pages/qa_case_import.html", httpx.ViewData{
+		Title: "Import cases · " + data.Project.Name, Org: org, User: user, Nav: nav, Data: data,
+	})
+}
+
+func qaImportPage(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		return renderQAImport(c, d, s, qaImportData{Project: *project, Base: qaBase(project)}, fiber.StatusOK)
+	}
+}
+
+func previewQAImportUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		fh, err := c.FormFile("file")
+		if err != nil {
+			data := qaImportData{Project: *project, Base: qaBase(project), Previewed: true, FileError: "Choose a CSV file."}
+			return renderQAImport(c, d, s, data, fiber.StatusUnprocessableEntity)
+		}
+		f, err := fh.Open()
+		if err != nil {
+			return err
+		}
+		defer f.Close()
+		var buf bytes.Buffer
+		if _, err := io.Copy(&buf, f); err != nil {
+			return err
+		}
+		data, _, ok, err := previewQAImport(c, s, project, buf.String())
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		status := fiber.StatusOK
+		if !ok {
+			status = fiber.StatusUnprocessableEntity
+		}
+		return renderQAImport(c, d, s, data, status)
+	}
+}
+
+func confirmQAImportUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		data, rows, ok, err := previewQAImport(c, s, project, c.FormValue("csv"))
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		if !ok {
+			return renderQAImport(c, d, s, data, fiber.StatusUnprocessableEntity)
+		}
+		in := make([]repo.QACaseImport, len(rows))
+		for i, r := range rows {
+			in[i] = repo.QACaseImport{SectionPath: r.SectionPath, Case: repo.QACaseInput{
+				Title: r.Title, Precondition: r.Precondition, Steps: r.Steps, Priority: r.Priority, Negative: r.Negative,
+			}}
+		}
+		n, _, err := repo.ImportQACases(c.Context(), s, project.ID, in, qaActor(c))
+		var archived *repo.QASectionArchivedError
+		if errors.As(err, &archived) { // archived between preview and confirm
+			data.CSV, data.RowErrors = "", []string{fmt.Sprintf("Section '%s' is archived.", archived.Path)}
+			return renderQAImport(c, d, s, data, fiber.StatusUnprocessableEntity)
+		}
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "qa.cases.imported", fmt.Sprint(n))
+		return c.Redirect(qaBase(project)+"/cases", fiber.StatusFound)
+	}
+}
+
+// exportQACasesUI is GET /projects/:id/qa/cases/export[?section=]: the live
+// cases of the section's subtree (or the whole project) in the import format.
+func exportQACasesUI() fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		filter := repo.QACaseFilter{IncludeSubsections: true}
+		if raw := c.Query("section"); raw != "" {
+			id, err := qaOwned(c, s, project, repo.QAKindSection, raw)
+			if err != nil {
+				return err
+			}
+			filter.SectionID = &id
+		}
+		cases, err := repo.ListQACases(c.Context(), s, project.ID, filter)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		sections, err := repo.ListQASections(c.Context(), s, project.ID)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		paths := map[uuid.UUID][]string{}
+		for _, r := range qaSectionTree(sections, nil, true, nil) {
+			paths[r.ID] = strings.Split(r.Path, " / ")
+		}
+		rows := make([]qaCSVRow, len(cases))
+		for i, qc := range cases {
+			rows[i] = qaCSVRow{
+				SectionPath: paths[qc.SectionID], Title: qc.Title, Precondition: qc.Precondition,
+				Steps: qc.Steps, Priority: qc.Priority, Negative: qc.Negative,
+			}
+		}
+		var buf bytes.Buffer
+		if err := writeQACaseCSV(&buf, rows); err != nil {
+			return err
+		}
+		c.Set(fiber.HeaderContentType, "text/csv; charset=utf-8")
+		c.Set(fiber.HeaderContentDisposition, fmt.Sprintf(`attachment; filename="%s-cases.csv"`, project.Slug))
+		return c.Send(buf.Bytes())
+	}
+}
diff --git a/internal/web/qa_case_import_test.go b/internal/web/qa_case_import_test.go
new file mode 100644
index 0000000..4a315c3
--- /dev/null
+++ b/internal/web/qa_case_import_test.go
@@ -0,0 +1,184 @@
+package web
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/uyab/lotus/internal/repo"
+)
+
+const qaCSVHead = "section,title,precondition,steps,expected,priority,negative\n"
+
+// upload posts a CSV file to the import preview.
+func (e qaEnv) upload(t *testing.T, raw, path, csv string) (*http.Response, string) {
+	t.Helper()
+	var body bytes.Buffer
+	mw := multipart.NewWriter(&body)
+	fw, _ := mw.CreateFormFile("file", "cases.csv")
+	fw.Write([]byte(csv))
+	mw.Close()
+	req := httptest.NewRequest(http.MethodPost, "http://"+e.host+path, &body)
+	req.Host = e.host
+	req.Header.Set("Content-Type", mw.FormDataContentType())
+	req.AddCookie(&http.Cookie{Name: "lotus_session", Value: raw})
+	resp, err := e.app.Test(req, 30_000)
+	if err != nil {
+		t.Fatalf("upload: %v", err)
+	}
+	defer resp.Body.Close()
+	out, _ := io.ReadAll(resp.Body)
+	return resp, string(out)
+}
+
+// confirmField is the CSV the preview carries into its confirm form.
+func confirmField(t *testing.T, body string) string {
+	t.Helper()
+	m := regexp.MustCompile(`(?s)<textarea name="csv" hidden>(.*?)</textarea>`).FindStringSubmatch(body)
+	if m == nil {
+		t.Fatalf("preview has no confirm form:\n%s", body)
+	}
+	return htmlUnescape(m[1])
+}
+
+func htmlUnescape(s string) string {
+	return strings.NewReplacer("&lt;", "<", "&gt;", ">", "&#34;", `"`, "&#39;", "'", "&amp;", "&").Replace(s)
+}
+
+func TestQACaseImport_PreviewThenConfirm(t *testing.T) {
+	e := newQAEnv(t, "acme-qaimport")
+	ctx := context.Background()
+	p := e.project(t, "Portal")
+	repo.CreateQASection(ctx, e.s, p, "Auth", nil)
+	base := "/projects/" + p.String() + "/qa/cases/import"
+
+	if status, body := e.get(t, e.owner, base); status != http.StatusOK || !strings.Contains(body, `type="file"`) {
+		t.Fatalf("upload page = %d", status)
+	}
+	csv := qaCSVHead + "Auth / Login,Login valid,,\"Open\nSubmit\",\"Page\nHome\",high,\n" + "Billing,Pay <b>invoice</b>,,,,,yes\n"
+	resp, body := e.upload(t, e.owner, base, csv)
+	if resp.StatusCode != http.StatusOK || !strings.Contains(body, "2 cases") || !strings.Contains(body, "Auth / Login") ||
+		!strings.Contains(body, "Billing") || !strings.Contains(body, "Import 2 cases") {
+		t.Fatalf("preview = %d:\n%s", resp.StatusCode, body)
+	}
+	if n, _ := repo.CountQACases(ctx, e.s, p, repo.QACaseFilter{}); n != 0 {
+		t.Fatal("preview wrote cases")
+	}
+
+	resp, _ = e.post(t, e.owner, base+"/confirm", url.Values{"csv": {confirmField(t, body)}}, false)
+	if resp.StatusCode != http.StatusFound || resp.Header.Get("Location") != "/projects/"+p.String()+"/qa/cases" {
+		t.Fatalf("confirm = %d %s", resp.StatusCode, resp.Header.Get("Location"))
+	}
+	c, err := repo.GetQACaseByKey(ctx, e.s, p, 2)
+	if err != nil || c.Title != "Pay <b>invoice</b>" || !c.Negative {
+		t.Fatalf("imported case 2 = %+v, %v", c, err)
+	}
+}
+
+func TestQACaseImport_RowErrorsBlockTheImport(t *testing.T) {
+	e := newQAEnv(t, "acme-qaimport-bad")
+	ctx := context.Background()
+	p := e.project(t, "Portal")
+	old, _ := repo.CreateQASection(ctx, e.s, p, "Old", nil)
+	repo.ArchiveQASection(ctx, e.s, old.ID)
+	base := "/projects/" + p.String() + "/qa/cases/import"
+
+	resp, body := e.upload(t, e.owner, base, qaCSVHead+"Auth,,,,,,\nOld / Deep,Legacy,,,,,\nAuth,Fine,,,,,\n")
+	if resp.StatusCode != http.StatusUnprocessableEntity || strings.Contains(body, `name="csv"`) {
+		t.Fatalf("preview with errors = %d; want 422 and no confirm form", resp.StatusCode)
+	}
+	if !strings.Contains(body, "Row 2: title is required.") || !hasText(body, "Row 3: section 'Old' is archived.") {
+		t.Fatalf("errors missing:\n%s", body)
+	}
+	// Confirming a crafted form re-checks and refuses the same way.
+	resp, _ = e.post(t, e.owner, base+"/confirm", url.Values{"csv": {qaCSVHead + "Old,Legacy,,,,,\n"}}, false)
+	if resp.StatusCode != http.StatusUnprocessableEntity {
+		t.Fatalf("confirm with errors = %d; want 422", resp.StatusCode)
+	}
+	resp, body = e.upload(t, e.owner, base, "title,section\n")
+	if resp.StatusCode != http.StatusUnprocessableEntity || !strings.Contains(body, "The first row must be the header") {
+		t.Fatalf("bad header = %d", resp.StatusCode)
+	}
+	if n, _ := repo.CountQACases(ctx, e.s, p, repo.QACaseFilter{IncludeArchived: true}); n != 0 {
+		t.Fatalf("cases = %d; want none", n)
+	}
+}
+
+func TestQACaseExport_RoundTripsIntoAnotherProject(t *testing.T) {
+	e := newQAEnv(t, "acme-qaexport")
+	ctx := context.Background()
+	viewer, _ := e.session(t, "viewer@acme.example", "viewer")
+	from := e.project(t, "Portal")
+	to := e.project(t, "Portal copy")
+	auth, _ := repo.CreateQASection(ctx, e.s, from, "Auth", nil)
+	login, _ := repo.CreateQASection(ctx, e.s, from, "Login", &auth.ID)
+	other, _ := repo.CreateQASection(ctx, e.s, from, "Billing", nil)
+	high := "high"
+	repo.CreateQACase(ctx, e.s, from, repo.QACaseInput{SectionID: login.ID, Title: "=Login, \"quoted\"", Precondition: "User\nexists",
+		Priority: &high, Steps: repo.QASteps{{Action: "Open", Expected: "-page shows"}, {Action: "Submit", Expected: ""}}}, nil)
+	repo.CreateQACase(ctx, e.s, from, repo.QACaseInput{SectionID: auth.ID, Title: "Session expires", Negative: true}, nil)
+	repo.CreateQACase(ctx, e.s, from, repo.QACaseInput{SectionID: other.ID, Title: "Pay"}, nil)
+
+	resp, err := e.app.Test(reqWithSession(http.MethodGet, e.host, "/projects/"+from.String()+"/qa/cases/export?section="+auth.ID.String(), viewer))
+	if err != nil || resp.StatusCode != http.StatusOK || !strings.HasPrefix(resp.Header.Get("Content-Type"), "text/csv") ||
+		!strings.Contains(resp.Header.Get("Content-Disposition"), "attachment") {
+		t.Fatalf("export = %v %v", resp, err)
+	}
+	csv, _ := io.ReadAll(resp.Body)
+	if strings.Contains(string(csv), "Pay") {
+		t.Fatal("export of Auth includes another section's case")
+	}
+
+	_, body := e.upload(t, e.owner, "/projects/"+to.String()+"/qa/cases/import", string(csv))
+	e.post(t, e.owner, "/projects/"+to.String()+"/qa/cases/import/confirm", url.Values{"csv": {confirmField(t, body)}}, false)
+	src, _ := repo.ListQACases(ctx, e.s, from, repo.QACaseFilter{SectionID: &auth.ID, IncludeSubsections: true})
+	dst, _ := repo.ListQACases(ctx, e.s, to, repo.QACaseFilter{})
+	if len(dst) != len(src) {
+		t.Fatalf("round trip: %d cases; want %d", len(dst), len(src))
+	}
+	for i := range src {
+		a, b := src[i], dst[i]
+		if a.Title != b.Title || a.Precondition != b.Precondition || fmt.Sprint(a.Steps) != fmt.Sprint(b.Steps) ||
+			fmt.Sprint(a.Priority != nil) != fmt.Sprint(b.Priority != nil) || a.Negative != b.Negative {
+			t.Fatalf("case %d changed:\n%+v\n%+v", i, a, b)
+		}
+	}
+	if resp, _ := e.upload(t, viewer, "/projects/"+to.String()+"/qa/cases/import", string(csv)); resp.StatusCode != http.StatusForbidden {
+		t.Fatalf("viewer import = %d; want 403", resp.StatusCode)
+	}
+}
+
+func TestQACaseImport_FiveThousandRowsInOneRequest(t *testing.T) {
+	if testing.Short() {
+		t.Skip("slow")
+	}
+	e := newQAEnv(t, "acme-qaimport-big")
+	p := e.project(t, "Portal")
+	var b strings.Builder
+	b.WriteString(qaCSVHead)
+	for i := 0; i < qaCSVMaxRows; i++ {
+		fmt.Fprintf(&b, "Area %d / Flow %d,Case %d,,\"Open\nSubmit\",\"Page\nDone\",medium,\n", i%20, i%7, i)
+	}
+	base := "/projects/" + p.String() + "/qa/cases/import"
+	start := time.Now()
+	_, body := e.upload(t, e.owner, base, b.String())
+	resp, _ := e.post(t, e.owner, base+"/confirm", url.Values{"csv": {confirmField(t, body)}}, false)
+	if resp.StatusCode != http.StatusFound {
+		t.Fatalf("confirm = %d", resp.StatusCode)
+	}
+	if took := time.Since(start); took > 10*time.Second {
+		t.Fatalf("5000-row import took %s; want under 10s", took)
+	}
+	if n, _ := repo.CountQACases(context.Background(), e.s, p, repo.QACaseFilter{}); n != qaCSVMaxRows {
+		t.Fatalf("imported %d; want %d", n, qaCSVMaxRows)
+	}
+}
