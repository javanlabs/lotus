+        <button type="submit" class="lotus-row-action" aria-label="Remove TC-{{.CaseKey}} from the scenario">
+          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="transform:rotate(45deg)"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
+        </button>
+      </form>
+    </span>
+    {{end}}
+  </div>
+  {{end}}
+  {{end}}
+  {{end}}
+  {{if and $d.CanWrite $d.Cases}}
+  <form id="scenario-items" method="post" action="{{$scen}}/items/group" hx-post="{{$scen}}/items/group" hx-target="#scenario-error" hx-swap="innerHTML"
+        style="display:flex;gap:8px;align-items:center;justify-content:flex-end;padding:10px 14px">
+    <span style="font-size:12px;color:#6B7280">Move ticked cases to</span>
+    <div style="min-width:180px">{{template "lotus_select" (dict "Name" "group_id" "ID" "regroup-group" "Value" "" "Label" "Group" "Options" (selectOptions $d.GroupOptions))}}</div>
+    <button type="submit" class="btn-lotus btn-lotus-secondary">Move</button>
+  </form>
+  {{end}}
+{{template "lotus_card_section_close" .}}
+
+{{template "shell_close" .}}
+{{end}}
+
+{{/* qa_step_button is a one-step move (a chevron up or down) posted with htmx.
