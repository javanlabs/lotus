diff --git a/web/templates/pages/qa_report.html b/web/templates/pages/qa_report.html
new file mode 100644
index 0000000..7a358d9
--- /dev/null
+++ b/web/templates/pages/qa_report.html
@@ -0,0 +1,70 @@
+{{define "content"}}
+{{$d := .Data}}
+{{/* The plan report, signed in or through a share link. Standalone (no
+     sidebar) so it prints as it reads. Deliberately no forms, no files and
+     no links into the app: a share link must open this and nothing more. */}}
+<style>
+  .qa-report { max-width: 880px; margin: 0 auto; padding: 32px 16px 48px; color: #111827; }
+  .qa-report h2 { margin: 26px 0 10px; font: 600 10.5px 'IBM Plex Mono', monospace; letter-spacing: .08em; color: var(--text-label); }
+  .qa-report-row { display: grid; gap: 10px; align-items: center; padding: 7px 0; border-top: 1px solid var(--ink-100); font-size: 12.5px; }
+  .qa-report * { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
+  @media print {
+    .qa-report-noprint { display: none !important; }
+    .qa-report { padding: 0; max-width: none; }
+    .qa-report-row { break-inside: avoid; }
+  }
+</style>
+<main class="qa-report">
+  <header style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:12px">
+    <div style="flex:1;min-width:220px">
+      <div style="font:500 11px 'IBM Plex Mono',monospace;color:#6B7280">{{$d.ProjectName}} · Plan report</div>
+      <h1 style="margin:4px 0 0;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#43284E">{{$d.Plan.Name}}</h1>
+      <p style="margin:4px 0 0;font-size:12.5px;color:#6B7280">{{$d.PhaseLabel}}{{if $d.Plan.Environment}} · {{$d.Plan.Environment}}{{end}}{{if $d.Plan.Build}} · <span style="font-family:'IBM Plex Mono',monospace">{{$d.Plan.Build}}</span>{{end}}{{if $d.Window}} · {{$d.Window}}{{end}}{{if $d.Plan.ClosedAt}} · closed {{$d.Plan.ClosedAt.Format "02 Jan 2006"}}{{end}}</p>
+    </div>
+    <button type="button" class="btn-lotus btn-lotus-secondary qa-report-noprint" onclick="window.print()">Print</button>
+  </header>
+
+  <h2>PROGRESS</h2>
+  <div style="max-width:320px">{{template "qa_progress" $d.Progress}}</div>
+
+  <h2>SIGN-OFF</h2>
+  {{range $d.Signoffs}}
+  <div class="qa-report-row" style="grid-template-columns:minmax(0,1fr) 150px minmax(0,2fr);align-items:baseline">
+    <span style="font-weight:600">{{.Scope}}</span>
+    <span>{{if .Decision}}<span class="lotus-badge lotus-badge-{{.Tone}}">{{.Label}}</span>{{else}}<span style="color:#9CA3AF">Not signed off</span>{{end}}</span>
+    <span style="display:flex;flex-direction:column;gap:2px">
+      {{if .Note}}<span style="white-space:pre-wrap;color:#374151">{{.Note}}</span>{{end}}
+      {{if .Decision}}<span style="font-size:11px;color:#6B7280">{{.SignedBy}} · {{.SignedAt}}</span>{{end}}
+    </span>
+  </div>
+  {{end}}
+
+  <h2>SCENARIOS</h2>
+  {{range $d.Scenarios}}
+  <div class="qa-report-row" style="grid-template-columns:minmax(0,1fr) 110px 200px">
+    <span>{{.Name}}</span><span><span class="lotus-badge lotus-badge-none">{{.PhaseLabel}}</span></span>{{template "qa_progress" .Progress}}
+  </div>
+  {{else}}<p style="font-size:12.5px;color:#6B7280">No scenarios.</p>{{end}}
+
+  <h2>RUNS</h2>
+  {{range $d.Runs}}
+  <div class="qa-report-row" style="grid-template-columns:60px minmax(0,1fr) 200px">
+    <span style="font:500 11px 'IBM Plex Mono',monospace;color:#6B7280">{{.Cycle}}</span>
+    <span>{{.Name}}{{if .Closed}} <span class="lotus-badge lotus-badge-none">closed</span>{{end}}</span>
+    {{template "qa_progress" .Progress}}
+  </div>
+  {{else}}<p style="font-size:12.5px;color:#6B7280">No runs yet.</p>{{end}}
+
+  <h2>OPEN ISSUES · {{len $d.Issues}}</h2>
+  {{range $d.Issues}}
+  <div class="qa-report-row" style="grid-template-columns:72px minmax(0,1fr) 90px 80px">
+    <span style="font:500 11px 'IBM Plex Mono',monospace;color:#6B7280">BUG-{{.Key}}</span>
+    <span>{{.Title}}</span>
+    <span><span class="lotus-badge lotus-badge-{{.SeverityTone}}">{{.Severity}}</span></span>
+    <span style="font:500 11px 'IBM Plex Mono',monospace;color:#374151">{{.Status}}</span>
+  </div>
+  {{else}}<p style="font-size:12.5px;color:#6B7280">No open issues.</p>{{end}}
+
+  <p style="margin-top:28px;font-size:11px;color:#9CA3AF">Generated {{$d.Generated}}{{if $d.Shared}} · shared link, valid until {{$d.ExpiresOn}}{{end}} · Lotus</p>
+</main>
+{{end}}
