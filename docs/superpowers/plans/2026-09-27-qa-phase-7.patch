diff --git a/internal/web/qa_project_guests.go b/internal/web/qa_project_guests.go
new file mode 100644
index 0000000..2c6b7b2
--- /dev/null
+++ b/internal/web/qa_project_guests.go
@@ -0,0 +1,135 @@
+package web
+
+import (
+	"encoding/json"
+	"errors"
+	"strings"
+
+	"github.com/gofiber/fiber/v2"
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/authz"
+	"github.com/uyab/lotus/internal/httpx"
+	"github.com/uyab/lotus/internal/repo"
+	"github.com/uyab/lotus/internal/repo/global"
+	"github.com/uyab/lotus/internal/tenant"
+)
+
+// Guests of a project (project_member.manage): the organization's guests
+// listed on it see its QA, nothing else. The panel sits on the project
+// page; invitations can name projects too (Settings -> Members).
+
+type projectGuest struct {
+	ID    uuid.UUID
+	Label string
+}
+
+type projectGuestsView struct {
+	Listed  []projectGuest
+	Options []httpx.SelectOption // guests of the organization not listed yet
+}
+
+// projectGuestsFor builds the panel: who is listed, and who could be.
+func projectGuestsFor(c *fiber.Ctx, d Deps, s tenant.Scope, projectID uuid.UUID) (projectGuestsView, error) {
+	var v projectGuestsView
+	members, err := global.ListMembersForOrg(c.Context(), d.DB, s.OrgID())
+	if err != nil {
+		return v, err
+	}
+	listed, err := repo.ListProjectMemberUserIDs(c.Context(), s, projectID)
+	if err != nil {
+		return v, err
+	}
+	on := map[uuid.UUID]bool{}
+	for _, id := range listed {
+		on[id] = true
+	}
+	v.Options = []httpx.SelectOption{}
+	for _, m := range members {
+		if m.RoleKey != "guest" {
+			continue
+		}
+		label := m.Name
+		if strings.TrimSpace(label) == "" {
+			label = m.Email
+		} else {
+			label += " · " + m.Email
+		}
+		if on[m.UserID] {
+			v.Listed = append(v.Listed, projectGuest{ID: m.UserID, Label: label})
+		} else {
+			v.Options = append(v.Options, httpx.SelectOption{Value: m.UserID.String(), Label: label})
+		}
+	}
+	return v, nil
+}
+
+func auditProjectMember(c *fiber.Ctx, s tenant.Scope, action string, projectID, userID uuid.UUID) error {
+	raw, _ := json.Marshal(fiber.Map{"project_id": projectID, "user_id": userID})
+	return repo.RecordAuditEvent(c.Context(), s, qaActor(c), action, "project", &projectID, raw)
+}
+
+// guestOf reads a user id that must be a guest of this organization.
+func guestOf(c *fiber.Ctx, d Deps, s tenant.Scope, raw string) (uuid.UUID, error) {
+	id, err := uuid.Parse(strings.TrimSpace(raw))
+	if err != nil {
+		return uuid.Nil, fiber.ErrNotFound
+	}
+	m, err := global.ActiveMembership(c.Context(), d.DB, id, s.OrgID())
+	if err != nil || m == nil || m.RoleKey != "guest" {
+		return uuid.Nil, fiber.ErrNotFound
+	}
+	return id, nil
+}
+
+func addProjectGuestUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		userID, err := guestOf(c, d, s, c.FormValue("user_id"))
+		if err != nil {
+			return err
+		}
+		if err := repo.AddProjectMember(c.Context(), s, project.ID, userID); err != nil {
+			if errors.Is(err, repo.ErrNotFound) {
+				return fiber.ErrNotFound
+			}
+			return writeRepoErr(c, err)
+		}
+		if err := auditProjectMember(c, s, "project_member.add", project.ID, userID); err != nil {
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "project.guest.added")
+		return redirectAfterMutation(c, "/projects/"+project.ID.String())
+	}
+}
+
+func removeProjectGuestUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		userID, err := uuid.Parse(c.Params("uid"))
+		if err != nil {
+			return fiber.ErrNotFound
+		}
+		if err := repo.RemoveProjectMember(c.Context(), s, project.ID, userID); err != nil {
+			return writeRepoErr(c, err)
+		}
+		if err := auditProjectMember(c, s, "project_member.remove", project.ID, userID); err != nil {
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "project.guest.removed")
+		return redirectAfterMutation(c, "/projects/"+project.ID.String())
+	}
+}
+
+func registerProjectGuestRoutes(app *fiber.App, d Deps, requireSession, loadPrincipal fiber.Handler) {
+	app.Post("/projects/:id/guests", tenant.RequireTenant(), requireSession, loadPrincipal,
+		authz.Require("project_member.manage"), addProjectGuestUI(d))
+	app.Post("/projects/:id/guests/:uid/remove", tenant.RequireTenant(), requireSession, loadPrincipal,
+		authz.Require("project_member.manage"), removeProjectGuestUI(d))
+}
diff --git a/internal/web/qa_share.go b/internal/web/qa_share.go
new file mode 100644
index 0000000..2449a51
--- /dev/null
+++ b/internal/web/qa_share.go
@@ -0,0 +1,298 @@
+package web
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"regexp"
+	"time"
+
+	"github.com/gofiber/fiber/v2"
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/authz"
+	"github.com/uyab/lotus/internal/httpx"
+	"github.com/uyab/lotus/internal/repo"
+	"github.com/uyab/lotus/internal/tenant"
+)
+
+// The plan report: what a client signs off against. Signed in, anyone who
+// reads QA opens it at …/plans/:pid/report; qa.share hands out a link
+// (/s/qa/:token) that opens the same report with no login, read-only,
+// until it expires (30 days) or is revoked. The report holds no forms, no
+// attachments and no links into the app.
+
+type qaReportScenario struct {
+	Name       string
+	PhaseLabel string
+	Progress   repo.QAProgress
+}
+
+type qaReportRun struct {
+	Name     string
+	Cycle    int
+	Closed   bool
+	Progress repo.QAProgress
+}
+
+type qaReportIssue struct {
+	Key          int
+	Title        string
+	Severity     string
+	SeverityTone string
+	Status       string
+}
+
+type qaReportData struct {
+	ProjectName string
+	Plan        repo.QAPlan
+	PhaseLabel  string
+	Window      string
+	Progress    repo.QAProgress
+	Scenarios   []qaReportScenario
+	Runs        []qaReportRun
+	Issues      []qaReportIssue
+	Signoffs    []qaSignoffRow
+	Shared      bool // opened through a share link
+	Generated   string
+	ExpiresOn   string // the share link's last day
+}
+
+// buildQAReport gathers the report; shared is true for a share link, whose
+// holder is nobody in particular (see qaPlanSignoffs).
+func buildQAReport(c *fiber.Ctx, d Deps, s tenant.Scope, project *repo.Project, plan *repo.QAPlan, shared bool) (qaReportData, error) {
+	data := qaReportData{ProjectName: project.Name, Plan: *plan, Shared: shared, PhaseLabel: qaPhaseLabels[plan.Phase],
+		Window: qaWindow(plan.StartsOn, plan.EndsOn), Generated: time.Now().Format("02 Jan 2006 15:04")}
+	progress, err := repo.QAPlanProgress(c.Context(), s, []uuid.UUID{plan.ID})
+	if err != nil {
+		return data, err
+	}
+	data.Progress = progress[plan.ID]
+
+	ids, err := repo.ListQAPlanScenarioIDs(c.Context(), s, plan.ID)
+	if err != nil {
+		return data, err
+	}
+	inPlan := map[uuid.UUID]bool{}
+	for _, id := range ids {
+		inPlan[id] = true
+	}
+	all, err := repo.ListQAScenarios(c.Context(), s, project.ID, true)
+	if err != nil {
+		return data, err
+	}
+	perScenario, err := repo.QAPlanScenarioProgress(c.Context(), s, plan.ID)
+	if err != nil {
+		return data, err
+	}
+	var rows []qaScenarioRow
+	for _, sc := range all {
+		if inPlan[sc.ID] {
+			rows = append(rows, qaScenarioRow{QAScenario: sc})
+			data.Scenarios = append(data.Scenarios, qaReportScenario{Name: sc.Name, PhaseLabel: qaPhaseLabels[sc.Phase], Progress: perScenario[sc.ID]})
+		}
+	}
+	if data.Signoffs, err = qaPlanSignoffs(c, d, s, plan.ID, rows, shared); err != nil {
+		return data, err
+	}
+
+	runs, err := repo.ListQARuns(c.Context(), s, plan.ID)
+	if err != nil {
+		return data, err
+	}
+	runIDs := make([]uuid.UUID, len(runs))
+	for i, r := range runs {
+		runIDs[i] = r.ID
+	}
+	runProgress, err := repo.QARunProgressFor(c.Context(), s, runIDs)
+	if err != nil {
+		return data, err
+	}
+	for _, r := range runs {
+		data.Runs = append(data.Runs, qaReportRun{Name: r.Name, Cycle: r.Cycle, Closed: r.ClosedAt != nil, Progress: runProgress[r.ID]})
+	}
+
+	issues, err := repo.ListQAIssues(c.Context(), s, project.ID, repo.QAIssueFilter{Statuses: repo.QAOpenIssueStatuses, PlanID: &plan.ID})
+	if err != nil {
+		return data, err
+	}
+	for _, is := range issues {
+		data.Issues = append(data.Issues, qaReportIssue{Key: is.Key, Title: is.Title, Severity: is.Severity,
+			SeverityTone: qaSeverityTone(is.Severity), Status: is.Status})
+	}
+	return data, nil
+}
+
+func renderQAReport(c *fiber.Ctx, d Deps, data qaReportData) error {
+	c.Type("html")
+	return renderPage(c, d, "pages/qa_report.html", httpx.ViewData{
+		Title: data.Plan.Name + " · " + data.ProjectName, Data: data,
+	})
+}
+
+// qaReportPage is GET …/plans/:pid/report (qa.read).
+func qaReportPage(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		plan, err := loadQAPlan(c, s, project)
+		if err != nil {
+			return err
+		}
+		data, err := buildQAReport(c, d, s, project, plan, false)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		return renderQAReport(c, d, data)
+	}
+}
+
+var qaShareTokenPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)
+
+func qaShareTokenHash(raw string) string {
+	sum := sha256.Sum256([]byte(raw))
+	return hex.EncodeToString(sum[:])
+}
+
+// qaSharedReport is GET /s/qa/:token: no session, the token is the whole
+// authorization, and it answers for one plan's report only. Anything wrong
+// with it (unknown, revoked, expired, another organization's) is 404.
+func qaSharedReport(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		// A link is a secret: not cached, not indexed, not leaked onward.
+		c.Set("Cache-Control", "no-store")
+		c.Set("X-Robots-Tag", "noindex, nofollow")
+		c.Set("Referrer-Policy", "no-referrer")
+		token := c.Params("token")
+		if !qaShareTokenPattern.MatchString(token) {
+			return fiber.ErrNotFound
+		}
+		s, err := mustScope(c)
+		if err != nil {
+			return err
+		}
+		link, err := repo.QAShareLinkByHash(c.Context(), s, qaShareTokenHash(token))
+		if errors.Is(err, repo.ErrNotFound) {
+			return fiber.ErrNotFound
+		}
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		plan, err := repo.GetQAPlan(c.Context(), s, link.PlanID)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		project, err := repo.ProjectByID(c.Context(), s, plan.ProjectID)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		data, err := buildQAReport(c, d, s, project, plan, true)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		data.ExpiresOn = link.ExpiresAt.Format("02 Jan 2006")
+		return renderQAReport(c, d, data)
+	}
+}
+
+type qaShareRow struct {
+	ID        uuid.UUID
+	CreatedBy string
+	CreatedAt string
+	ExpiresOn string
+}
+
+// qaPlanShares lists planID's live links for the plan page.
+func qaPlanShares(c *fiber.Ctx, d Deps, s tenant.Scope, planID uuid.UUID) ([]qaShareRow, error) {
+	links, err := repo.ListQAShareLinks(c.Context(), s, planID)
+	if err != nil || len(links) == 0 {
+		return nil, err
+	}
+	labels, err := qaPeopleLabels(c, d, s)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]qaShareRow, len(links))
+	for i, l := range links {
+		out[i] = qaShareRow{ID: l.ID, CreatedBy: personLabel(labels, l.CreatedBy),
+			CreatedAt: l.CreatedAt.Format("02 Jan 2006"), ExpiresOn: l.ExpiresAt.Format("02 Jan 2006")}
+	}
+	return out, nil
+}
+
+// createQAShareUI makes a link and shows it once: only its hash is kept.
+func createQAShareUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		plan, err := loadQAPlan(c, s, project)
+		if err != nil {
+			return err
+		}
+		raw, hash, err := newInvitationToken()
+		if err != nil {
+			return err
+		}
+		link, err := repo.CreateQAShareLink(c.Context(), s, plan.ID, hash, qaActor(c))
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		audit, _ := json.Marshal(fiber.Map{"plan_id": plan.ID, "link_id": link.ID, "expires_at": link.ExpiresAt})
+		if err := repo.RecordAuditEvent(c.Context(), s, qaActor(c), "qa.share.create", "qa_plan", &plan.ID, audit); err != nil {
+			return writeRepoErr(c, err)
+		}
+		org, ok := tenant.OrgFromContext(c)
+		if !ok {
+			return fiber.ErrNotFound
+		}
+		c.Set("Cache-Control", "no-store")
+		c.Type("html")
+		return d.Renderer.RenderNamed(c, "qa_share_created", fiber.Map{
+			"Link": d.Cfg.TenantURL(org.Subdomain) + "/s/qa/" + raw, "ExpiresOn": link.ExpiresAt.Format("02 Jan 2006"),
+			"Back": planURL(project, plan),
+		})
+	}
+}
+
+func revokeQAShareUI() fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		plan, err := loadQAPlan(c, s, project)
+		if err != nil {
+			return err
+		}
+		id, err := uuid.Parse(c.Params("lid"))
+		if err != nil {
+			return fiber.ErrNotFound
+		}
+		if err := repo.RevokeQAShareLink(c.Context(), s, plan.ID, id); err != nil {
+			if errors.Is(err, repo.ErrNotFound) {
+				return fiber.ErrNotFound
+			}
+			return writeRepoErr(c, err)
+		}
+		audit, _ := json.Marshal(fiber.Map{"plan_id": plan.ID, "link_id": id})
+		if err := repo.RecordAuditEvent(c.Context(), s, qaActor(c), "qa.share.revoke", "qa_plan", &plan.ID, audit); err != nil {
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "qa.share.revoked")
+		return redirectAfterMutation(c, planURL(project, plan))
+	}
+}
+
+func registerQAShareRoutes(app *fiber.App, d Deps, requireSession, loadPrincipal fiber.Handler) {
+	app.Get("/s/qa/:token", tenant.RequireTenant(),
+		authz.Public("QA share link: the token is checked by the handler and opens one plan report only"),
+		qaSharedReport(d))
+	app.Get("/projects/:id/qa/plans/:pid/report", qaRoute(requireSession, loadPrincipal, "qa.read", qaReportPage(d))...)
+	app.Post("/projects/:id/qa/plans/:pid/share", qaRoute(requireSession, loadPrincipal, "qa.share", createQAShareUI(d))...)
+	app.Post("/projects/:id/qa/plans/:pid/share/:lid/revoke", qaRoute(requireSession, loadPrincipal, "qa.share", revokeQAShareUI())...)
+}
diff --git a/internal/web/qa_share_test.go b/internal/web/qa_share_test.go
new file mode 100644
index 0000000..399813d
--- /dev/null
+++ b/internal/web/qa_share_test.go
@@ -0,0 +1,118 @@
+package web
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/uyab/lotus/internal/repo"
+)
+
+var shareLink = regexp.MustCompile(`/s/qa/([0-9a-f]{64})`)
+
+// openShared fetches a share link with no session at all.
+func (r qaRunEnv) openShared(t *testing.T, host, token string) (*http.Response, string) {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodGet, "http://"+host+"/s/qa/"+token, nil)
+	req.Host = host
+	resp, err := r.app.Test(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(resp.Body)
+	return resp, string(body)
+}
+
+func TestQAShare_LinkOpensTheReportUntilRevoked(t *testing.T) {
+	r := newQARunEnv(t, "acme-share")
+	ctx := context.Background()
+	planPath := r.base + "/plans/" + r.plan.ID.String()
+	if _, err := repo.CreateQAIssue(ctx, r.s, r.projectID, repo.QAIssueInput{
+		Title: "Total <b>rounds</b> wrong", Severity: "major", PlanID: &r.plan.ID, Source: "internal",
+	}, nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := repo.RecordQASignoff(ctx, r.s, r.plan.ID, repo.QASignoffInput{Decision: "rejected", Note: "Rounding"}, &r.guestID); err != nil {
+		t.Fatal(err)
+	}
+
+	// Only qa.share creates links; the plan page offers it to a member.
+	if _, body := r.get(t, r.member, planPath); !strings.Contains(body, `action="`+planPath+`/share"`) {
+		t.Fatalf("member plan page has no share form")
+	}
+	if _, body := r.get(t, r.guest, planPath); strings.Contains(body, `action="`+planPath+`/share"`) {
+		t.Errorf("guest sees the share form")
+	}
+	if resp, _ := r.post(t, r.guest, planPath+"/share", nil, false); resp.StatusCode != http.StatusForbidden {
+		t.Errorf("guest share = %d; want 403", resp.StatusCode)
+	}
+	_, body := r.post(t, r.member, planPath+"/share", url.Values{}, true)
+	m := shareLink.FindStringSubmatch(body)
+	if m == nil {
+		t.Fatalf("share response has no link:\n%s", body)
+	}
+	token := m[1]
+
+	resp, body := r.openShared(t, r.host, token)
+	if resp.StatusCode != http.StatusOK || !strings.Contains(body, r.plan.Name) || !strings.Contains(body, "Total &lt;b&gt;rounds&lt;/b&gt; wrong") ||
+		!strings.Contains(body, "Rejected") || !strings.Contains(body, "Rounding") {
+		t.Fatalf("shared report = %d:\n%s", resp.StatusCode, body)
+	}
+	// The signer is named, never shown by address: the guest here has no
+	// name, and its email must not reach whoever holds the link.
+	for _, leak := range []string{"<form", "/qa/files/", `href="/projects`, "hx-post", "client@bank.example"} {
+		if strings.Contains(body, leak) {
+			t.Errorf("shared report contains %q", leak)
+		}
+	}
+	for header, want := range map[string]string{"Cache-Control": "no-store", "X-Robots-Tag": "noindex", "Referrer-Policy": "no-referrer"} {
+		if got := resp.Header.Get(header); !strings.Contains(got, want) {
+			t.Errorf("%s = %q; want %q", header, got, want)
+		}
+	}
+	// The token opens this report and nothing else.
+	if status, _ := r.get(t, token, planPath); status == http.StatusOK {
+		t.Errorf("token as a session opened the plan page")
+	}
+	if resp, _ := r.openShared(t, r.host, strings.Repeat("0", 64)); resp.StatusCode != http.StatusNotFound {
+		t.Errorf("unknown token = %d; want 404", resp.StatusCode)
+	}
+	other := newQAEnv(t, "other-share")
+	if resp, _ := r.openShared(t, other.host, token); resp.StatusCode != http.StatusNotFound {
+		t.Errorf("token on another organization's host = %d; want 404", resp.StatusCode)
+	}
+
+	// The plan page lists the live link; revoking it ends it.
+	links, _ := repo.ListQAShareLinks(ctx, r.s, r.plan.ID)
+	if len(links) != 1 {
+		t.Fatalf("links = %d", len(links))
+	}
+	revoke := planPath + "/share/" + links[0].ID.String() + "/revoke"
+	if _, body := r.get(t, r.member, planPath); !strings.Contains(body, `action="`+revoke+`"`) {
+		t.Errorf("plan page does not list the live link")
+	}
+	if resp, _ := r.post(t, r.member, revoke, nil, false); resp.StatusCode != http.StatusFound {
+		t.Fatalf("revoke = %d", resp.StatusCode)
+	}
+	if resp, _ := r.openShared(t, r.host, token); resp.StatusCode != http.StatusNotFound {
+		t.Errorf("revoked link = %d; want 404", resp.StatusCode)
+	}
+	if resp, _ := r.post(t, r.member, revoke, nil, false); resp.StatusCode != http.StatusNotFound {
+		t.Errorf("revoke twice = %d; want 404", resp.StatusCode)
+	}
+	if a, b := auditCount(t, r.db, r.orgID, "qa.share.create"), auditCount(t, r.db, r.orgID, "qa.share.revoke"); a != 1 || b != 1 {
+		t.Errorf("audit create/revoke = %d/%d; want 1/1", a, b)
+	}
+
+	// Signed in, anyone who reads QA prints the same report.
+	status, body := r.get(t, r.guest, planPath+"/report")
+	if status != http.StatusOK || !strings.Contains(body, "window.print()") || strings.Contains(body, "/qa/files/") {
+		t.Fatalf("report for guest = %d", status)
+	}
+}
diff --git a/internal/web/qa_signoff.go b/internal/web/qa_signoff.go
new file mode 100644
index 0000000..e374d95
--- /dev/null
+++ b/internal/web/qa_signoff.go
@@ -0,0 +1,152 @@
+package web
+
+import (
+	"encoding/json"
+	"errors"
+	"strings"
+
+	"github.com/gofiber/fiber/v2"
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/httpx"
+	"github.com/uyab/lotus/internal/repo"
+	"github.com/uyab/lotus/internal/repo/global"
+	"github.com/uyab/lotus/internal/tenant"
+)
+
+// Sign-off (qa.signoff): the client's verdict on a plan, for the whole plan
+// or one of its scenarios. The plan page shows the standing one per scope;
+// the audit log keeps every one.
+
+var qaSignoffLabels = map[string]string{
+	"accepted":            "Accepted",
+	"accepted_with_notes": "Accepted with notes",
+	"rejected":            "Rejected",
+}
+
+var qaSignoffTones = map[string]string{
+	"accepted":            "pass",
+	"accepted_with_notes": "none",
+	"rejected":            "fail",
+}
+
+// qaSignoffRow is one scope of a plan and where it stands.
+type qaSignoffRow struct {
+	Scope    string // "Whole plan" or the scenario's name
+	Decision string // "" when nobody has signed this scope off
+	Label    string
+	Tone     string
+	Note     string
+	SignedBy string
+	SignedAt string
+}
+
+// qaPlanSignoffs lists the whole plan, then each of its scenarios, with the
+// latest sign-off of each. namesOnly is for the shared report: a signer is
+// shown by name, never by email address (no name shows "—").
+func qaPlanSignoffs(c *fiber.Ctx, d Deps, s tenant.Scope, planID uuid.UUID, scenarios []qaScenarioRow, namesOnly bool) ([]qaSignoffRow, error) {
+	latest, err := repo.ListLatestQASignoffs(c.Context(), s, planID)
+	if err != nil {
+		return nil, err
+	}
+	labels, err := qaPeopleLabels(c, d, s)
+	if err != nil {
+		return nil, err
+	}
+	if namesOnly {
+		if labels, err = qaPeopleNames(c, d, s); err != nil {
+			return nil, err
+		}
+	}
+	byScope := map[uuid.UUID]repo.QASignoff{}
+	for _, so := range latest {
+		key := uuid.Nil
+		if so.ScenarioID != nil {
+			key = *so.ScenarioID
+		}
+		byScope[key] = so
+	}
+	row := func(scope string, key uuid.UUID) qaSignoffRow {
+		r := qaSignoffRow{Scope: scope}
+		if so, ok := byScope[key]; ok {
+			r.Decision, r.Label, r.Tone, r.Note = so.Decision, qaSignoffLabels[so.Decision], qaSignoffTones[so.Decision], so.Note
+			r.SignedBy, r.SignedAt = personLabel(labels, so.SignedBy), so.SignedAt.Format("02 Jan 2006 15:04")
+		}
+		return r
+	}
+	out := []qaSignoffRow{row("Whole plan", uuid.Nil)}
+	for _, sc := range scenarios {
+		out = append(out, row(sc.Name, sc.ID))
+	}
+	return out, nil
+}
+
+// qaPeopleNames is qaPeopleLabels without the email fallback: members with
+// no name are left out.
+func qaPeopleNames(c *fiber.Ctx, d Deps, s tenant.Scope) (map[uuid.UUID]string, error) {
+	members, err := global.ListMembersForOrg(c.Context(), d.DB, s.OrgID())
+	if err != nil {
+		return nil, err
+	}
+	out := make(map[uuid.UUID]string, len(members))
+	for _, m := range members {
+		if name := strings.TrimSpace(m.Name); name != "" {
+			out[m.UserID] = name
+		}
+	}
+	return out, nil
+}
+
+// qaSignoffScopes are the choices of the sign-off form.
+func qaSignoffScopes(scenarios []qaScenarioRow) []httpx.SelectOption {
+	out := []httpx.SelectOption{{Value: "plan", Label: "Whole plan"}}
+	for _, sc := range scenarios {
+		out = append(out, httpx.SelectOption{Value: sc.ID.String(), Label: sc.Name})
+	}
+	return out
+}
+
+func recordQASignoffUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		plan, err := loadQAPlan(c, s, project)
+		if err != nil {
+			return err
+		}
+		in := repo.QASignoffInput{Decision: c.FormValue("decision"), Note: c.FormValue("note")}
+		if scope := strings.TrimSpace(c.FormValue("scope")); scope != "plan" {
+			id, err := uuid.Parse(scope)
+			if err != nil {
+				return qaFormError(c, d, fiber.StatusUnprocessableEntity, "Choose the plan or one of its scenarios.")
+			}
+			in.ScenarioID = &id
+		}
+		if _, ok := qaSignoffLabels[in.Decision]; !ok {
+			return qaFormError(c, d, fiber.StatusUnprocessableEntity, "Choose a decision.")
+		}
+		if in.Decision != "accepted" && strings.TrimSpace(in.Note) == "" {
+			return qaFormError(c, d, fiber.StatusUnprocessableEntity, "Say what is wrong in the note.")
+		}
+		so, err := repo.RecordQASignoff(c.Context(), s, plan.ID, in, qaActor(c))
+		if errors.Is(err, repo.ErrInvalidInput) {
+			if in.ScenarioID != nil {
+				// The note and decision were checked above: what is left
+				// is a scenario that is not in this plan.
+				return qaFormError(c, d, fiber.StatusUnprocessableEntity, "Choose the plan or one of its scenarios.")
+			}
+			return qaFormError(c, d, fiber.StatusUnprocessableEntity, "The note is too long.")
+		}
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		raw, _ := json.Marshal(fiber.Map{"plan_id": plan.ID, "scenario_id": so.ScenarioID, "decision": so.Decision})
+		if err := repo.RecordAuditEvent(c.Context(), s, qaActor(c), "qa.signoff", "qa_plan", &plan.ID, raw); err != nil {
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "qa.signoff.recorded", qaSignoffLabels[so.Decision])
+		return redirectAfterMutation(c, planURL(project, plan))
+	}
+}
