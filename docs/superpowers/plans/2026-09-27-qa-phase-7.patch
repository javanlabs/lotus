@@ -0,0 +1,85 @@
+package global_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/jmoiron/sqlx"
+
+	"github.com/uyab/lotus/internal/dbtest"
+	"github.com/uyab/lotus/internal/repo/global"
+)
+
+func projectMembers(t *testing.T, db *sqlx.DB, orgID, userID uuid.UUID) map[uuid.UUID]bool {
+	t.Helper()
+	tx, _ := db.Beginx()
+	defer tx.Rollback() //nolint:errcheck
+	tx.Exec(`SELECT set_config('app.org_id', $1, true)`, orgID.String())
+	var ids []uuid.UUID
+	if err := tx.Select(&ids, `SELECT project_id FROM project_members WHERE user_id = $1`, userID); err != nil {
+		t.Fatal(err)
+	}
+	out := map[uuid.UUID]bool{}
+	for _, id := range ids {
+		out[id] = true
+	}
+	return out
+}
+
+// A guest invitation carries the projects the guest will see; accepting
+// it lists the guest on them (only projects of the inviting organization).
+func TestInvitation_GuestProjectsAreAppliedOnAccept(t *testing.T) {
+	db := dbtest.Open(t)
+	ctx := context.Background()
+	var orgID, otherOrg, a, b, foreign, inviter uuid.UUID
+	db.Get(&orgID, `INSERT INTO organizations (subdomain, name) VALUES ('acme-inv', 'Acme') RETURNING id`)
+	db.Get(&otherOrg, `INSERT INTO organizations (subdomain, name) VALUES ('other-inv', 'Other') RETURNING id`)
+	a, b = seedProject(t, db, orgID, "a"), seedProject(t, db, orgID, "b")
+	foreign = seedProject(t, db, otherOrg, "f")
+	db.Get(&inviter, `INSERT INTO users (email) VALUES ('admin@acme.example') RETURNING id`)
+
+	invID, err := global.CreateInvitation(ctx, db, global.NewInvitation{
+		OrgID: orgID, Email: "client@bank.example", RoleKey: "guest", InvitedBy: inviter,
+		TokenHash: "h1", ExpiresAt: time.Now().Add(time.Hour), ProjectIDs: []uuid.UUID{a, foreign},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Resending keeps the projects.
+	newID, err := global.ResendInvitation(ctx, db, invID, "h2", time.Now().Add(time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	u, _ := global.CreateUser(ctx, db, global.NewUser{Email: ptr("client@bank.example"), EmailVerified: true})
+	if err := global.AcceptInvitation(ctx, db, newID, u.ID); err != nil {
+		t.Fatal(err)
+	}
+	got := projectMembers(t, db, orgID, u.ID)
+	if len(got) != 1 || !got[a] || got[b] {
+		t.Fatalf("guest projects = %v; want only A (B was not chosen, F belongs to another organization)", got)
+	}
+	if m, _ := global.ActiveMembership(ctx, db, u.ID, orgID); m == nil || m.RoleKey != "guest" {
+		t.Fatalf("membership = %+v", m)
+	}
+}
+
+// seedProject inserts a project under its organization's row-level security.
+func seedProject(t *testing.T, db *sqlx.DB, orgID uuid.UUID, slug string) uuid.UUID {
+	t.Helper()
+	tx, err := db.Beginx()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Rollback() //nolint:errcheck
+	tx.Exec(`SELECT set_config('app.org_id', $1, true)`, orgID.String())
+	var id uuid.UUID
+	if err := tx.Get(&id, `INSERT INTO projects (org_id, slug, name) VALUES ($1, $2, $2) RETURNING id`, orgID, slug); err != nil {
+		t.Fatalf("project %s: %v", slug, err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	return id
+}
diff --git a/internal/repo/qa_share.go b/internal/repo/qa_share.go
new file mode 100644
index 0000000..ee63092
--- /dev/null
+++ b/internal/repo/qa_share.go
@@ -0,0 +1,112 @@
+package repo
+
+import (
+	"context"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/jmoiron/sqlx"
+
+	"github.com/uyab/lotus/internal/tenant"
+)
+
+// A share link opens one plan's read-only report to whoever holds it, with
+// no login (/s/qa/:token). Only the token's sha256 is stored; a link lasts
+// QAShareLinkTTL unless revoked first.
+
+const QAShareLinkTTL = 30 * 24 * time.Hour
+
+type QAShareLink struct {
+	ID        uuid.UUID  `db:"id"`
+	PlanID    uuid.UUID  `db:"plan_id"`
+	ExpiresAt time.Time  `db:"expires_at"`
+	RevokedAt *time.Time `db:"revoked_at"`
+	CreatedBy *uuid.UUID `db:"created_by"`
+	CreatedAt time.Time  `db:"created_at"`
+}
+
+const qaShareLinkCols = `id, plan_id, expires_at, revoked_at, created_by, created_at`
+
+func CreateQAShareLink(ctx context.Context, s tenant.Scope, planID uuid.UUID, tokenHash string, by *uuid.UUID) (*QAShareLink, error) {
+	var out QAShareLink
+	err := s.Tx(ctx, func(tx *sqlx.Tx) error {
+		return tx.GetContext(ctx, &out, `
+			INSERT INTO qa_share_links (org_id, plan_id, token_hash, expires_at, created_by)
+			VALUES ($1, $2, $3, now() + $4 * interval '1 second', $5) RETURNING `+qaShareLinkCols,
+			s.OrgID(), planID, tokenHash, int64(QAShareLinkTTL/time.Second), by)
+	})
+	if err != nil {
+		return nil, qaWriteErr(err)
+	}
+	return &out, nil
+}
+
+// QAShareLinkByHash is the live link with this token hash: ErrNotFound when
+// there is none, or it was revoked, or it has expired.
+func QAShareLinkByHash(ctx context.Context, s tenant.Scope, tokenHash string) (*QAShareLink, error) {
+	var out QAShareLink
+	err := s.Tx(ctx, func(tx *sqlx.Tx) error {
+		return tx.GetContext(ctx, &out, `
+			SELECT `+qaShareLinkCols+` FROM qa_share_links
+			WHERE token_hash = $1 AND revoked_at IS NULL AND expires_at > now()`, tokenHash)
+	})
+	if err != nil {
+		return nil, qaWriteErr(err)
+	}
+	return &out, nil
+}
+
+// ListQAShareLinks is planID's live links, newest first.
+func ListQAShareLinks(ctx context.Context, s tenant.Scope, planID uuid.UUID) ([]QAShareLink, error) {
+	var out []QAShareLink
+	err := s.Tx(ctx, func(tx *sqlx.Tx) error {
+		return tx.SelectContext(ctx, &out, `
+			SELECT `+qaShareLinkCols+` FROM qa_share_links
+			WHERE plan_id = $1 AND revoked_at IS NULL AND expires_at > now()
+			ORDER BY created_at DESC, id`, planID)
+	})
+	return out, err
+}
+
+// RevokeQAShareLink ends a live link of planID at once.
+func RevokeQAShareLink(ctx context.Context, s tenant.Scope, planID, id uuid.UUID) error {
+	return s.Tx(ctx, func(tx *sqlx.Tx) error {
+		res, err := tx.ExecContext(ctx, `
+			UPDATE qa_share_links SET revoked_at = now()
+			WHERE id = $1 AND plan_id = $2 AND revoked_at IS NULL`, id, planID)
+		if err != nil {
+			return err
+		}
+		return checkRowsAffected(res)
+	})
+}
+
+// QAPlanScenarioProgress is, for each scenario of planID, the latest status
+// (highest cycle) of each of its cases that the plan's runs hold.
+func QAPlanScenarioProgress(ctx context.Context, s tenant.Scope, planID uuid.UUID) (map[uuid.UUID]QAProgress, error) {
+	var rows []struct {
+		ScenarioID uuid.UUID `db:"scenario_id"`
+		Status     string    `db:"status"`
+		N          int       `db:"n"`
+	}
+	err := s.Tx(ctx, func(tx *sqlx.Tx) error {
+		return tx.SelectContext(ctx, &rows, `
+			SELECT si.scenario_id, latest.status, count(*) AS n
+			FROM (
+				SELECT DISTINCT ON (i.case_id) i.case_id, i.status
+				FROM qa_run_items i JOIN qa_runs r ON r.id = i.run_id
+				WHERE r.plan_id = $1
+				ORDER BY i.case_id, r.cycle DESC
+			) latest
+			JOIN qa_scenario_items si ON si.case_id = latest.case_id
+			JOIN qa_plan_scenarios ps ON ps.scenario_id = si.scenario_id AND ps.plan_id = $1
+			GROUP BY si.scenario_id, latest.status`, planID)
+	})
+	out := map[uuid.UUID]QAProgress{}
+	for _, r := range rows {
+		p := out[r.ScenarioID]
+		p.add(r.Status, r.N)
+		out[r.ScenarioID] = p
+	}
+	return out, err
+}
