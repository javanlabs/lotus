+package repo_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/uyab/lotus/internal/repo"
+)
+
+func TestQAShareLinks_ActiveUntilRevokedOrExpired(t *testing.T) {
+	f := newRunFixture(t, "acme-share")
+	ctx := context.Background()
+	link, err := repo.CreateQAShareLink(ctx, f.s, f.plan.ID, "hash-a", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if d := time.Until(link.ExpiresAt); d < 29*24*time.Hour || d > 31*24*time.Hour {
+		t.Fatalf("expires in %v; want 30 days", d)
+	}
+	if got, err := repo.QAShareLinkByHash(ctx, f.s, "hash-a"); err != nil || got.PlanID != f.plan.ID {
+		t.Fatalf("by hash = %+v, %v", got, err)
+	}
+	expired, _ := repo.CreateQAShareLink(ctx, f.s, f.plan.ID, "hash-b", nil)
+	if err := f.s.Tx(ctx, func(tx *sqlx.Tx) error {
+		_, err := tx.Exec(`UPDATE qa_share_links SET expires_at = now() - interval '1 minute' WHERE id = $1`, expired.ID)
+		return err
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := repo.QAShareLinkByHash(ctx, f.s, "hash-b"); err != repo.ErrNotFound {
+		t.Errorf("expired: %v; want ErrNotFound", err)
+	}
+	if err := repo.RevokeQAShareLink(ctx, f.s, f.plan.ID, link.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := repo.QAShareLinkByHash(ctx, f.s, "hash-a"); err != repo.ErrNotFound {
+		t.Errorf("revoked: %v; want ErrNotFound", err)
+	}
+	if err := repo.RevokeQAShareLink(ctx, f.s, f.plan.ID, link.ID); err != repo.ErrNotFound {
+		t.Errorf("revoke twice: %v; want ErrNotFound", err)
+	}
+	other, _ := repo.CreateQAPlan(ctx, f.s, f.projectID, repo.QAPlanInput{Name: "Other", Phase: "uat"}, nil)
+	third, _ := repo.CreateQAShareLink(ctx, f.s, f.plan.ID, "hash-c", nil)
+	if err := repo.RevokeQAShareLink(ctx, f.s, other.ID, third.ID); err != repo.ErrNotFound {
+		t.Errorf("revoke through another plan: %v; want ErrNotFound", err)
+	}
+	active, _ := repo.ListQAShareLinks(ctx, f.s, f.plan.ID)
+	if len(active) != 1 || active[0].ID != third.ID {
+		t.Fatalf("active = %+v; want only the third link", active)
+	}
+}
+
+func TestQAPlanScenarioProgress_LatestStatusPerCase(t *testing.T) {
+	f := newRunFixture(t, "acme-scenario-progress")
+	ctx := context.Background()
+	run, err := repo.CreateQARun(ctx, f.s, f.plan.ID, repo.QARunInput{Name: "Cycle 1", Distribution: repo.DistributeNone}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	items, _ := repo.ListQARunItems(ctx, f.s, run.ID, repo.QAItemFilter{})
+	for _, it := range items {
+		status := map[string]string{"Login": "failed", "Create RFS": "passed"}[it.Title]
+		if status == "" {
+			continue
+		}
+		if _, err := repo.RecordQAResult(ctx, f.s, repo.QAResultInput{ItemID: it.ID, Status: status}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	got, err := repo.QAPlanScenarioProgress(ctx, f.s, f.plan.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if p := got[f.uat.ID]; p.Total != 2 || p.Failed != 1 || p.Passed != 1 {
+		t.Errorf("UAT RFS = %+v; want 2 cases, 1 failed, 1 passed", p)
+	}
+	if p := got[f.reg.ID]; p.Total != 2 || p.Failed != 1 || p.Untested != 1 {
+		t.Errorf("Regression core = %+v; want 2 cases, 1 failed, 1 untested", p)
+	}
+}
diff --git a/internal/repo/qa_signoffs.go b/internal/repo/qa_signoffs.go
new file mode 100644
index 0000000..5e00c12
--- /dev/null
+++ b/internal/repo/qa_signoffs.go
@@ -0,0 +1,99 @@
+package repo
+
+import (
+	"context"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/google/uuid"
+	"github.com/jmoiron/sqlx"
+
+	"github.com/uyab/lotus/internal/tenant"
+)
+
+// A sign-off is a client's (or an admin's) verdict on a plan, for the whole
+// plan or for one of its scenarios. Sign-offs are never edited: a new one
+// supersedes the last for the same scope, and the history stays.
+
+// QASignoffDecisions in the order the form offers them.
+var QASignoffDecisions = []string{"accepted", "accepted_with_notes", "rejected"}
+
+// MaxQASignoffNote bounds a sign-off note, in runes.
+const MaxQASignoffNote = 4000
+
+type QASignoff struct {
+	ID         uuid.UUID  `db:"id"`
+	PlanID     uuid.UUID  `db:"plan_id"`
+	ScenarioID *uuid.UUID `db:"scenario_id"` // nil: the whole plan
+	Decision   string     `db:"decision"`
+	Note       string     `db:"note"`
+	SignedBy   *uuid.UUID `db:"signed_by"`
+	SignedAt   time.Time  `db:"signed_at"`
+}
+
+const qaSignoffCols = `id, plan_id, scenario_id, decision, note, signed_by, signed_at`
+
+type QASignoffInput struct {
+	ScenarioID *uuid.UUID
+	Decision   string
+	Note       string
+}
+
+func (in QASignoffInput) normalized() (QASignoffInput, error) {
+	in.Note = strings.TrimSpace(in.Note)
+	valid := false
+	for _, d := range QASignoffDecisions {
+		valid = valid || d == in.Decision
+	}
+	switch {
+	case !valid, utf8.RuneCountInString(in.Note) > MaxQASignoffNote:
+		return in, ErrInvalidInput
+	case in.Decision != "accepted" && in.Note == "":
+		// Anything short of a plain accept has to say what is wrong.
+		return in, ErrInvalidInput
+	}
+	return in, nil
+}
+
+// RecordQASignoff signs off planID, or one of its scenarios.
+func RecordQASignoff(ctx context.Context, s tenant.Scope, planID uuid.UUID, in QASignoffInput, by *uuid.UUID) (*QASignoff, error) {
+	in, err := in.normalized()
+	if err != nil {
+		return nil, err
+	}
+	var out QASignoff
+	err = s.Tx(ctx, func(tx *sqlx.Tx) error {
+		if in.ScenarioID != nil {
+			var n int
+			if err := tx.GetContext(ctx, &n, `
+				SELECT count(*) FROM qa_plan_scenarios WHERE plan_id = $1 AND scenario_id = $2`, planID, *in.ScenarioID); err != nil {
+				return err
+			}
+			if n == 0 {
+				return ErrInvalidInput
+			}
+		}
+		return tx.GetContext(ctx, &out, `
+			INSERT INTO qa_signoffs (org_id, plan_id, scenario_id, decision, note, signed_by)
+			VALUES ($1, $2, $3, $4, $5, $6) RETURNING `+qaSignoffCols,
+			s.OrgID(), planID, in.ScenarioID, in.Decision, in.Note, by)
+	})
+	if err != nil {
+		return nil, qaWriteErr(err)
+	}
+	return &out, nil
+}
+
+// ListLatestQASignoffs is the standing sign-off per scope of planID: the
+// whole plan first, then each signed scenario.
+func ListLatestQASignoffs(ctx context.Context, s tenant.Scope, planID uuid.UUID) ([]QASignoff, error) {
+	var out []QASignoff
+	err := s.Tx(ctx, func(tx *sqlx.Tx) error {
+		return tx.SelectContext(ctx, &out, `
+			SELECT DISTINCT ON (scenario_id) `+qaSignoffCols+` FROM qa_signoffs
+			WHERE plan_id = $1
+			ORDER BY scenario_id NULLS FIRST, signed_at DESC, id DESC`, planID)
+	})
+	return out, err
+}
