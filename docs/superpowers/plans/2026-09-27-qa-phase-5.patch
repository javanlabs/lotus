@@ -0,0 +1,144 @@
+package web
+
+import (
+	"context"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/repo"
+)
+
+func planNamed(t *testing.T, e qaEnv, projectID uuid.UUID, name string) repo.QAPlan {
+	t.Helper()
+	plans, _ := repo.ListQAPlans(context.Background(), e.s, projectID)
+	for _, p := range plans {
+		if p.Name == name {
+			return p
+		}
+	}
+	t.Fatalf("no plan %q in %+v", name, plans)
+	return repo.QAPlan{}
+}
+
+func TestQAPlans_CreateListFilterAndPage(t *testing.T) {
+	e := newQAEnv(t, "acme-qaplans")
+	ctx := context.Background()
+	member, _ := e.session(t, "qa@acme.example", "member")
+	p := e.project(t, "Portal")
+	seedQALibrary(t, e, p) // "Regression core" scenario, plan "Regression October" with one run
+	uat, _ := repo.CreateQAScenario(ctx, e.s, p, "UAT <b>RFS</b>", "uat", "", nil)
+	reg := planNamed(t, e, p, "Regression October")
+	scs, _ := repo.ListQAPlanScenarioIDs(ctx, e.s, reg.ID)
+	base := "/projects/" + p.String() + "/qa/plans"
+
+	form := url.Values{"name": {"UAT September"}, "phase": {"uat"}, "environment": {"UAT (linknet-uati)"}, "build": {"1.4.2"},
+		"starts_on": {"2026-09-01"}, "ends_on": {"2026-09-14"}, "scenario_id": {uat.ID.String(), scs[0].String()}}
+	resp, _ := e.post(t, member, base, form, true)
+	plan := planNamed(t, e, p, "UAT September")
+	if resp.StatusCode != http.StatusNoContent || resp.Header.Get("HX-Redirect") != base+"/"+plan.ID.String() {
+		t.Fatalf("create = %d %q", resp.StatusCode, resp.Header.Get("HX-Redirect"))
+	}
+	if ids, _ := repo.ListQAPlanScenarioIDs(ctx, e.s, plan.ID); len(ids) != 2 || plan.StartsOn == nil || plan.StartsOn.Format("2006-01-02") != "2026-09-01" {
+		t.Fatalf("plan = %+v, scenarios %v", plan, ids)
+	}
+
+	status, body := e.get(t, member, base)
+	if status != http.StatusOK || !strings.Contains(body, "UAT September") || !strings.Contains(body, "Regression October") {
+		t.Fatalf("list = %d", status)
+	}
+	_, body = e.get(t, member, base+"?phase=uat")
+	if !strings.Contains(body, "UAT September") || strings.Contains(body, "Regression October") {
+		t.Fatal("phase filter does not filter")
+	}
+
+	status, body = e.get(t, member, base+"/"+plan.ID.String())
+	if status != http.StatusOK || !strings.Contains(body, "UAT &lt;b&gt;RFS&lt;/b&gt;") || strings.Contains(body, "<b>RFS</b>") ||
+		!strings.Contains(body, "UAT (linknet-uati)") || !strings.Contains(body, "01 Sep – 14 Sep 2026") {
+		t.Fatalf("plan page = %d:\n%s", status, body)
+	}
+	// The existing plan's run is listed with its cycle.
+	_, body = e.get(t, member, base+"/"+reg.ID.String())
+	if !strings.Contains(body, "Cycle 1") || !strings.Contains(body, `data-run-cycle="1"`) {
+		t.Fatalf("runs by cycle missing:\n%s", body)
+	}
+}
+
+func TestQAPlans_EditValidatesDatesAndScenarios(t *testing.T) {
+	e := newQAEnv(t, "acme-qaplans-edit")
+	ctx := context.Background()
+	p := e.project(t, "Portal")
+	other := e.project(t, "Billing")
+	foreign, _ := repo.CreateQAScenario(ctx, e.s, other, "Billing SIT", "sit", "", nil)
+	plan, _ := repo.CreateQAPlan(ctx, e.s, p, repo.QAPlanInput{Name: "SIT", Phase: "sit"}, nil)
+	path := "/projects/" + p.String() + "/qa/plans/" + plan.ID.String()
+
+	_, body := e.post(t, e.owner, path, url.Values{"name": {"SIT"}, "phase": {"sit"}, "starts_on": {"2026-09-14"}, "ends_on": {"2026-09-01"}}, true)
+	if !strings.Contains(body, "The end date is before the start date.") {
+		t.Fatalf("reversed window: %s", body)
+	}
+	_, body = e.post(t, e.owner, path, url.Values{"name": {"SIT"}, "phase": {"sit"}, "starts_on": {"14/09/2026"}}, true)
+	if !strings.Contains(body, "Dates are written as YYYY-MM-DD.") {
+		t.Fatalf("bad date: %s", body)
+	}
+	if resp, _ := e.post(t, e.owner, path, url.Values{"name": {"SIT"}, "phase": {"sit"}, "scenario_id": {foreign.ID.String()}}, false); resp.StatusCode != http.StatusNotFound {
+		t.Fatalf("scenario of another project = %d; want 404", resp.StatusCode)
+	}
+	resp, _ := e.post(t, e.owner, path, url.Values{"name": {"SIT round 2"}, "phase": {"sit"}, "build": {"2.0"}}, true)
+	got, _ := repo.GetQAPlan(ctx, e.s, plan.ID)
+	if resp.StatusCode != http.StatusNoContent || got.Name != "SIT round 2" || got.Build != "2.0" {
+		t.Fatalf("edit = %d, %+v", resp.StatusCode, got)
+	}
+}
+
+func TestQAPlans_DuplicateCopiesScopeNotDatesAndCloseIsFinal(t *testing.T) {
+	e := newQAEnv(t, "acme-qaplans-dup")
+	ctx := context.Background()
+	viewer, _ := e.session(t, "viewer@acme.example", "viewer")
+	p := e.project(t, "Portal")
+	seedQALibrary(t, e, p)
+	reg := planNamed(t, e, p, "Regression October")
+	start := reg.CreatedAt
+	repo.UpdateQAPlan(ctx, e.s, reg.ID, repo.QAPlanInput{Name: reg.Name, Phase: "regression", Environment: "Staging", Build: "1.3",
+		StartsOn: &start, EndsOn: &start, ScenarioIDs: mustPlanScenarios(t, e, reg.ID)})
+	base := "/projects/" + p.String() + "/qa/plans"
+
+	resp, _ := e.post(t, e.owner, base+"/"+reg.ID.String()+"/duplicate", url.Values{"name": {"Regression November"}}, true)
+	dup := planNamed(t, e, p, "Regression November")
+	if resp.Header.Get("HX-Redirect") != base+"/"+dup.ID.String() || dup.Environment != "Staging" || dup.Build != "1.3" ||
+		dup.StartsOn != nil || dup.EndsOn != nil || len(mustPlanScenarios(t, e, dup.ID)) != 1 {
+		t.Fatalf("duplicate = %q, %+v", resp.Header.Get("HX-Redirect"), dup)
+	}
+
+	if resp, _ := e.post(t, viewer, base+"/"+dup.ID.String()+"/close", nil, false); resp.StatusCode != http.StatusForbidden {
+		t.Fatalf("viewer close = %d; want 403", resp.StatusCode)
+	}
+	e.post(t, e.owner, base+"/"+dup.ID.String()+"/close", nil, false)
+	e.post(t, e.owner, base+"/"+dup.ID.String()+"/close", nil, false)
+	if n := auditCount(t, e.db, e.orgID, "qa.plan.close"); n != 1 {
+		t.Fatalf("qa.plan.close audit rows = %d; want 1", n)
+	}
+	_, body := e.post(t, e.owner, base+"/"+dup.ID.String(), url.Values{"name": {"Reopened?"}, "phase": {"regression"}}, true)
+	if !strings.Contains(body, "This plan is closed.") {
+		t.Fatalf("edit of a closed plan: %s", body)
+	}
+	_, body = e.get(t, e.owner, base)
+	if strings.Index(body, "Regression October") > strings.Index(body, "Regression November") {
+		t.Fatal("open plans are not listed before closed ones")
+	}
+	if _, body = e.get(t, e.owner, base+"/"+dup.ID.String()); strings.Contains(body, "Edit plan…") || !strings.Contains(body, "closed") {
+		t.Fatal("closed plan still offers editing")
+	}
+}
+
+func mustPlanScenarios(t *testing.T, e qaEnv, planID uuid.UUID) []uuid.UUID {
+	t.Helper()
+	ids, err := repo.ListQAPlanScenarioIDs(context.Background(), e.s, planID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ids
+}
diff --git a/internal/web/qa_run.go b/internal/web/qa_run.go
new file mode 100644
index 0000000..31702b1
--- /dev/null
+++ b/internal/web/qa_run.go
@@ -0,0 +1,502 @@
+package web
+
+import (
+	"database/sql"
+	"errors"
+	"fmt"
+	"mime"
+	"mime/multipart"
+	"sort"
+	"strings"
+
+	"github.com/gofiber/fiber/v2"
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/blob"
+	"github.com/uyab/lotus/internal/httpx"
+	"github.com/uyab/lotus/internal/repo"
+	"github.com/uyab/lotus/internal/repo/global"
+	"github.com/uyab/lotus/internal/tenant"
+)
+
+// The run page lists a run's items compactly, grouped; an item's details
+// (precondition, steps, history, the result form) load into its panel when
+// it is opened, so the page never reads every item's history up front.
+// Recording a result answers with the refreshed panel plus out-of-band
+// swaps of the row's status and the progress header, so a tester moves on
+// to the next item without a reload.
+
+// qaStatusTone maps an item or result status to a badge tone.
+func qaStatusTone(status string) string {
+	switch status {
+	case "passed":
+		return "pass"
+	case "failed", "blocked":
+		return "fail"
+	}
+	return "none"
+}
+
+// qaPeopleLabels names every active member of the organization (any
+// role), for assignees and executors. Someone who has left shows as "—".
+func qaPeopleLabels(c *fiber.Ctx, d Deps, s tenant.Scope) (map[uuid.UUID]string, error) {
+	members, err := global.ListMembersForOrg(c.Context(), d.DB, s.OrgID())
+	if err != nil {
+		return nil, err
+	}
+	out := make(map[uuid.UUID]string, len(members))
+	for _, m := range members {
+		label := m.Name
+		if strings.TrimSpace(label) == "" {
+			label = m.Email
+		}
+		out[m.UserID] = label
+	}
+	return out, nil
+}
+
+func personLabel(labels map[uuid.UUID]string, id *uuid.UUID) string {
+	if id == nil {
+		return ""
+	}
+	if l, ok := labels[*id]; ok {
+		return l
+	}
+	return "—"
+}
+
+// loadQARun reads :rid, which must be a run of the project in the URL.
+func loadQARun(c *fiber.Ctx, s tenant.Scope, project *repo.Project) (*repo.QARun, error) {
+	id, err := qaOwned(c, s, project, repo.QAKindRun, c.Params("rid"))
+	if err != nil {
+		return nil, err
+	}
+	return repo.GetQARun(c.Context(), s, id)
+}
+
+// loadQAItem reads :iid, which must be an item of run.
+func loadQAItem(c *fiber.Ctx, s tenant.Scope, run *repo.QARun) (*repo.QARunItem, error) {
+	id, err := uuid.Parse(c.Params("iid"))
+	if err != nil {
+		return nil, fiber.ErrNotFound
+	}
+	item, err := repo.GetQARunItem(c.Context(), s, id)
+	if errors.Is(err, repo.ErrNotFound) || (err == nil && item.RunID != run.ID) {
+		return nil, fiber.ErrNotFound
+	}
+	return item, err
+}
+
+// qaCollapseAbove: a run or scenario holding more items than this opens
+// with its groups closed. Production runs reach about 1,100 items (13 are
+// over 500); groups closed turn such a page into a list of groups with
+// their progress, and the tester opens the one they work on.
+const qaCollapseAbove = 200
+
+func runURL(project *repo.Project, run *repo.QARun) string {
+	return qaBase(project) + "/runs/" + run.ID.String()
+}
+
+type qaItemRow struct {
+	repo.QARunItem
+	Key      int
+	Changed  bool // the live case is newer than the copy this run holds
+	Tone     string
+	Assignee string
+	Panel    string // where the item panel loads from
+}
+
+type qaItemGroup struct {
+	Name     string
+	Items    []qaItemRow
+	Progress repo.QAProgress
+}
+
+type qaTesterProgress struct {
+	Label    string
+	Progress repo.QAProgress
+}
+
+type qaRunProgressData struct {
+	Total   repo.QAProgress
+	Testers []qaTesterProgress
+	OOB     bool
+}
+
+type qaRunData struct {
+	Project    repo.Project
+	Base       string
+	Run        repo.QARun
+	Plan       repo.QAPlan
+	PhaseLabel string
+	Progress   qaRunProgressData
+	Groups     []qaItemGroup
+	Shown      int
+	Who        string // "", "mine", "unassigned"
+	Status     string
+	Group      string
+	GroupNames []string
+	CanExecute bool
+	URL        string
+	Collapsed  bool // groups start closed: a large run seen unfiltered
+
+	// Managing the run (qa.plan.write): assignment, retest, close.
+	CanManage  bool
+	People     []httpx.SelectOption
+	RetestOf   string
+	RetestHref string
+
+	// Save as scenario (qa.case.write).
+	CanSaveScenario bool
+	PhaseOptions    []httpx.SelectOption
+}
+
+// runProgress is the header: overall, then each assignee (unassigned last).
+func runProgress(c *fiber.Ctx, s tenant.Scope, run *repo.QARun, labels map[uuid.UUID]string) (qaRunProgressData, error) {
+	total, per, err := repo.QARunProgress(c.Context(), s, run.ID)
+	if err != nil {
+		return qaRunProgressData{}, err
+	}
+	out := qaRunProgressData{Total: total}
+	for id, p := range per {
+		if id == uuid.Nil {
+			continue
+		}
+		out.Testers = append(out.Testers, qaTesterProgress{Label: personLabel(labels, &id), Progress: p})
+	}
+	sort.Slice(out.Testers, func(i, j int) bool {
+		return strings.ToLower(out.Testers[i].Label) < strings.ToLower(out.Testers[j].Label)
+	})
+	if p, ok := per[uuid.Nil]; ok {
+		out.Testers = append(out.Testers, qaTesterProgress{Label: "Unassigned", Progress: p})
+	}
+	return out, nil
+}
+
+func qaRunPage(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		run, err := loadQARun(c, s, project)
+		if err != nil {
+			return err
+		}
+		plan, err := repo.GetQAPlan(c.Context(), s, run.PlanID)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		labels, err := qaPeopleLabels(c, d, s)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		me := mustPrincipal(c).UserID
+		data := qaRunData{Project: *project, Base: qaBase(project), Run: *run, Plan: *plan, PhaseLabel: qaPhaseLabels[plan.Phase],
+			Who: c.Query("who"), Status: c.Query("status"), Group: c.Query("group"),
+			CanExecute: mustPrincipal(c).Can("qa.execute") && run.ClosedAt == nil, URL: runURL(project, run)}
+		if data.Progress, err = runProgress(c, s, run, labels); err != nil {
+			return writeRepoErr(c, err)
+		}
+		if run.RetestOf != nil {
+			if orig, err := repo.GetQARun(c.Context(), s, *run.RetestOf); err == nil {
+				data.RetestOf, data.RetestHref = orig.Name, runURL(project, orig)
+			}
+		}
+		if mustPrincipal(c).Can("qa.case.write") {
+			data.CanSaveScenario, data.PhaseOptions = true, qaPhaseOptions()
+		}
+		if mustPrincipal(c).Can("qa.plan.write") {
+			data.CanManage = true
+			people, err := qaPeople(c, d, s, project)
+			if err != nil {
+				return writeRepoErr(c, err)
+			}
+			data.People = []httpx.SelectOption{{Value: "", Label: "Nobody"}}
+			for _, p := range people {
+				data.People = append(data.People, httpx.SelectOption{Value: p.ID.String(), Label: p.Label})
+			}
+		}
+		items, err := repo.ListQARunItems(c.Context(), s, run.ID, repo.QAItemFilter{})
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		caseIDs := make([]uuid.UUID, len(items))
+		for i, it := range items {
+			caseIDs[i] = it.CaseID
+		}
+		refs, err := repo.QACaseRefs(c.Context(), s, caseIDs)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		index := map[string]int{}
+		for _, it := range items {
+			g, ok := index[it.GroupName]
+			if !ok {
+				g = len(data.Groups)
+				index[it.GroupName] = g
+				data.Groups = append(data.Groups, qaItemGroup{Name: it.GroupName})
+				data.GroupNames = append(data.GroupNames, it.GroupName)
+			}
+			data.Groups[g].Progress.Count(it.Status)
+			switch {
+			case data.Who == "mine" && (it.AssigneeID == nil || *it.AssigneeID != me),
+				data.Who == "unassigned" && it.AssigneeID != nil,
+				data.Status != "" && it.Status != data.Status,
+				data.Group != "" && it.GroupName != data.Group:
+				continue
+			}
+			ref := refs[it.CaseID]
+			data.Groups[g].Items = append(data.Groups[g].Items, qaItemRow{
+				QARunItem: it, Key: ref.Key, Changed: ref.Version > it.CaseVersion, Tone: qaStatusTone(it.Status),
+				Assignee: personLabel(labels, it.AssigneeID), Panel: data.URL + "/items/" + it.ID.String(),
+			})
+			data.Shown++
+		}
+		data.Collapsed = len(items) > qaCollapseAbove && data.Who == "" && data.Status == "" && data.Group == ""
+		org, user, err := shellChrome(c, d.DB)
+		if err != nil {
+			return err
+		}
+		nav, err := qaNav(c, s, project, httpx.NavCrumb{Label: "Plans", Href: data.Base + "/plans"},
+			httpx.NavCrumb{Label: plan.Name, Href: planURL(project, plan)}, httpx.NavCrumb{Label: run.Name})
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		c.Type("html")
+		return renderPage(c, d, "pages/qa_run.html", httpx.ViewData{
+			Title: run.Name + " · " + plan.Name, Org: org, User: user, Nav: nav, Data: data,
+		})
+	}
+}
+
+type qaHistoryEntry struct {
+	repo.QAResult
+	Tone  string
+	By    string
+	Files []qaFileLink
+}
+
+type qaFileLink struct {
+	Name string
+	Href string
+	Size string
+}
+
+func humanSize(n int64) string {
+	switch {
+	case n >= 1<<20:
+		return fmt.Sprintf("%.1f MB", float64(n)/(1<<20))
+	case n >= 1<<10:
+		return fmt.Sprintf("%d KB", n>>10)
+	}
+	return fmt.Sprintf("%d B", n)
+}
+
+type qaItemPanelData struct {
+	Item       qaItemRow
+	Action     string
+	History    []qaHistoryEntry
+	CanExecute bool
+	Error      string
+	Progress   qaRunProgressData
+	OOB        bool // also refresh the row status and the progress header
+}
+
+func itemPanel(c *fiber.Ctx, d Deps, s tenant.Scope, project *repo.Project, run *repo.QARun, item *repo.QARunItem) (qaItemPanelData, error) {
+	labels, err := qaPeopleLabels(c, d, s)
+	if err != nil {
+		return qaItemPanelData{}, err
+	}
+	refs, err := repo.QACaseRefs(c.Context(), s, []uuid.UUID{item.CaseID})
+	if err != nil {
+		return qaItemPanelData{}, err
+	}
+	ref := refs[item.CaseID]
+	url := runURL(project, run) + "/items/" + item.ID.String()
+	data := qaItemPanelData{
+		Item: qaItemRow{QARunItem: *item, Key: ref.Key, Changed: ref.Version > item.CaseVersion, Tone: qaStatusTone(item.Status),
+			Assignee: personLabel(labels, item.AssigneeID), Panel: url},
+		Action: url + "/result", CanExecute: mustPrincipal(c).Can("qa.execute") && run.ClosedAt == nil,
+	}
+	results, err := repo.ListQAResults(c.Context(), s, item.ID)
+	if err != nil {
+		return data, err
+	}
+	for _, r := range results {
+		id := r.ID
+		files, err := repo.ListQAAttachments(c.Context(), s, repo.QAAttachmentOwner{ResultID: &id})
+		if err != nil {
+			return data, err
+		}
+		entry := qaHistoryEntry{QAResult: r, Tone: qaStatusTone(r.Status), By: personLabel(labels, r.CreatedBy)}
+		for _, f := range files {
+			entry.Files = append(entry.Files, qaFileLink{Name: f.FileName, Href: qaBase(project) + "/files/" + f.ID.String(), Size: humanSize(f.SizeBytes)})
+		}
+		data.History = append(data.History, entry)
+	}
+	if data.Progress, err = runProgress(c, s, run, labels); err != nil {
+		return data, err
+	}
+	data.Progress.OOB = true
+	return data, nil
+}
+
+func qaItemPanelUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		run, err := loadQARun(c, s, project)
+		if err != nil {
+			return err
+		}
+		item, err := loadQAItem(c, s, run)
+		if err != nil {
+			return err
+		}
+		data, err := itemPanel(c, d, s, project, run, item)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		c.Type("html")
+		return d.Renderer.RenderNamed(c, "qa_item_panel", data)
+	}
+}
+
+var qaResultChoices = map[string]bool{"passed": true, "failed": true, "blocked": true, "skipped": true}
+
+// recordQAResultUI records one result (and its files) for an item. Every
+// file is checked against the size limit before anything is written, so a
+// refused upload leaves no result behind.
+func recordQAResultUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		run, err := loadQARun(c, s, project)
+		if err != nil {
+			return err
+		}
+		item, err := loadQAItem(c, s, run)
+		if err != nil {
+			return err
+		}
+		refuse := func(status int, msg string) error {
+			if c.Get("HX-Request") == "" {
+				return fiber.NewError(status, msg)
+			}
+			data, err := itemPanel(c, d, s, project, run, item)
+			if err != nil {
+				return writeRepoErr(c, err)
+			}
+			data.Error = msg
+			c.Type("html")
+			return d.Renderer.RenderNamed(c, "qa_item_panel", data)
+		}
+		status := strings.TrimSpace(c.FormValue("status"))
+		if !qaResultChoices[status] {
+			return refuse(fiber.StatusUnprocessableEntity, "Choose a result: passed, failed, blocked or skipped.")
+		}
+		var files []*multipart.FileHeader
+		if form, err := c.MultipartForm(); err == nil {
+			files = form.File["file"]
+		}
+		for _, f := range files {
+			if f.Size > repo.MaxQAAttachmentBytes {
+				return refuse(fiber.StatusUnprocessableEntity, "Each file can be at most 20 MB.")
+			}
+		}
+		result, err := repo.RecordQAResult(c.Context(), s, repo.QAResultInput{
+			ItemID: item.ID, Status: status, Comment: c.FormValue("comment"), CreatedBy: qaActor(c),
+		})
+		if errors.Is(err, repo.ErrQAClosed) {
+			return refuse(fiber.StatusConflict, "This run is closed.")
+		}
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		for _, fh := range files {
+			f, err := fh.Open()
+			if err != nil {
+				return err
+			}
+			// A browser that does not know the type says octet-stream; let
+			// SaveQAAttachment sniff it instead, so a screenshot shows inline.
+			ctype := fh.Header.Get("Content-Type")
+			if ctype == "application/octet-stream" {
+				ctype = ""
+			}
+			_, err = repo.SaveQAAttachment(c.Context(), s, d.Blob, repo.QAAttachmentOwner{ResultID: &result.ID},
+				fh.Filename, ctype, f, qaActor(c))
+			f.Close()
+			if errors.Is(err, repo.ErrQAAttachmentTooLarge) {
+				return refuse(fiber.StatusUnprocessableEntity, "Each file can be at most 20 MB.")
+			}
+			if err != nil {
+				return err
+			}
+		}
+		if c.Get("HX-Request") == "" {
+			return c.Redirect(runURL(project, run), fiber.StatusFound)
+		}
+		item, err = repo.GetQARunItem(c.Context(), s, item.ID)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		data, err := itemPanel(c, d, s, project, run, item)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		data.OOB = true
+		c.Type("html")
+		return d.Renderer.RenderNamed(c, "qa_item_panel", data)
+	}
+}
+
+// qaFileUI serves an attachment of the project in the URL. Images other
+// than SVG are shown inline; everything else downloads, typed as bytes,
+// with nosniff and a sandbox, so an uploaded HTML or SVG file never runs
+// in the app's origin.
+func qaFileUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		id, err := uuid.Parse(c.Params("aid"))
+		if err != nil {
+			return fiber.ErrNotFound
+		}
+		pid, err := repo.QAAttachmentProjectID(c.Context(), s, id)
+		if errors.Is(err, repo.ErrNotFound) || errors.Is(err, sql.ErrNoRows) || (err == nil && pid != project.ID) {
+			return fiber.ErrNotFound
+		}
+		if err != nil {
+			return err
+		}
+		a, err := repo.GetQAAttachment(c.Context(), s, id)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		rc, err := d.Blob.Open(c.Context(), a.StorageKey)
+		if errors.Is(err, blob.ErrNotFound) {
+			return fiber.ErrNotFound
+		}
+		if err != nil {
+			return err
+		}
+		inline := strings.HasPrefix(a.ContentType, "image/") && !strings.Contains(a.ContentType, "svg")
+		disposition, ctype := "attachment", "application/octet-stream"
+		if inline {
+			disposition, ctype = "inline", a.ContentType
+		}
+		c.Set(fiber.HeaderContentType, ctype)
+		c.Set(fiber.HeaderContentDisposition, mime.FormatMediaType(disposition, map[string]string{"filename": a.FileName}))
+		c.Set(fiber.HeaderXContentTypeOptions, "nosniff")
+		c.Set(fiber.HeaderContentSecurityPolicy, "sandbox")
+		return c.SendStream(rc, int(a.SizeBytes))
+	}
+}
diff --git a/internal/web/qa_run_manage.go b/internal/web/qa_run_manage.go
new file mode 100644
index 0000000..2b2858f
--- /dev/null
+++ b/internal/web/qa_run_manage.go
@@ -0,0 +1,139 @@
+package web
+
+import (
+	"encoding/json"
+	"errors"
+	"strconv"
+	"strings"
+
+	"github.com/gofiber/fiber/v2"
+	"github.com/google/uuid"
+
+	"github.com/uyab/lotus/internal/repo"
+)
+
+// Managing a run (qa.plan.write): assign items, start a retest, close it.
+
+// assignQAItemsUI gives every ticked item (item_id, repeated) to one
+// person, or to nobody. Ids of another run's items are skipped by the
+// repo; the person must be someone who can execute here.
+func assignQAItemsUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		run, err := loadQARun(c, s, project)
+		if err != nil {
+			return err
+		}
+		ids, err := formUUIDs(c, "item_id")
+		if err != nil {
+			return err
+		}
+		if len(ids) == 0 {
+			return qaFormError(c, d, fiber.StatusUnprocessableEntity, "Select at least one item.")
+		}
+		var assignee *uuid.UUID
+		if raw := strings.TrimSpace(c.FormValue("assignee_id")); raw != "" {
+			people, err := qaPeople(c, d, s, project)
+			if err != nil {
+				return writeRepoErr(c, err)
+			}
+			for _, p := range people {
+				if p.ID.String() == raw {
+					id := p.ID
+					assignee = &id
+				}
+			}
+			if assignee == nil {
+				return fiber.ErrNotFound
+			}
+		}
+		n, err := repo.AssignQARunItems(c.Context(), s, run.ID, ids, assignee)
+		if err != nil {
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "qa.items.assigned", strconv.Itoa(n))
+		return redirectAfterMutation(c, runURL(project, run))
+	}
+}
+
+// retestQARunUI starts the next cycle with the run's failed and blocked
+// items, each given to whoever ran it, and opens it.
+func retestQARunUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		run, err := loadQARun(c, s, project)
+		if err != nil {
+			return err
+		}
+		retest, err := repo.CreateQARetest(c.Context(), s, run.ID, qaActor(c))
+		switch {
+		case errors.Is(err, repo.ErrQAEmptyRun):
+			return qaFormError(c, d, fiber.StatusUnprocessableEntity, "Nothing failed or blocked to retest.")
+		case errors.Is(err, repo.ErrQAClosed):
+			return qaFormError(c, d, fiber.StatusConflict, "This plan is closed.")
+		case err != nil:
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "qa.run.created", retest.Name)
+		return redirectAfterCreate(c, qaBase(project)+"/runs/"+retest.ID.String())
+	}
+}
+
+func closeQARunUI() fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		run, err := loadQARun(c, s, project)
+		if err != nil {
+			return err
+		}
+		if run.ClosedAt != nil { // already closed: nothing to do, nothing to audit
+			return redirectAfterMutation(c, runURL(project, run))
+		}
+		if err := repo.CloseQARun(c.Context(), s, run.ID); err != nil {
+			return writeRepoErr(c, err)
+		}
+		raw, _ := json.Marshal(fiber.Map{"name": run.Name, "plan_id": run.PlanID, "project_id": project.ID})
+		if err := repo.RecordAuditEvent(c.Context(), s, qaActor(c), "qa.run.close", "qa_run", &run.ID, raw); err != nil {
+			return writeRepoErr(c, err)
+		}
+		setFlash(c, "qa.run.closed", run.Name)
+		return redirectAfterMutation(c, runURL(project, run))
+	}
+}
+
+// saveQARunAsScenarioUI keeps a run's case set for next time: a new
+// scenario with the run's cases, order and groups (qa.case.write).
+func saveQARunAsScenarioUI(d Deps) fiber.Handler {
+	return func(c *fiber.Ctx) error {
+		s, project, err := loadQAProject(c)
+		if err != nil {
+			return err
+		}
+		run, err := loadQARun(c, s, project)
+		if err != nil {
+			return err
+		}
+		name, phase, _, msg := readQAScenarioForm(c)
+		if msg != "" {
+			return qaFormError(c, d, fiber.StatusUnprocessableEntity, msg)
+		}
+		sc, err := repo.CreateQAScenarioFromRun(c.Context(), s, run.ID, name, phase, qaActor(c))
+		if err != nil {
+			if status, msg, ok := qaScenarioErr(err); ok {
+				return qaFormError(c, d, status, msg)
+			}
+			return err
+		}
+		setFlash(c, "qa.scenario.created", sc.Name)
+		return redirectAfterCreate(c, qaBase(project)+"/scenarios/"+sc.ID.String())
+	}
+}
