diff --git a/web/templates/pages/qa_my.html b/web/templates/pages/qa_my.html
new file mode 100644
index 0000000..845bced
--- /dev/null
+++ b/web/templates/pages/qa_my.html
@@ -0,0 +1,42 @@
+{{define "content"}}
+{{template "shell_open" .}}
+{{$d := .Data}}
+
+<header style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:16px;margin-bottom:18px">
+  <div style="flex:1;min-width:220px">
+    <h1 style="margin:0;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#43284E">My work</h1>
+    <p style="margin:4px 0 0;font-size:12.5px;color:#6B7280">{{$d.Total}} untested item{{if ne $d.Total 1}}s{{end}} assigned to you in open runs</p>
+  </div>
+  {{template "qa_home_nav" "my"}}
+</header>
+
+{{if not $d.Projects}}
+{{template "lotus_card_section_open" (dict "Padding" "40px 32px" "Style" "text-align:center;color:#6B7280;font-size:12.5px")}}
+  Nothing assigned to you is waiting.
+{{template "lotus_card_section_close" .}}
+{{else}}
+<div style="display:flex;flex-direction:column;gap:14px">
+{{range $d.Projects}}
+{{template "lotus_card_section_open" (dict "Padding" "4px" "Style" "overflow:hidden")}}
+  <div style="padding:10px 14px 4px"><a href="{{.Href}}" style="font-size:14px;font-weight:600;color:#43284E;text-decoration:none">{{.Name}}</a></div>
+  {{range .Plans}}
+  {{range $run := .Runs}}
+  <div class="lotus-table-head" style="display:flex;align-items:center;gap:10px">
+    <span style="flex:1">{{$run.Name}}</span>
+    <a href="{{$run.Href}}" style="font-size:11px;color:#43284E;text-transform:none;letter-spacing:0">Open run</a>
+  </div>
+  {{range $run.Items}}
+  <a href="{{$run.Href}}" data-my-item class="lotus-repo-row" style="display:grid;grid-template-columns:minmax(0,1fr) 200px;gap:10px;align-items:center;padding:0 14px;text-decoration:none;color:inherit">
+    <span style="font-size:12.5px;color:#111827;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{.Title}}</span>
+    <span style="font-size:11.5px;color:#6B7280;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{.PlanName}}{{if .GroupName}} · {{.GroupName}}{{end}}</span>
+  </a>
+  {{end}}
+  {{end}}
+  {{end}}
+{{template "lotus_card_section_close" .}}
+{{end}}
+</div>
+{{end}}
+
+{{template "shell_close" .}}
+{{end}}
diff --git a/web/templates/pages/qa_plan.html b/web/templates/pages/qa_plan.html
new file mode 100644
index 0000000..21d0452
--- /dev/null
+++ b/web/templates/pages/qa_plan.html
@@ -0,0 +1,97 @@
+{{define "content"}}
+{{template "shell_open" .}}
+{{$d := .Data}}
+
+<header style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:16px;margin-bottom:18px">
+  <div style="flex:1;min-width:220px">
+    <h1 style="margin:0;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#43284E">{{$d.Plan.Name}}</h1>
+    <p style="margin:4px 0 0;font-size:12.5px;color:#6B7280">{{$d.PhaseLabel}}{{if $d.Plan.Environment}} · {{$d.Plan.Environment}}{{end}}{{if $d.Plan.Build}} · <span style="font-family:'IBM Plex Mono',monospace">{{$d.Plan.Build}}</span>{{end}}{{if $d.Window}} · {{$d.Window}}{{end}}{{if $d.Plan.ClosedAt}} · closed {{$d.Plan.ClosedAt.Format "02 Jan 2006"}}{{end}}</p>
+  </div>
+  {{if $d.CanWrite}}
+  <a href="{{$d.Base}}/plans/{{$d.Plan.ID}}/runs/new" class="btn-lotus btn-lotus-primary">
+    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="color:var(--text-on-dark-accent)"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>New run
+  </a>
+  <div x-data="lotusModal('edit-plan')" style="display:contents">
+    <button type="button" class="btn-lotus btn-lotus-secondary" @click="open()">Edit plan…</button>
+    <dialog class="lotus-modal lotus-shape" x-ref="dialog" aria-labelledby="edit-plan-title">
+      <div class="lotus-modal-head">
+        <div class="lotus-modal-title" id="edit-plan-title">Edit plan</div>
+        <button type="button" class="lotus-modal-close" @click="close()" aria-label="Close">
+          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
+        </button>
+      </div>
+      {{template "qa_plan_form" $d.Form}}
+    </dialog>
+  </div>
+  {{end}}
+  {{if $d.CanCopy}}
+  <div x-data="lotusModal('duplicate-plan')" style="display:contents">
+    <button type="button" class="btn-lotus btn-lotus-secondary" @click="open()">Duplicate…</button>
+    <dialog class="lotus-modal lotus-shape" x-ref="dialog" aria-labelledby="duplicate-plan-title">
+      <div class="lotus-modal-head">
+        <div class="lotus-modal-title" id="duplicate-plan-title">Duplicate plan</div>
+        <button type="button" class="lotus-modal-close" @click="close()" aria-label="Close">
+          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
+        </button>
+      </div>
+      <div class="lotus-modal-form">
+        <form method="post" action="{{$d.Base}}/plans/{{$d.Plan.ID}}/duplicate" hx-post="{{$d.Base}}/plans/{{$d.Plan.ID}}/duplicate" hx-target="#duplicate-plan-error" hx-swap="innerHTML">
+          <div class="lotus-modal-body" style="display:flex;flex-direction:column;gap:14px">
+            <div id="duplicate-plan-error"></div>
+            <p style="margin:0;font-size:12px;color:#6B7280">Copies the phase, environment, build and scenarios. Dates and runs start empty.</p>
+            <label style="display:flex;flex-direction:column;gap:6px">
+              <span style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">NAME</span>
+              <input type="text" name="name" required maxlength="200" value="{{$d.CopyName}}" class="lotus-input">
+            </label>
+          </div>
+          <div class="lotus-modal-foot">
+            <button type="button" class="btn-lotus btn-lotus-secondary" onclick="this.closest('dialog').close()">Cancel</button>
+            <button type="submit" class="btn-lotus btn-lotus-primary">Duplicate</button>
+          </div>
+        </form>
+      </div>
+    </dialog>
+  </div>
+  {{end}}
+  {{if $d.CanWrite}}
+  <form method="post" action="{{$d.Base}}/plans/{{$d.Plan.ID}}/close">
+    <button type="submit" class="btn-lotus btn-lotus-secondary">Close plan</button>
+  </form>
+  {{end}}
+  {{template "qa_subnav" (dict "Base" $d.Base "Active" "plans")}}
+</header>
+
+<div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:14px;align-items:start">
+  {{template "lotus_card_section_open" (dict "Padding" "14px" "Style" "display:flex;flex-direction:column;gap:10px")}}
+    <div style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label)">PROGRESS</div>
+    {{template "qa_progress" $d.Progress}}
+    <div style="font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:var(--text-label);margin-top:6px">SCENARIOS</div>
+    {{range $d.Scenarios}}
+    <a href="{{.Href}}" style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:#111827;text-decoration:none{{if .ArchivedAt}};opacity:.6{{end}}">
+      <span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{.Name}}</span>
+      <span class="lotus-badge lotus-badge-none">{{.PhaseLabel}}</span>
+    </a>
+    {{else}}<p style="margin:0;font-size:12px;color:#6B7280">No scenarios. Edit the plan to choose some.</p>{{end}}
+  {{template "lotus_card_section_close" .}}
+
+  {{template "lotus_card_section_open" (dict "Padding" "4px" "Style" "overflow:hidden")}}
+    {{if not $d.Runs}}
+    <p style="margin:0;padding:28px 14px;text-align:center;font-size:12.5px;color:#6B7280">No runs yet.</p>
+    {{else}}
+    <div class="lotus-table-head" style="grid-template-columns:60px minmax(0,1fr) 170px;gap:10px"><div>CYCLE</div><div>RUN</div><div>PROGRESS</div></div>
+    {{range $d.Runs}}
+    <div class="lotus-repo-row lotus-repo-row-selectable" data-run-cycle="{{.Cycle}}" style="display:grid;grid-template-columns:60px minmax(0,1fr) 170px;gap:10px;align-items:center;padding:0 14px{{if .ClosedAt}};opacity:.7{{end}}">
+      <span style="font:500 11px 'IBM Plex Mono',monospace;color:#6B7280">{{.Cycle}}</span>
+      <span style="min-width:0;display:flex;flex-direction:column">
+        <a href="{{.Href}}" class="lotus-row-link" style="font-size:12.5px;font-weight:600;color:#111827;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{.Name}}{{if .ClosedAt}} <span class="lotus-badge lotus-badge-none">closed</span>{{end}}</a>
+        {{if .RetestOf}}<span style="font-size:11px;color:#6B7280">retest of {{.RetestOf}}</span>{{end}}
+      </span>
+      {{template "qa_progress" .Progress}}
+    </div>
+    {{end}}
+    {{end}}
+  {{template "lotus_card_section_close" .}}
+</div>
+
+{{template "shell_close" .}}
+{{end}}
