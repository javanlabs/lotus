+    {{if .Blocked}}<div class="lotus-bar-fail" style="flex:{{.Blocked}};opacity:.5"></div>{{end}}
+    {{if .Skipped}}<div class="lotus-bar-none" style="flex:{{.Skipped}}"></div>{{end}}
+    {{if .Untested}}<div style="flex:{{.Untested}}"></div>{{end}}
+  </div>
+  <div style="font:400 10.5px 'IBM Plex Mono',monospace;color:#6B7280;white-space:nowrap">{{.Done}}/{{.Total}} done{{if .Failed}} · <span style="color:var(--status-fail)">{{.Failed}} failed</span>{{end}}{{if .Blocked}} · {{.Blocked}} blocked{{end}}</div>
+</div>
+{{else}}
+<span style="font:400 10.5px 'IBM Plex Mono',monospace;color:#9CA3AF">—</span>
+{{end}}
+{{end}}
