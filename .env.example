# --- Server ---
ADDR=:8080
DATABASE_URL=postgres://postgres@localhost:5418/lotus?sslmode=disable
# Only needed if your local Postgres role differs between migrate and app
# connections; for local dev, leave unset (falls back to DATABASE_URL).
MIGRATE_DATABASE_URL=
# LOTUS_DEV=1 re-parses templates/static from disk on every request and
# enables the X-Lotus-Org dev header fallback (see README).
LOTUS_DEV=1
# Random secret for signing session cookies; generated at boot if empty
# (sessions reset on every restart).
SESSION_SECRET=
COOKIE_SECURE=0

# --- Multi-tenancy ---
# Wildcard root Lotus is served under. No production value chosen yet — see
# README "Status / open items". lotus.localhost resolves to loopback in
# Chrome/Firefox without any hosts-file entry, so *.lotus.localhost works
# out of the box for local dev.
LOTUS_BASE_DOMAIN=lotus.localhost

# --- OAuth (task 1.1) ---
# A provider with an empty *_CLIENT_SECRET is simply not registered, so
# login works with zero, one, or both configured. Redirect URI to register
# with each provider: <scheme>://auth.<LOTUS_BASE_DOMAIN>/login/<github|google>/callback
# (scheme is http in dev, https otherwise).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Generic OIDC / SSO (task 4.7) ---
# Any standards-compliant issuer; endpoints are discovered from
# <OIDC_ISSUER>/.well-known/openid-configuration, so only these three are
# ever needed. Registered as the "sso" provider, so the redirect URI to
# whitelist on the IdP client is
# <scheme>://auth.<LOTUS_BASE_DOMAIN>/login/sso/callback in saas mode, or
# <LOTUS_URL>/login/sso/callback in single mode.
# Javan's Keycloak: https://sso.javan.id/realms/internal
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Email (task 1.7) ---
# Sends invitation emails. With SMTP_HOST empty, no mail is sent —
# invitations still work via the copyable link. Locally, point at
# Mailpit/Sendria if you want to see the emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Lotus <no-reply@lotus.invalid>

# --- Not yet used in Fase 0 (reserved for later phases) ---
# Base64 key-encryption-key for envelope-encrypting integration credentials
# (task 2.2).
LOTUS_KEK=
# Sync worker pool size (task 3.2).
LOTUS_WORKER_COUNT=4
