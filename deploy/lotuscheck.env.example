# /etc/lotuscheck/lotuscheck.env — production runtime config.
#
# On the server this file is RENDERED BY THE DEPLOY JOB from GitLab CI/CD
# variables on every deploy, so GitLab is the single source of truth and
# nothing here is hand-edited. This file is the documented shape of it, and
# the checklist of what must exist in GitLab → Settings → CI/CD → Variables.
#
# Mode 0640, owned root:lotuscheck — it carries the KEK and the database
# password, and the app only ever needs to read it.

# --- Server ---
ADDR=127.0.0.1:8085
# Must be 0. config.Load only reads a .env file when LOTUS_DEV != 0, and a
# production server has no .env to read; more importantly LOTUS_DEV=1 would
# re-parse templates from disk (they are embedded here) and enable the
# X-Lotus-Org dev header, which lets any caller pick an organization.
LOTUS_DEV=0
COOKIE_SECURE=1

# --- Mode ---
# single = one organization on one origin. See deploy/README.md for what
# switching to saas requires (wildcard DNS + wildcard certificate).
LOTUS_MODE=single
LOTUS_URL=https://lotus.javan.id

# --- Database ---
# Two roles, two DSNs. The app connects as lotuscheck_app, which is a member
# of the NOLOGIN lotus_app role and therefore has DML but no DDL, and is not
# a superuser — that last part is what makes FORCE ROW LEVEL SECURITY
# actually bind, since RLS is bypassed unconditionally for superusers.
# Migrations connect as lotuscheck_migrate, which owns the schema.
DATABASE_URL=postgres://lotuscheck_app:CHANGEME@127.0.0.1:5432/lotuscheck?sslmode=disable
MIGRATE_DATABASE_URL=postgres://lotuscheck_migrate:CHANGEME@127.0.0.1:5432/lotuscheck?sslmode=disable

# --- Secrets ---
# openssl rand -hex 32 — stable, or every restart logs everyone out.
SESSION_SECRET=
# openssl rand -base64 32 — wraps every organization's DEK, which in turn
# seals every stored integration credential. LOSING OR CHANGING THIS MAKES
# EVERY STORED CREDENTIAL UNREADABLE. Rotate only via:
#   lotus rewrap-keys --old-kek=<previous base64>
LOTUS_KEK=

# --- OAuth (optional) ---
# A provider with an empty secret is simply not registered; with none set,
# login falls back to magic links. Redirect URI to register, single mode:
#   https://lotus.javan.id/login/<github|google>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SSO / generic OIDC (optional, task 4.7) ---
# Any compliant issuer; the endpoints come from
# <OIDC_ISSUER>/.well-known/openid-configuration. Registered as the "sso"
# provider, so the redirect URI to whitelist on the IdP client is
# <LOTUS_URL>/login/sso/callback. Setting OIDC_CLIENT_SECRET with no
# OIDC_ISSUER fails startup rather than leaving a button that only errors.
OIDC_ISSUER=https://sso.javan.id/realms/internal
OIDC_CLIENT_ID=lotus
OIDC_CLIENT_SECRET=
# 1 = treat the issuer's email addresses as verified even when its
# email_verified claim is false. Required for Javan's Keycloak, which
# provisions accounts by administrator and never marks addresses verified —
# without it the first Owner login is refused. Only safe for an IdP whose
# users cannot pick their own address.
OIDC_TRUST_EMAIL=1

# --- Email (optional) ---
# With SMTP_HOST empty no mail is sent and invitations still work by
# copyable link — but magic-link login becomes unusable for anyone who
# cannot read the server log, so set this before inviting real users.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Lotus <no-reply@javan.co.id>

# --- Workers ---
LOTUS_WORKER_COUNT=4

# --- Repository scans ---
# A component with GitLab and no container image is scanned daily by
# cloning its repository and running `trivy fs` (on by default; needs trivy
# and git on PATH, see bootstrap.sh). TRIVY_REPO_SCANS=0 stops Lotus adding
# new ones. TRIVY_CACHE_DIR is set by the systemd unit, not here.
# TRIVY_BIN=trivy
# TRIVY_REPO_SCANS=1

# --- Feature flags ---
# Off unless "1" or "true". QA Tools is hidden in production until this
# is set as a GitLab CI/CD variable and the app is redeployed.
LOTUS_FEATURE_QA=0

# Where QA attachments are stored. Must be on persistent disk and backed up.
LOTUS_BLOB_DIR=/var/lib/lotuscheck/blob
