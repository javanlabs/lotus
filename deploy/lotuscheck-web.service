[Unit]
Description=Lotus — engineering metrics dashboard
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=lotuscheck
Group=lotuscheck
WorkingDirectory=/opt/lotuscheck
# Rendered from GitLab CI/CD variables by the deploy job, never hand-edited.
# Mandatory (no leading '-'): a missing env file must fail the unit loudly
# rather than start Lotus on its dev defaults — which include a KEK that is
# published in this repository (internal/config.devOnlyKEK).
EnvironmentFile=/etc/lotuscheck/lotuscheck.env
ExecStart=/opt/lotuscheck/bin/lotus serve
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# Hardening. Templates and static assets are //go:embed'ed and records live
# in Postgres. The one writable path is the blob store for uploaded files
# (QA attachments): systemd creates /var/lib/lotuscheck owned by the
# service user and exempts it from ProtectSystem=strict. The rendered env
# points LOTUS_BLOB_DIR at /var/lib/lotuscheck/blob; back that directory up
# with the database.
StateDirectory=lotuscheck
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
